import bpy
import re
import math
from mathutils import Matrix, Vector, Quaternion, Euler
from bpy_extras import anim_utils

# Safe Rig Merger - Blender 5.1 - 5.2.x (5.2 LTS)
# ---------------------------------------------------------------------------
# HOW TO USE
#   1. Save a backup of your file first.
#   2. Object Mode. Select >= 2 armatures and the meshes that belong to them.
#   3. Make the armature you want to KEEP the active object (click it last).
#   4. Run. Read the "[Safe Rig Merger]" lines in the System Console.
#
# FIXES IN THIS VERSION
#  A) "Duplicate animation channel ... Non-bone channels from several rigs
#     cannot be merged" no longer stops the merge:
#       - The kept rig's object-level channels win.
#       - The other rigs' object transform keys (location / rotation / scale,
#         which FBX imports always add) are folded into their root bones,
#         or dropped when they are constant.
#       - Their custom-property channels are copied unless the kept rig already
#         has the same one (then they are skipped with a log line).
#       - Stale channels (keys for bones that do not exist in that rig) are
#         skipped. They were a second source of the duplicate error and could
#         also hijack bones of another rig.
#  B) The second rig's animation no longer changes after the merge:
#       - Scale difference between rigs (for example a Mixamo/FBX rig at 0.01
#         merged into a rig at 1.0): Join rescales the bones, but Blender does
#         not rescale location keys, so the hips flew away. Bone location keys
#         (and the current pose) are now rescaled by the exact factor.
#       - Object-level motion of the second rig (root motion on the object),
#         or object motion of the kept rig that the second rig never had, is
#         baked into the second rig's root bones, so the world-space result
#         matches the original frame by frame.
#       - The second rig's NLA tracks are removed before the merge (their
#         actions are kept with a fake user). Join used to append them to the
#         kept rig, where they kept playing on top of the merged action.
#         If the second rig has no active action but exactly one NLA strip,
#         that strip is merged (with its time offset).
#       - Meshes parented directly to a bone (props, eyes, weapons) get a
#         100% vertex group for that bone, placed at rest pose, so they keep
#         following it instead of freezing.
#       - Vertex groups that were not deforming before (masks, groups named
#         like a bone of the OTHER rig) are renamed "<name>_unbound" so they do
#         not suddenly start following a bone. Modifier and shape-key
#         references to renamed groups are updated.
#  C) Anything that cannot be merged exactly (non-uniform/mirrored scale
#     between rigs, NLA tweak mode, several NLA strips, action without a slot)
#     stops BEFORE the scene is touched, with a message that says what to do.
#
# Kept from the previous version: original bone names are kept (only real
# clashes are renamed), linked-duplicate data is made single-user, the
# original actions are parked with a fake user, the combined action is built
# before any destructive step, every vertex group is checked afterwards.

MIN_VERSION = (5, 1, 0)
PREFIX = "_"
ACTION_NAME = "MERGED_Combined_Action"
MAX_NAME_BYTES = 63          # Blender name limit (64 incl. terminator)
MAX_BAKE_FRAMES = 20000
MATRIX_EPS = 1e-4

OBJ_TRANSFORM_PROPS = {
    "location", "rotation_euler", "rotation_quaternion", "rotation_axis_angle",
    "scale", "delta_location", "delta_rotation_euler",
    "delta_rotation_quaternion", "delta_scale",
}
BONE_TRANSFORM_PROPS = {
    "location", "rotation_quaternion", "rotation_euler",
    "rotation_axis_angle", "scale",
}
BONE_PATH_RE = re.compile(r'^pose\.bones\["((?:[^"\\]|\\.)*)"\](.*)$', re.S)
IDPROP_PATH_RE = re.compile(r'^\["((?:[^"\\]|\\.)*)"\]$', re.S)


# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

def log(msg):
    print("[Safe Rig Merger] " + str(msg))


def escape(name):
    return bpy.utils.escape_identifier(name)


def unescape(text):
    return re.sub(r'\\(.)', r'\1', text)


def unique_name(collection, base):
    if base not in collection:
        return base
    i = 1
    while f"{base}.{i:03d}" in collection:
        i += 1
    return f"{base}.{i:03d}"


def deselect_all():
    for obj in bpy.context.view_layer.objects:
        if obj.select_get():
            obj.select_set(False)


def matrices_close(a, b, eps=MATRIX_EPS):
    size = len(a)
    for i in range(size):
        for j in range(len(a[i])):
            if abs(a[i][j] - b[i][j]) > eps:
                return False
    return True


def parse_bone_path(path):
    """Return (escaped_bone_name, rest_of_path) or None."""
    m = BONE_PATH_RE.match(path)
    return (m.group(1), m.group(2)) if m else None


def remap_bone_path(path, mapping):
    """Single-pass replacement prevents cascading bone-name substitutions."""
    replacements = {}
    for old, new in mapping.items():
        if old != new:
            replacements[f'pose.bones["{escape(old)}"]'] = \
                f'pose.bones["{escape(new)}"]'
    if not replacements:
        return path
    pattern = re.compile("|".join(
        re.escape(t) for t in sorted(replacements, key=len, reverse=True)))
    return pattern.sub(lambda m: replacements[m.group(0)], path)


def compose_basis(rotation_mode, get):
    """Build a local matrix from loc/rot/scale values. get(prop, n) -> list."""
    loc = Vector(get("location", 3))
    scl = Vector(get("scale", 3))
    if rotation_mode == 'QUATERNION':
        q = Quaternion(get("rotation_quaternion", 4))
        rot = (q.normalized() if q.magnitude > 1e-12 else Quaternion()).to_matrix()
    elif rotation_mode == 'AXIS_ANGLE':
        a = get("rotation_axis_angle", 4)
        axis = Vector(a[1:])
        rot = (Matrix.Rotation(a[0], 3, axis.normalized())
               if axis.length > 1e-12 else Matrix.Identity(3))
    else:
        rot = Euler(get("rotation_euler", 3), rotation_mode).to_matrix()
    return Matrix.LocRotScale(loc, rot, scl)


def make_getter(rna, curves, frame):
    """curves: {(prop, index): fcurve}. Unanimated channels use current values."""
    def get(prop, n):
        values = list(getattr(rna, prop))
        for i in range(n):
            fc = curves.get((prop, i))
            if fc is not None:
                values[i] = fc.evaluate(frame)
        return values
    return get


def object_world_at(obj, curves, frame, offset):
    """World matrix of obj at frame, driven by its object-transform curves.
    Parent/constraint effects are taken from the current state (assumed static)."""
    if not curves:
        return obj.matrix_world.copy()
    now = compose_basis(obj.rotation_mode, make_getter(obj, {}, 0))
    at = compose_basis(obj.rotation_mode, make_getter(obj, curves, frame - offset))
    return obj.matrix_world @ now.inverted_safe() @ at


def keys_range(curves, offset):
    xs = [kp.co.x + offset for fc in curves for kp in fc.keyframe_points]
    return (min(xs), max(xs)) if xs else None


def merge_ranges(*ranges):
    ranges = [r for r in ranges if r]
    if not ranges:
        return None
    return (min(r[0] for r in ranges), max(r[1] for r in ranges))


def frame_list(rng):
    start, end = int(math.floor(rng[0])), int(math.ceil(rng[1]))
    if end - start + 1 > MAX_BAKE_FRAMES:
        raise RuntimeError(
            f"Bake range {start}-{end} is longer than {MAX_BAKE_FRAMES} frames. "
            "Check for stray keyframes far away on the timeline.")
    return list(range(start, end + 1))


# ---------------------------------------------------------------------------
# Bone names
# ---------------------------------------------------------------------------

def build_maps(order):
    """Keep original bone names. Only a bone whose name is already taken by
    the survivor or an earlier armature gets renamed (survivor goes first)."""
    used, maps = set(), {}
    for arm in order:
        own = {b.name for b in arm.data.bones}
        generated, mapping = set(), {}
        for bone in arm.data.bones:
            name = bone.name
            if name in used:
                new = arm.name + PREFIX + name
                n = 1
                while new in used or new in own or new in generated:
                    new = f"{arm.name}{PREFIX}{name}_{n}"
                    n += 1
                generated.add(new)
                mapping[name] = new
            else:
                mapping[name] = name
        used.update(mapping.values())
        maps[arm] = mapping
    return maps


def check_names(order, maps):
    seen = {}
    for arm in order:
        for old, new in maps[arm].items():
            if len(new.encode("utf-8")) > MAX_NAME_BYTES:
                raise RuntimeError(
                    f'{arm.name}: new bone name "{new}" is longer than '
                    f"{MAX_NAME_BYTES} bytes. Shorten the armature object name "
                    "or the bone name first.")
            if new in seen:
                raise RuntimeError(
                    f'Name collision: "{new}" ({seen[new]} and {arm.name}). '
                    "Rename one bone first.")
            seen[new] = arm.name
    renamed = [(a.name, o, n) for a in order
               for o, n in maps[a].items() if o != n]
    if renamed:
        log(f"{len(renamed)} bone(s) clash between rigs and were renamed "
            "(their keys are remapped automatically; animation you import "
            "LATER for these bones must target the new names):")
        for arm_name, old, new in renamed[:30]:
            log(f'  {arm_name}: "{old}" -> "{new}"')
        if len(renamed) > 30:
            log(f"  ... and {len(renamed) - 30} more")
    else:
        log("No bone-name clashes: all original bone names are kept.")


# ---------------------------------------------------------------------------
# Animation sources
# ---------------------------------------------------------------------------

def resolve_slot(holder, action):
    slot = getattr(holder, "action_slot", None)
    if slot is not None:
        return slot
    suitable = list(getattr(holder, "action_suitable_slots", None) or [])
    if len(suitable) == 1:
        return suitable[0]
    obj_slots = [s for s in action.slots
                 if s.target_id_type in {'OBJECT', 'UNSPECIFIED'}]
    return obj_slots[0] if len(obj_slots) == 1 else None


def active_nla_strips(ad):
    return [s for t in ad.nla_tracks if not t.mute for s in t.strips
            if not s.mute and s.type == 'CLIP' and s.action is not None]


def collect_sources(order, survivor):
    """Read every rig's animation into plain Python data. Nothing is changed."""
    sources = {}
    for arm in order:
        ad = arm.animation_data
        if ad and ad.use_tweak_mode:
            raise RuntimeError(
                f"{arm.name} is in NLA tweak mode. Exit tweak mode (Tab in the "
                "NLA editor) and run again.")
        action = slot = None
        offset, origin = 0.0, ""
        if ad and ad.action:
            action, origin = ad.action, f'active action "{ad.action.name}"'
            slot = resolve_slot(ad, action)
            if arm != survivor and ad.use_nla and active_nla_strips(ad):
                raise RuntimeError(
                    f"{arm.name} plays NLA strips underneath its active action, "
                    "so what you see is a blend that cannot be merged exactly. "
                    "Bake it first (Pose Mode > Pose > Animation > Bake Action, "
                    "or mute the NLA tracks you don't want) and run again.")
        elif ad and arm != survivor and len(ad.nla_tracks):
            strips = active_nla_strips(ad)
            if len(strips) > 1:
                raise RuntimeError(
                    f"{arm.name} has no active action but {len(strips)} NLA "
                    "strips. Make the action you want active in the Action "
                    "Editor (or bake the NLA with Pose > Animation > Bake "
                    "Action) and run again.")
            if strips:
                st = strips[0]
                if (abs(st.scale - 1.0) > 1e-6 or abs(st.repeat - 1.0) > 1e-6
                        or st.use_reverse or st.use_animated_influence
                        or st.blend_in > 0 or st.blend_out > 0
                        or st.blend_type != 'REPLACE'):
                    raise RuntimeError(
                        f'{arm.name}: NLA strip "{st.name}" is scaled, repeated, '
                        "reversed or blended. Bake it (Pose > Animation > Bake Action) "
                        "and run again.")
                action = st.action
                slot = resolve_slot(st, action)
                offset = st.frame_start - st.action_frame_start
                origin = f'NLA strip "{st.name}" (offset {offset:+g} frames)'
        if action is None:
            log(f"{arm.name}: no animation; its bones keep their current pose.")
            sources[arm] = None
            continue
        if slot is None:
            raise RuntimeError(
                f'{arm.name}: action "{action.name}" has no slot assigned for '
                "this object. Choose the slot in the Action Editor and run again.")
        bag = anim_utils.action_get_channelbag_for_slot(action, slot)
        src = {"arm": arm, "action": action, "offset": offset,
               "bone_curves": [], "obj_curves": {}, "other_curves": [],
               "use_range": action.use_frame_range,
               "start": action.frame_start + offset,
               "end": action.frame_end + offset}
        sources[arm] = src
        if bag is None:
            log(f"{arm.name}: {origin} has no channels for its slot.")
            continue
        log(f"{arm.name}: using {origin}.")
        bones = {escape(b.name): b.name for b in arm.data.bones}
        stale = set()
        for fc in bag.fcurves:
            parsed = parse_bone_path(fc.data_path)
            if parsed:
                name = bones.get(parsed[0])
                if name is None:
                    stale.add(unescape(parsed[0]))
                    continue
                src["bone_curves"].append((fc, name, parsed[1]))
            elif fc.data_path.startswith("pose.bones["):
                stale.add(fc.data_path)
            elif fc.data_path in OBJ_TRANSFORM_PROPS:
                src["obj_curves"][(fc.data_path, fc.array_index)] = fc
            else:
                src["other_curves"].append(fc)
        if stale:
            log(f"{arm.name}: skipped keys for {len(stale)} bone(s) that do not "
                "exist in this rig: " + ", ".join(sorted(stale)[:15])
                + (" ..." if len(stale) > 15 else ""))
    return sources


# ---------------------------------------------------------------------------
# Transform planning (scale factor and root-bone bake per secondary rig)
# ---------------------------------------------------------------------------

def similarity_scale(R, arm, survivor):
    m3 = R.to_3x3()
    if m3.determinant() <= 1e-12:
        raise RuntimeError(
            f"{arm.name} is mirrored (negative scale) or has zero scale relative "
            f"to {survivor.name}. Fix the object scale first.")
    cols = [c.length for c in m3.col]
    k = sum(cols) / 3.0
    if max(abs(c - k) for c in cols) > 1e-4 * k:
        raise RuntimeError(
            f"{arm.name} has non-uniform scale relative to {survivor.name} "
            f"({cols[0]:.4g}, {cols[1]:.4g}, {cols[2]:.4g}). Join would skew "
            "its bones and the animation cannot be kept. Give both armature "
            "objects uniform scale first.")
    n = m3.normalized()
    if not matrices_close(n @ n.transposed(), Matrix.Identity(3), 1e-4):
        raise RuntimeError(
            f"{arm.name} is sheared relative to {survivor.name} (a parent with "
            "non-uniform scale?). Clear the parent / apply scale first.")
    return k


def has_deltas(obj):
    return (Vector(obj.delta_location).length > 1e-9
            or Vector(obj.delta_rotation_euler).length > 1e-9
            or abs(Vector(obj.delta_scale).length - math.sqrt(3)) > 1e-9
            or not matrices_close(
                obj.delta_rotation_quaternion.to_matrix(), Matrix.Identity(3)))


def plan_rigs(order, survivor, sources):
    survivor_now = survivor.matrix_world.copy()
    s_src = sources.get(survivor)
    s_curves = s_src["obj_curves"] if s_src else {}
    s_off = s_src["offset"] if s_src else 0.0
    plans = {}
    for arm in order[1:]:
        R = survivor_now.inverted_safe() @ arm.matrix_world
        k = similarity_scale(R, arm, survivor)
        src = sources.get(arm)
        a_curves = src["obj_curves"] if src else {}
        a_off = src["offset"] if src else 0.0
        plan = {"R": R, "k": k, "bake": False, "baked": {}, "frames": [],
                "predicted": {}}
        plans[arm] = plan
        rot3 = R.to_3x3().normalized()
        for b in arm.data.bones:
            rest = b.matrix_local
            plan["predicted"][b.name] = (
                Matrix.Translation(R @ rest.translation)
                @ (rot3 @ rest.to_3x3()).to_4x4())
        if abs(k - 1.0) > 1e-6:
            log(f"{arm.name}: scale relative to {survivor.name} is {k:.6g}; "
                "its bone location keys and pose are rescaled to match.")

        rng = merge_ranges(keys_range(a_curves.values(), a_off),
                           keys_range(s_curves.values(), s_off))
        if rng:
            for f in frame_list(rng):
                rel = (object_world_at(survivor, s_curves, f, s_off).inverted_safe()
                       @ object_world_at(arm, a_curves, f, a_off))
                if not matrices_close(rel, R):
                    plan["bake"] = True
                    break
        if a_curves and not plan["bake"]:
            log(f"{arm.name}: object transform keys are constant; dropped "
                "(the object transform itself is kept by Join).")
        if not plan["bake"]:
            continue

        for obj in (arm, survivor):
            if has_deltas(obj):
                log(f"WARNING: {obj.name} has delta transforms; the root-bone "
                    "bake treats them as static. Verify the result.")
            if len(obj.constraints):
                log(f"WARNING: {obj.name} has object constraints; the root-bone "
                    "bake treats their effect as static. Verify the result.")

        bone_ranges = keys_range([fc for fc, _, _ in src["bone_curves"]],
                                 a_off) if src else None
        frames = frame_list(merge_ranges(rng, bone_ranges))
        plan["frames"] = frames
        inv_k = Matrix.Scale(1.0 / k, 4)
        s_mats = {f: object_world_at(survivor, s_curves, f, s_off).inverted_safe()
                  for f in frames}
        a_mats = {f: object_world_at(arm, a_curves, f, a_off) for f in frames}
        roots = [b for b in arm.data.bones if b.parent is None]
        for bone in roots:
            pb = arm.pose.bones[bone.name]
            rest = bone.matrix_local.copy()
            rest_new = plan["predicted"][bone.name]
            rest_new_inv = rest_new.inverted_safe()
            curves = {}
            if src:
                for fc, name, tail in src["bone_curves"]:
                    if name == bone.name and tail[1:] in BONE_TRANSFORM_PROPS:
                        curves[(tail[1:], fc.array_index)] = fc
                        if len(fc.modifiers):
                            log(f"WARNING: {arm.name}/{bone.name} "
                                f"{tail[1:]} has F-Curve modifiers (Cycles, "
                                "Noise...); the bake keeps only the baked range.")
            samples = []
            for f in frames:
                basis = compose_basis(pb.rotation_mode,
                                      make_getter(pb, curves, f - a_off))
                samples.append(rest_new_inv @ s_mats[f] @ a_mats[f]
                               @ rest @ basis @ inv_k)
            plan["baked"][bone.name] = {"mode": pb.rotation_mode,
                                        "matrices": samples,
                                        "rest_new": rest_new}
        log(f"{arm.name}: object-level motion differs from {survivor.name}; "
            f"baked into {len(roots)} root bone(s) over frames "
            f"{frames[0]}-{frames[-1]}.")
        if any(not b.use_inherit_rotation or b.inherit_scale != 'FULL'
               for b in arm.data.bones if b.parent is not None):
            log(f"WARNING: {arm.name} has bones that do not inherit rotation/"
                "scale; with baked object motion they may differ. Verify.")
    return plans


# ---------------------------------------------------------------------------
# Combined action
# ---------------------------------------------------------------------------

def ensure_group(bag, name):
    if not name:
        return None
    grp = bag.groups.get(name) if hasattr(bag.groups, "get") else None
    if grp is None:
        for g in bag.groups:
            if g.name == name:
                return g
        grp = bag.groups.new(name)
    return grp


def copy_fcurve(src, bag, path, value_scale=1.0, time_offset=0.0, group=None):
    idx = src.array_index
    if bag.fcurves.find(path, index=idx) is not None:
        return False
    dst = bag.fcurves.new_from_fcurve(src, data_path=path)
    grp_name = group or (src.group.name if src.group else "")
    if grp_name:
        try:
            dst.group = ensure_group(bag, grp_name)
        except Exception:
            pass
    if value_scale != 1.0 or time_offset != 0.0:
        for kp in dst.keyframe_points:
            kp.co = (kp.co.x + time_offset, kp.co.y * value_scale)
            kp.handle_left = (kp.handle_left.x + time_offset,
                              kp.handle_left.y * value_scale)
            kp.handle_right = (kp.handle_right.x + time_offset,
                               kp.handle_right.y * value_scale)
        if value_scale != 1.0 and len(dst.modifiers):
            log(f"WARNING: {path}[{idx}] has F-Curve modifiers; their "
                "amplitude/offset values were not rescaled.")
        dst.update()
    return True


def write_samples(bag, path, idx, frames, values, group):
    if bag.fcurves.find(path, index=idx) is not None:
        raise RuntimeError(f"Internal: baked channel {path}[{idx}] already exists.")
    fc = bag.fcurves.new(path, index=idx, group_name=group)
    fc.keyframe_points.add(len(frames))
    for kp, f, v in zip(fc.keyframe_points, frames, values):
        kp.co = (f, v)
        kp.interpolation = 'LINEAR'
    fc.update()


def write_baked_bone(bag, bone_name, data, frames):
    base = f'pose.bones["{escape(bone_name)}"]'
    mode = data["mode"]
    locs, rots, scls = [], [], []
    prev_q, prev_e = None, None
    for m in data["matrices"]:
        loc, q, scl = m.decompose()
        if prev_q is not None and prev_q.dot(q) < 0.0:
            q.negate()
        prev_q = q.copy()
        locs.append(loc)
        scls.append(scl)
        if mode == 'QUATERNION':
            rots.append(list(q))
        elif mode == 'AXIS_ANGLE':
            axis, angle = q.to_axis_angle()
            rots.append([angle, axis.x, axis.y, axis.z])
        else:
            e = q.to_euler(mode, prev_e) if prev_e else q.to_euler(mode)
            prev_e = e.copy()
            rots.append(list(e))
    rot_prop = {"QUATERNION": "rotation_quaternion",
                "AXIS_ANGLE": "rotation_axis_angle"}.get(mode, "rotation_euler")
    for i in range(3):
        write_samples(bag, base + ".location", i, frames,
                      [v[i] for v in locs], bone_name)
        write_samples(bag, base + ".scale", i, frames,
                      [v[i] for v in scls], bone_name)
    for i in range(len(rots[0])):
        write_samples(bag, base + "." + rot_prop, i, frames,
                      [r[i] for r in rots], bone_name)


def build_action(order, survivor, sources, maps, plans):
    """Create and fill the combined action before anything destructive."""
    if not any(sources.get(a) for a in order) and not any(
            p["bake"] for p in plans.values()):
        return None, None, []
    action = bpy.data.actions.new(unique_name(bpy.data.actions, ACTION_NAME))
    action.use_fake_user = True
    idprops = []
    try:
        slot = action.slots.new(id_type='OBJECT', name=survivor.name)
        bag = anim_utils.action_ensure_channelbag_for_slot(action, slot)
        starts, ends = [], []
        for arm in order:
            src = sources.get(arm)
            plan = plans.get(arm)
            mapping = maps[arm]
            k = plan["k"] if plan else 1.0
            baked = plan["baked"] if plan else {}
            if src:
                off = src["offset"]
                if src["use_range"]:
                    starts.append(src["start"])
                    ends.append(src["end"])
                for fc, name, tail in src["bone_curves"]:
                    if name in baked and tail[1:] in BONE_TRANSFORM_PROPS:
                        continue
                    path = remap_bone_path(fc.data_path, mapping)
                    scale = k if tail == ".location" else 1.0
                    if not copy_fcurve(fc, bag, path, scale, off, mapping[name]):
                        log(f"{arm.name}: duplicate channel {path}"
                            f"[{fc.array_index}] skipped.")
                if arm == survivor:
                    for fc in src["obj_curves"].values():
                        copy_fcurve(fc, bag, fc.data_path, 1.0, off)
                for fc in src["other_curves"]:
                    if copy_fcurve(fc, bag, fc.data_path, 1.0, off):
                        m = IDPROP_PATH_RE.match(fc.data_path)
                        if m and arm != survivor:
                            key = unescape(m.group(1))
                            if key in arm.keys() and key not in survivor.keys():
                                ui = {}
                                try:
                                    ui = arm.id_properties_ui(key).as_dict()
                                except Exception:
                                    pass
                                idprops.append((key, arm[key], ui))
                    else:
                        log(f"{arm.name}: channel {fc.data_path}"
                            f"[{fc.array_index}] already comes from "
                            f"{survivor.name}; kept {survivor.name}'s version.")
            for bone_name, data in baked.items():
                write_baked_bone(bag, mapping[bone_name], data, plan["frames"])
        if starts:
            action.use_frame_range = True
            action.frame_start = min(starts)
            action.frame_end = max(ends)
        return action, slot, idprops
    except Exception:
        try:
            action.use_fake_user = False
            bpy.data.actions.remove(action)
        except Exception:
            pass
        raise


# ---------------------------------------------------------------------------
# Meshes
# ---------------------------------------------------------------------------

def mesh_link(mesh, arms):
    """Return (rig, kind). kind: MODIFIER, ARMATURE_PARENT, BONE, OBJECT."""
    mods = [m for m in mesh.modifiers
            if m.type == 'ARMATURE' and m.object in arms]
    found = []
    for m in mods:
        if m.object not in found:
            found.append(m.object)
    if mesh.parent in arms and mesh.parent not in found:
        found.append(mesh.parent)
    if len(found) > 1:
        raise RuntimeError(
            f"{mesh.name}: linked to several selected armatures; fix manually.")
    if not found:
        return None, None
    rig = found[0]
    if any(m.use_vertex_groups for m in mods):
        return rig, 'MODIFIER'
    if mods:
        return rig, 'ENVELOPE'
    if mesh.parent == rig and mesh.parent_type == 'ARMATURE':
        return rig, 'ARMATURE_PARENT'
    if mesh.parent == rig and mesh.parent_type == 'BONE' and mesh.parent_bone:
        return rig, 'BONE'
    return rig, 'OBJECT'


def armature_mod_settings(mesh, rig):
    for mod in mesh.modifiers:
        if mod.type == 'ARMATURE' and mod.object == rig:
            return {"use_deform_preserve_volume": mod.use_deform_preserve_volume,
                    "use_multi_modifier": mod.use_multi_modifier}
    return {}


def group_references(obj):
    """(rna, attribute) pairs on obj that refer to a vertex group by name."""
    refs = []
    for mod in obj.modifiers:
        for prop in mod.bl_rna.properties:
            if (prop.type == 'STRING' and "vertex_group" in prop.identifier
                    and not prop.is_readonly):
                refs.append((mod, prop.identifier))
    keys = obj.data.shape_keys if obj.type == 'MESH' else None
    if keys:
        for kb in keys.key_blocks:
            refs.append((kb, "vertex_group"))
    return refs


def rename_groups(obj, renames):
    """renames: {old: new}. Two passes avoid swaps; references follow."""
    jobs = [(g, renames[g.name]) for g in obj.vertex_groups
            if g.name in renames and renames[g.name] != g.name]
    if not jobs:
        return
    refs = group_references(obj)
    ref_values = [(rna, attr, getattr(rna, attr)) for rna, attr in refs]
    for i, (group, _) in enumerate(jobs):
        group.name = f"__MERGE_TEMP_{i:05d}__"
    for group, new in jobs:
        group.name = new
    for rna, attr, old in ref_values:
        if old in renames:
            try:
                setattr(rna, attr, renames[old])
            except Exception:
                pass


def move_modifier_first(obj, modifier_name):
    try:
        obj.modifiers.move(len(obj.modifiers) - 1, 0)
        return
    except Exception:
        pass
    try:
        with bpy.context.temp_override(object=obj, active_object=obj):
            bpy.ops.object.modifier_move_to_index(modifier=modifier_name, index=0)
    except Exception as exc:
        log(f"WARNING: could not move the Armature modifier to the top of "
            f"{obj.name}'s stack ({exc}). Move it manually.")


def plan_meshes(meshes, arms, order, maps, active_mesh):
    """Work out every vertex-group change. Nothing is changed here."""
    links = {m: mesh_link(m, arms) for m in meshes}
    enable_deform = {}          # arm -> set(original bone names)
    for mesh, (rig, kind) in links.items():
        if rig is None:
            raise RuntimeError(
                f"{mesh.name}: not linked to any selected armature. Deselect it "
                "or give it an Armature modifier for the right rig.")
        if kind == 'BONE':
            if mesh.parent_bone not in rig.data.bones:
                raise RuntimeError(
                    f'{mesh.name}: parent bone "{mesh.parent_bone}" not found.')
            if not rig.data.bones[mesh.parent_bone].use_deform:
                enable_deform.setdefault(rig, set()).add(mesh.parent_bone)
        if kind == 'ENVELOPE':
            log(f"WARNING: {mesh.name} deforms by envelopes only; the merged "
                "mesh uses vertex groups only. Verify it.")
        if kind == 'OBJECT':
            log(f"WARNING: {mesh.name} is only object-parented to {rig.name} "
                "(no deformation); after the merge it moves with the merged rig "
                "object only.")

    def deform_names(arm, final):
        names = set()
        for b in arm.data.bones:
            if b.use_deform or b.name in enable_deform.get(arm, ()):
                names.add(maps[arm][b.name] if final else b.name)
        return names

    deform_after = set()
    for arm in order:
        deform_after |= deform_names(arm, True)

    plans = {}
    for mesh, (rig, kind) in links.items():
        mapping = maps[rig]
        names = {g.name for g in mesh.vertex_groups}
        bound_before = deform_names(rig, False) if kind in {
            'MODIFIER', 'ARMATURE_PARENT'} else set()
        renames = {}
        for old, new in mapping.items():
            if old != new and old in names:
                if new in names:
                    raise RuntimeError(
                        f'{mesh.name}: vertex-group collision "{new}". '
                        "Resolve it first.")
                renames[old] = new
        rigid_group = mapping[mesh.parent_bone] if kind == 'BONE' else None
        taken = set(names) | set(renames.values())
        unbound = {}
        for name in sorted(names):
            final = renames.get(name, name)
            if final in deform_after and name not in bound_before:
                new = final + "_unbound"
                n = 1
                while new in taken or new in deform_after:
                    new = f"{final}_unbound_{n}"
                    n += 1
                taken.add(new)
                unbound[final] = new
        if rigid_group and rigid_group in taken - set(unbound.values()) \
                and rigid_group not in unbound:
            raise RuntimeError(
                f'{mesh.name}: already has a vertex group "{rigid_group}".')
        if unbound:
            log(f"{mesh.name}: {len(unbound)} vertex group(s) did not deform "
                "before but match a bone of the merged rig; renamed so they "
                "stay non-deforming: " + ", ".join(
                    f'"{a}"->"{b}"' for a, b in list(unbound.items())[:10]))
        if mesh != active_mesh:
            unsupported = [m.name for m in mesh.modifiers if m.type != 'ARMATURE']
            if unsupported:
                raise RuntimeError(
                    f"{mesh.name}: modifiers that Join would discard: "
                    f"{', '.join(unsupported)}. Apply them first, or make "
                    "this mesh the active object.")
        keys = mesh.data.shape_keys
        if keys and len(meshes) > 1:
            log(f"WARNING: {mesh.name} has shape keys; Join only merges matching "
                "key layouts and the active mesh's Basis wins.")
        if keys and keys.animation_data:
            log(f"WARNING: {mesh.name} has shape-key animation/drivers; these "
                "are not merged by Join.")
        world = mesh.matrix_world.copy()
        if kind == 'BONE':
            # Place the mesh where it sits in REST pose; the 100% vertex group
            # then moves it with the bone through the Armature modifier.
            arm_w = rig.matrix_world
            bone = rig.data.bones[mesh.parent_bone]
            pb = rig.pose.bones[mesh.parent_bone]
            world = (arm_w @ bone.matrix_local @ pb.matrix.inverted_safe()
                     @ arm_w.inverted_safe() @ world)
            log(f'{mesh.name}: was parented to bone "{mesh.parent_bone}"; it '
                f'gets a 100% vertex group "{rigid_group}".')
        plans[mesh] = {"rig": rig, "kind": kind, "renames": renames,
                       "unbound": unbound, "rigid_group": rigid_group,
                       "world": world}
    for arm, bones in enable_deform.items():
        log(f"{arm.name}: enabling Deform on bone(s) used as mesh parents: "
            + ", ".join(sorted(bones)))
    return plans, enable_deform


def pick_active_mesh(meshes, survivor):
    active = bpy.context.view_layer.objects.active
    if active in meshes:
        return active
    with_mods = [m for m in meshes
                 if any(mod.type != 'ARMATURE' for mod in m.modifiers)]
    if len(with_mods) == 1:
        return with_mods[0]
    for m in meshes:
        if m.parent == survivor or any(
                mod.type == 'ARMATURE' and mod.object == survivor
                for mod in m.modifiers):
            return m
    return meshes[0] if meshes else None


# ---------------------------------------------------------------------------
# Warnings, safety
# ---------------------------------------------------------------------------

def warn_rig_state(order, survivor, plans, selected):
    arms = set(order)
    for arm in order:
        ad = arm.animation_data
        if ad and arm != survivor and len(ad.nla_tracks):
            log(f"{arm.name}: its {len(ad.nla_tracks)} NLA track(s) are removed "
                "before the merge so they cannot play on top of the merged "
                "action. Their actions are kept (fake user).")
        if ad:
            for drv in ad.drivers:
                log(f'REVIEW: {arm.name} driver "{drv.data_path}" (verify).')
        plan = plans.get(arm)
        if plan and abs(plan["k"] - 1.0) > 1e-6:
            unit_cons = {'LIMIT_LOCATION', 'LIMIT_DISTANCE', 'STRETCH_TO',
                         'FLOOR', 'TRANSFORM', 'SHRINKWRAP'}
            hits = [f"{pb.name}/{c.name}" for pb in arm.pose.bones
                    for c in pb.constraints if c.type in unit_cons]
            if hits:
                log(f"REVIEW: {arm.name} constraints with distance values are "
                    f"not rescaled by {plan['k']:.6g}: " + ", ".join(hits[:10]))
        for pb in arm.pose.bones:
            for c in pb.constraints:
                target = getattr(c, "target", None)
                sub = getattr(c, "subtarget", "")
                if sub and target is not None and target in arms \
                        and target != arm:
                    log(f'REVIEW: {arm.name}/{pb.name} constraint "{c.name}" '
                        f'targets {target.name}/"{sub}" (cross-rig).')
    others = set(order[1:])
    for obj in bpy.data.objects:
        if obj in selected:
            continue
        uses = obj.parent in others or any(
            m.type == 'ARMATURE' and m.object in others for m in obj.modifiers)
        if uses:
            log(f"REVIEW: unselected object {obj.name} uses a rig that is being "
                "merged; Blender re-targets it, but verify it.")


def check_objects(objs):
    for obj in objs:
        if obj.library or obj.data.library:
            raise RuntimeError(f"{obj.name} is linked from a library; make it "
                               "local first.")
        if not obj.visible_get():
            raise RuntimeError(f"{obj.name} is hidden; Join needs it visible.")


def make_single_user(arms, meshes):
    for arm in arms:
        if arm.data.users > 1:
            log(f"{arm.name}: armature data is shared; making it single-user.")
            arm.data = arm.data.copy()
    for mesh in meshes:
        if mesh.data.users > 1:
            log(f"{mesh.name}: mesh data is shared; making it single-user.")
            mesh.data = mesh.data.copy()


def park_animation(order, survivor):
    """Unassign original actions (kept with fake user) so bone renames cannot
    rewrite them, and remove secondary NLA so Join cannot append it."""
    for arm in order:
        ad = arm.animation_data
        if not ad:
            continue
        if ad.action:
            ad.action.use_fake_user = True
            ad.action = None
        if arm != survivor:
            for track in list(ad.nla_tracks):
                for strip in track.strips:
                    if strip.action:
                        strip.action.use_fake_user = True
                ad.nla_tracks.remove(track)


def verify_groups(mesh, rig):
    deform = {b.name for b in rig.data.bones if b.use_deform}
    orphans = [g.name for g in mesh.vertex_groups if g.name not in deform]
    if orphans:
        log(f"Note: {len(orphans)} vertex group(s) on {mesh.name} do not match a "
            "deform bone (fine for masks): " + ", ".join(orphans[:20])
            + (" ..." if len(orphans) > 20 else ""))
    else:
        log(f"Weights check OK: every vertex group on {mesh.name} matches a "
            "deform bone.")


def restore_rolls(survivor, rest_checks):
    """Blender's armature Join can lose bone roll when the rigs have different
    object rotations, which twists the bone axes and so the animation. Set
    every secondary bone's roll back to the exact pre-merge orientation."""
    if not rest_checks:
        return
    bpy.context.view_layer.objects.active = survivor
    bpy.ops.object.mode_set(mode='EDIT')
    fixed = 0
    try:
        ebones = survivor.data.edit_bones
        for name, predicted, _k in rest_checks:
            eb = ebones.get(name)
            if eb is None:
                continue
            z = predicted.to_3x3().col[2]
            if (eb.z_axis - z.normalized()).length > 1e-4:
                eb.align_roll(z)
                fixed += 1
    finally:
        bpy.ops.object.mode_set(mode='OBJECT')
    if fixed:
        log(f"Restored bone roll lost by Join on {fixed} bone(s).")
    bad = []
    for name, predicted, k in rest_checks:
        bone = survivor.data.bones.get(name)
        if bone and not matrices_close(bone.matrix_local, predicted,
                                       1e-3 * max(1.0, k)):
            bad.append(name)
    if bad:
        log("WARNING: rest pose differs from the original for: "
            + ", ".join(bad[:15]) + ". Verify these bones.")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def validate():
    if bpy.app.version < MIN_VERSION:
        raise RuntimeError("Requires Blender %d.%d.%d or newer." % MIN_VERSION)
    if bpy.context.mode != 'OBJECT':
        raise RuntimeError("Switch to Object Mode.")
    selected = list(bpy.context.selected_objects)
    arms = [o for o in selected if o.type == 'ARMATURE']
    meshes = [o for o in selected if o.type == 'MESH']
    if len(arms) < 2:
        raise RuntimeError("Select at least two armature objects.")
    ignored = [o.name for o in selected if o.type not in {'ARMATURE', 'MESH'}]
    if ignored:
        log("Ignoring selected non-mesh/non-armature objects: "
            + ", ".join(ignored))
    active = bpy.context.view_layer.objects.active
    survivor = active if active in arms else arms[0]
    if active not in arms:
        log(f"WARNING: active object is not an armature; keeping {survivor.name}.")
    check_objects(arms + meshes)
    order = [survivor] + [a for a in arms if a != survivor]
    return order, meshes, survivor, selected


def main():
    created_action = None
    try:
        order, meshes, survivor, selected = validate()
        arms = list(order)
        log(f"Survivor: {survivor.name}")

        # ---- Read-only preflight -----------------------------------------
        maps = build_maps(order)
        check_names(order, maps)
        active_mesh = pick_active_mesh(meshes, survivor)
        mesh_plans, enable_deform = plan_meshes(meshes, arms, order, maps,
                                                active_mesh)
        mod_settings = (armature_mod_settings(active_mesh,
                                              mesh_plans[active_mesh]["rig"])
                        if active_mesh else {})
        variants = {tuple(sorted(armature_mod_settings(m, p["rig"]).items()))
                    for m, p in mesh_plans.items()
                    if armature_mod_settings(m, p["rig"])}
        if len(variants) > 1:
            log("WARNING: meshes have different Armature modifier settings; the "
                f"merged mesh uses {active_mesh.name}'s.")
        sources = collect_sources(order, survivor)
        plans = plan_rigs(order, survivor, sources)
        created_action, combined_slot, idprops = build_action(
            order, survivor, sources, maps, plans)
        warn_rig_state(order, survivor, plans, set(selected))
        frame_now = bpy.context.scene.frame_current
        # Join deletes the secondary objects: keep post-join jobs as plain data.
        rescale_jobs = [(list(maps[a].values()), p["k"]) for a, p in plans.items()
                        if abs(p["k"] - 1.0) > 1e-6]
        rest_checks = [(maps[a][bn], m, p["k"])
                       for a, p in plans.items()
                       for bn, m in p["predicted"].items()]

        # ---- Destructive part --------------------------------------------
        try:
            bpy.ops.ed.undo_push(message="Safe Armature and Mesh Merge")
        except Exception:
            pass

        make_single_user(arms, meshes)
        park_animation(order, survivor)

        # Detach meshes first so bone renames cannot touch their groups.
        for mesh in meshes:
            mesh.parent = None
            mesh.matrix_world = mesh_plans[mesh]["world"]
            for mod in list(mesh.modifiers):
                if mod.type == 'ARMATURE' and mod.object in arms:
                    mesh.modifiers.remove(mod)

        for arm, bones in enable_deform.items():
            for name in bones:
                arm.data.bones[name].use_deform = True

        for arm in order:
            for bone in arm.data.bones:
                new_name = maps[arm][bone.name]
                if new_name != bone.name:
                    bone.name = new_name

        for mesh, plan in mesh_plans.items():
            rename_groups(mesh, plan["renames"])
            rename_groups(mesh, plan["unbound"])
            if plan["rigid_group"]:
                vg = mesh.vertex_groups.new(name=plan["rigid_group"])
                vg.add(range(len(mesh.data.vertices)), 1.0, 'REPLACE')

        joined_mesh = None
        if meshes:
            deselect_all()
            for mesh in meshes:
                mesh.select_set(True)
            bpy.context.view_layer.objects.active = active_mesh
            if len(meshes) > 1:
                bpy.ops.object.join()
            joined_mesh = active_mesh
            joined_mesh.name = unique_name(bpy.data.objects,
                                           survivor.name + "_JoinedMesh")

        deselect_all()
        for arm in arms:
            arm.select_set(True)
        bpy.context.view_layer.objects.active = survivor
        bpy.ops.object.join()

        restore_rolls(survivor, rest_checks)

        survivor.name = unique_name(bpy.data.objects,
                                    survivor.name + "_CombinedRig")
        survivor.data.name = unique_name(bpy.data.armatures,
                                         survivor.name + "_ArmatureData")

        # Static pose of rescaled rigs (animated channels are re-evaluated).
        for bone_names, k in rescale_jobs:
            for name in bone_names:
                pb = survivor.pose.bones.get(name)
                if pb:
                    pb.location = pb.location * k

        # Custom properties animated on secondary rigs must exist on survivor.
        for key, value, ui in idprops:
            survivor[key] = value
            if ui:
                try:
                    survivor.id_properties_ui(key).update(**ui)
                except Exception:
                    pass
        if created_action:
            ad = survivor.animation_data or survivor.animation_data_create()
            ad.action = created_action
            ad.action_slot = combined_slot

        if joined_mesh:
            world = joined_mesh.matrix_world.copy()
            joined_mesh.parent = survivor
            joined_mesh.parent_type = 'OBJECT'
            joined_mesh.parent_bone = ""
            joined_mesh.matrix_world = world
            mod = joined_mesh.modifiers.new("Combined Armature", 'ARMATURE')
            mod.object = survivor
            mod.use_vertex_groups = True
            mod.use_bone_envelopes = False
            for key, value in mod_settings.items():
                try:
                    setattr(mod, key, value)
                except Exception:
                    pass
            move_modifier_first(joined_mesh, mod.name)
            verify_groups(joined_mesh, survivor)

        bpy.context.scene.frame_set(frame_now)

        deselect_all()
        survivor.select_set(True)
        if joined_mesh:
            joined_mesh.select_set(True)
        bpy.context.view_layer.objects.active = survivor
        log("Merge completed. Scrub the timeline and check deformation, "
            "constraints and drivers before production use.")

    except Exception as exc:
        log("STOPPED: " + str(exc))
        if created_action and created_action.name in bpy.data.actions:
            try:
                created_action.use_fake_user = False
                if created_action.users == 0:
                    bpy.data.actions.remove(created_action)
            except Exception:
                pass
        log("If any scene changes occurred, use Ctrl+Z or reopen your backup.")
        raise


if __name__ == "__main__":
    main()
