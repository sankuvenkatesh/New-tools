bl_info = {
    "name": "Overlapper",
    "author": "Blender port by Claude - original Maya tool by Dmitrii Kolpakov (2018)",
    "version": (2, 0, 0),
    "blender": (3, 6, 0),
    "location": "View3D > Sidebar (N-panel) > Overlapper",
    "description": "Automatic overlapping / follow-through secondary animation for a chain of "
                   "selected objects or bones (Blender port of the Maya 'Overlapper' tool).",
    "category": "Animation",
