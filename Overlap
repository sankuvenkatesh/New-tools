import bpy
import math
from mathutils import Vector, Euler, Quaternion

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

HELPER_COLLECTION_NAME = "Overlapper_Helpers"
HELPER_PREFIX = "OVL_"
RESULT_COLLECTION_NAME = "OverlapperSet"


# ---------------------------------------------------------------------------
# Version-safe Action / F-Curve access (Blender 5.0 removed Action.fcurves)
# ---------------------------------------------------------------------------

def get_fcurve(id_obj, action, data_path, index):
    try:
        return action.fcurve_ensure_for_datablock(id_obj, data_path, index=index)
    except AttributeError:
        fc = action.fcurves.find(data_path, index=index)
        if fc is None:
            fc = action.fcurves.new(data_path, index=index)
        return fc


def ensure_action(id_obj):
    if id_obj.animation_data is None:
        id_obj.animation_data_create()
    if id_obj.animation_data.action is None:
        id_obj.animation_data.action = bpy.data.actions.new(name=f"{id_obj.name}Action")
    return id_obj.animation_data.action


# ---------------------------------------------------------------------------
# Small utilities
# ---------------------------------------------------------------------------

def get_frame_range(context):
    scene = context.scene
    if scene.use_preview_range:
        return scene.frame_preview_start, scene.frame_preview_end
    return scene.frame_start, scene.frame_end


def get_or_create_collection(name, parent=None):
    if name in bpy.data.collections:
        return bpy.data.collections[name]
    coll = bpy.data.collections.new(name)
    if parent is None:
        parent = bpy.context.scene.collection
    parent.children.link(coll)
    return coll


def remove_collection(name):
    coll = bpy.data.collections.get(name)
    if coll is None:
        return
    for obj in list(coll.objects):
        bpy.data.objects.remove(obj, do_unlink=True)
    bpy.data.collections.remove(coll)


def create_empty(name, collection, size=0.15):
    empty = bpy.data.objects.new(name, None)
    empty.empty_display_type = 'PLAIN_AXES'
    empty.empty_display_size = size
    collection.objects.link(empty)
    return empty


# ---------------------------------------------------------------------------
# ChainItem
# ---------------------------------------------------------------------------

class ChainItem:
    __slots__ = ("kind", "id_obj", "bone_name")

    def __init__(self, kind, id_obj, bone_name=None):
        self.kind = kind
        self.id_obj = id_obj
        self.bone_name = bone_name

    @property
    def name(self):
        if self.kind == 'BONE':
            return f"{self.id_obj.name}:{self.bone_name}"
        return self.id_obj.name

    @property
    def pose_bone(self):
        return self.id_obj.pose.bones[self.bone_name]

    @property
    def bone_data(self):
        return self.id_obj.data.bones[self.bone_name]

    def world_matrix(self):
        if self.kind == 'BONE':
            return self.id_obj.matrix_world @ self.pose_bone.matrix
        return self.id_obj.matrix_world.copy()

    def rotation_mode(self):
        if self.kind == 'BONE':
            return self.pose_bone.rotation_mode
        return self.id_obj.rotation_mode

    def data_path(self, prop):
        if self.kind == 'BONE':
            return f'pose.bones["{self.bone_name}"].{prop}'
        return prop

    def read_rotation_euler(self):
        mode = self.rotation_mode()
        target = self.pose_bone if self.kind == 'BONE' else self.id_obj
        if mode == 'QUATERNION':
            return target.rotation_quaternion.to_euler()
        if mode == 'AXIS_ANGLE':
            aa = target.rotation_axis_angle
            return Quaternion((aa[1], aa[2], aa[3]), aa[0]).to_euler()
        return target.rotation_euler.copy()

    def read_location(self):
        target = self.pose_bone if self.kind == 'BONE' else self.id_obj
        return target.location.copy()

    def hierarchy_depth(self):
        depth = 0
        if self.kind == 'BONE':
            b = self.bone_data.parent
            while b is not None:
                depth += 1
                b = b.parent
        else:
            obj = self.id_obj.parent
            while obj is not None:
                depth += 1
                obj = obj.parent
        return depth


def get_selected_chain(context):
    if context.mode == 'POSE' and context.selected_pose_bones:
        armature_obj = context.object
        return [ChainItem('BONE', armature_obj, b.name) for b in context.selected_pose_bones]
    return [ChainItem('OBJECT', obj) for obj in context.selected_objects]


def expand_hierarchy(chain):
    seen = set()
    result = []

    def walk_object(obj):
        if obj.name in seen:
            return
        seen.add(obj.name)
        result.append(ChainItem('OBJECT', obj))
        for child in sorted(obj.children, key=lambda c: c.name):
            walk_object(child)

    def walk_bone(armature_obj, bone):
        key = (armature_obj.name, bone.name)
        if key in seen:
            return
        seen.add(key)
        result.append(ChainItem('BONE', armature_obj, bone.name))
        for child in sorted(bone.children, key=lambda c: c.name):
            walk_bone(armature_obj, child)

    for item in chain:
        if item.kind == 'BONE':
            walk_bone(item.id_obj, item.bone_data)
        else:
            walk_object(item.id_obj)

    return result


def order_chain(chain):
    """Sort root-to-tip by hierarchy depth - Blender does not preserve click
    order for multi-selection, so this is the only reliable way to know
    which end of the chain is the root."""
    return sorted(chain, key=lambda item: item.hierarchy_depth())


# ---------------------------------------------------------------------------
# NLA anim-layer support
# ---------------------------------------------------------------------------

def push_base_action_to_nla(id_obj, frame_start):
    if id_obj.animation_data is None:
        id_obj.animation_data_create()
    anim = id_obj.animation_data
    if anim.action is not None:
        track = anim.nla_tracks.new()
        track.name = "Overlapper_Base"
        action = anim.action
        track.strips.new(action.name, int(frame_start), action)
        anim.action = None


def add_overlap_nla_layer(id_obj, action, frame_start):
    anim = id_obj.animation_data
    track = anim.nla_tracks.new()
    track.name = "Overlapper_Overlap"
    strip = track.strips.new(action.name, int(frame_start), action)
    strip.blend_type = 'ADD'
    strip.name = "Overlap"


# ---------------------------------------------------------------------------
# Curve evaluation - pure math, no scene.frame_set, can't drift
# ---------------------------------------------------------------------------

def evaluate_curves(loc_fcurves, rot_fcurves, frame, frame_start, frame_end, cyclic, cycle_len):
    if cyclic and cycle_len > 0:
        frame = frame_start + ((frame - frame_start) % cycle_len)
    else:
        frame = max(frame_start, min(frame_end, frame))

    loc = Vector((loc_fcurves[0].evaluate(frame),
                  loc_fcurves[1].evaluate(frame),
                  loc_fcurves[2].evaluate(frame)))
    quat = Quaternion((rot_fcurves[0].evaluate(frame),
                        rot_fcurves[1].evaluate(frame),
                        rot_fcurves[2].evaluate(frame),
                        rot_fcurves[3].evaluate(frame)))
    if quat.magnitude > 1e-8:
        quat.normalize()
    else:
        quat = Quaternion((1, 0, 0, 0))
    return loc, quat


def wind_offset(frame, speed, seed):
    phase = (seed * 12.9898) % (2 * math.pi)
    t = frame * 0.15 * max(speed, 0.0001) + phase
    y = math.sin(t) + 0.5 * math.sin(t * 2.13 + 1.0)
    z = math.cos(t * 0.87 + 1.3) + 0.5 * math.cos(t * 1.9 + 0.4)
    return y, z


def simplify_fcurves(fcurves, tolerance=0.0001):
    for fc in fcurves:
        pts = fc.keyframe_points
        to_remove = []
        for idx in range(1, len(pts) - 1):
            prev_v = pts[idx - 1].co[1]
            cur_v = pts[idx].co[1]
            next_v = pts[idx + 1].co[1]
            if abs(cur_v - prev_v) < tolerance and abs(cur_v - next_v) < tolerance:
                to_remove.append(idx)
        for idx in reversed(to_remove):
            pts.remove(pts[idx])
        fc.update()


def add_to_selection_set(chain):
    object_items = [it for it in chain if it.kind == 'OBJECT']
    bone_items = [it for it in chain if it.kind == 'BONE']

    if object_items:
        coll = get_or_create_collection(RESULT_COLLECTION_NAME)
        for it in object_items:
            if it.id_obj.name not in coll.objects:
                coll.objects.link(it.id_obj)

    if bone_items:
        by_armature = {}
        for it in bone_items:
            by_armature.setdefault(it.id_obj, []).append(it.bone_name)
        for armature_obj, bone_names in by_armature.items():
            try:
                arm_data = armature_obj.data
                bcoll = arm_data.collections.get(RESULT_COLLECTION_NAME)
                if bcoll is None:
                    bcoll = arm_data.collections.new(RESULT_COLLECTION_NAME)
                for bname in bone_names:
                    bone = arm_data.bones.get(bname)
                    if bone is not None:
                        bcoll.assign(bone)
            except AttributeError:
                pass


# ---------------------------------------------------------------------------
# Core algorithm - aim-based lag, ported from the Maya MEL source:
#
#   1. A clean "joint" (follower) is baked for every control - an exact,
#      unmodified copy of its world-space motion.
#   2. Each follower grows a "whisker": a point offset from it, in the
#      follower's OWN local frame, along the direction of the next control
#      in the chain (measured once, at the first frame - like Maya's joint
#      orient). The whisker rotates rigidly with the follower.
#   3. The whisker's position is sampled at a DELAYED frame (same delay for
#      every link - see note below) - that's the aim target.
#   4. The control's extra rotation = the swing needed to aim its whisker
#      at that delayed target instead of its current one.
#   5. Wind nudges the delayed target sideways before step 4, so it comes
#      out through the same aim math as real motion instead of being
#      tacked onto the rotation channel directly.
#
#   Delay is the SAME value at every link (matching the MEL source) rather
#   than growing per link - a properly parented FK/bone chain compounds it
#   naturally (child inherits the parent's lag, then adds its own), which
#   is what actually produces "tip lags more than the root".
# ---------------------------------------------------------------------------

def run_overlapper(context, props):
    scene = context.scene
    chain = get_selected_chain(context)

    if props.hierarchy_mode:
        chain = expand_hierarchy(chain)

    chain = order_chain(chain)

    if len(chain) < 2:
        return False, "Select at least two controls (objects, or pose bones in Pose Mode)."

    frame_start, frame_end = get_frame_range(context)
    frame_start, frame_end = int(frame_start), int(frame_end)
    if frame_end <= frame_start:
        return False, "Invalid frame range."

    cycle_len = frame_end - frame_start
    cyclic = props.cycle_mode

    start_index = 1 if props.dont_use_first else 0
    if len(chain) - start_index < 1:
        return False, "Not enough controls after 'Don't use first controls'."

    original_frame = scene.frame_current
    helper_coll = get_or_create_collection(HELPER_COLLECTION_NAME)

    # --- Step 1: follower empties + fcurves ---
    follower_curves = []
    for i, item in enumerate(chain):
        empty = create_empty(f"{HELPER_PREFIX}{i:02d}_{item.name}", helper_coll)
        action = ensure_action(empty)
        loc_fcs = [get_fcurve(empty, action, "location", c) for c in range(3)]
        rot_fcs = [get_fcurve(empty, action, "rotation_quaternion", c) for c in range(4)]
        follower_curves.append((loc_fcs, rot_fcs))

    # --- Step 2: single frame-major pass - bake followers AND capture each
    #     control's own baseline local rotation/location before anything
    #     gets modified. ---
    need_baseline = not props.bake_new_layer
    baseline_rot = {i: [] for i in range(start_index, len(chain))} if need_baseline else None
    baseline_loc = {i: [] for i in range(start_index, len(chain))} if (need_baseline and props.add_translate) else None

    spacing_samples = []

    for f in range(frame_start, frame_end + 1):
        scene.frame_set(f)
        prev_loc = None
        for i, item in enumerate(chain):
            mat = item.world_matrix()
            loc, quat, _scale = mat.decompose()
            loc_fcs, rot_fcs = follower_curves[i]
            for c in range(3):
                loc_fcs[c].keyframe_points.insert(f, loc[c], options={'FAST'})
            for c in range(4):
                rot_fcs[c].keyframe_points.insert(f, quat[c], options={'FAST'})

            if prev_loc is not None:
                spacing_samples.append((loc - prev_loc).length)
            prev_loc = loc

            if need_baseline and i >= start_index:
                baseline_rot[i].append(item.read_rotation_euler())
                if baseline_loc is not None:
                    baseline_loc[i].append(item.read_location())

    for loc_fcs, rot_fcs in follower_curves:
        for fc in loc_fcs + rot_fcs:
            for kp in fc.keyframe_points:
                kp.interpolation = 'LINEAR'
            fc.update()

    scene.frame_set(original_frame)

    # --- Step 3: bind-pose "whisker" direction for every link, in each
    #     follower's OWN local space, so it rotates rigidly with it later
    #     (this is what Maya's joint-orient step accomplishes). ---
    bind_pos, bind_quat = [], []
    for i in range(len(chain)):
        p, q = evaluate_curves(*follower_curves[i], frame_start, frame_start, frame_end, False, 0)
        bind_pos.append(p)
        bind_quat.append(q)

    bind_local_dir = []
    for i in range(len(chain)):
        if i < len(chain) - 1:
            world_dir = bind_pos[i + 1] - bind_pos[i]
        elif i > 0:
            world_dir = bind_pos[i] - bind_pos[i - 1]
        else:
            world_dir = Vector((1.0, 0.0, 0.0))
        if world_dir.length < 1e-6:
            world_dir = Vector((1.0, 0.0, 0.0))
        world_dir.normalize()
        bind_local_dir.append((bind_quat[i].inverted() @ world_dir).normalized())

    # --- Step 4: whisker length. Bigger Scale -> shorter whisker -> the
    #     same positional lag swings through a BIGGER angle -> more
    #     overlap. (This is the actual relationship in the source tool,
    #     even though it looks backwards at a glance.) ---
    intensity = max(props.scale, 0.0001)
    if props.adaptive_scale and spacing_samples:
        avg_spacing = sum(spacing_samples) / len(spacing_samples)
    else:
        avg_spacing = 1.0
    whisker_length = max(avg_spacing, 0.0001) / intensity

    delay = max(props.softness, 0.0)  # same delay at every link - see module docstring

    # --- Step 5: group by animated datablock (bones on one Armature share
    #     an action / NLA layers) ---
    groups = {}
    order = []
    for i in range(start_index, len(chain)):
        item = chain[i]
        key = item.id_obj.name
        if key not in groups:
            groups[key] = []
            order.append(key)
        groups[key].append(i)

    for key in order:
        entries = groups[key]
        id_obj = chain[entries[0]].id_obj

        if props.bake_new_layer:
            push_base_action_to_nla(id_obj, frame_start)
            target_action = bpy.data.actions.new(name=f"{id_obj.name}_Overlap")
            id_obj.animation_data.action = target_action
            additive_only = True
        else:
            target_action = ensure_action(id_obj)
            additive_only = False

        for i in entries:
            item = chain[i]
            follower_curve = follower_curves[i]
            local_dir = bind_local_dir[i]

            rot_prop = "rotation_quaternion" if item.rotation_mode() == 'QUATERNION' else "rotation_euler"
            rot_channels = 4 if rot_prop == "rotation_quaternion" else 3
            rot_fcurves = [get_fcurve(id_obj, target_action, item.data_path(rot_prop), c)
                           for c in range(rot_channels)]
            loc_fcurves = None
            if props.add_translate:
                loc_fcurves = [get_fcurve(id_obj, target_action, item.data_path("location"), c)
                               for c in range(3)]

            seed = (i + 1) * 7.13

            for f_index, f in enumerate(range(frame_start, frame_end + 1)):
                own_pos, own_quat = evaluate_curves(*follower_curve, f, frame_start, frame_end, cyclic, cycle_len)
                d_pos, d_quat = evaluate_curves(*follower_curve, f - delay, frame_start, frame_end, cyclic, cycle_len)

                aim_now = (own_quat @ local_dir).normalized()
                whisker_delayed_dir = (d_quat @ local_dir).normalized()
                delayed_target = d_pos + whisker_delayed_dir * whisker_length

                if props.use_wind:
                    up1 = (d_quat @ Vector((0.0, 1.0, 0.0))).normalized()
                    up2 = (d_quat @ Vector((0.0, 0.0, 1.0))).normalized()
                    wy, wz = wind_offset(f, props.wind_speed, seed)
                    wind_amp = 0.07 * whisker_length * props.wind_scale
                    delayed_target = delayed_target + up1 * (wy * wind_amp) + up2 * (wz * wind_amp)

                aim_dir = delayed_target - own_pos
                if aim_dir.length < 1e-6:
                    aim_dir = aim_now.copy()
                else:
                    aim_dir.normalize()

                swing = aim_now.rotation_difference(aim_dir)
                delta_local = own_quat.inverted() @ swing @ own_quat
                d_rot = delta_local.to_euler()

                if additive_only:
                    final_rot_euler = d_rot
                else:
                    base_euler = baseline_rot[i][f_index]
                    final_rot_euler = Euler((base_euler.x + d_rot.x,
                                              base_euler.y + d_rot.y,
                                              base_euler.z + d_rot.z))

                if rot_prop == "rotation_quaternion":
                    q = final_rot_euler.to_quaternion()
                    for c in range(4):
                        rot_fcurves[c].keyframe_points.insert(f, q[c], options={'FAST'})
                else:
                    for c in range(3):
                        rot_fcurves[c].keyframe_points.insert(f, final_rot_euler[c], options={'FAST'})

                if loc_fcurves is not None:
                    d_loc = d_pos - own_pos  # raw positional lag, unscaled
                    if additive_only:
                        final_loc = d_loc
                    else:
                        final_loc = baseline_loc[i][f_index] + d_loc
                    for c in range(3):
                        loc_fcurves[c].keyframe_points.insert(f, final_loc[c], options={'FAST'})

            for fc in rot_fcurves:
                fc.update()
            if loc_fcurves is not None:
                for fc in loc_fcurves:
                    fc.update()

            if props.delete_redundant:
                simplify_fcurves(rot_fcurves + (loc_fcurves or []))

        if props.bake_new_layer:
            add_overlap_nla_layer(id_obj, target_action, frame_start)

    if props.create_selection_set:
        add_to_selection_set(chain[start_index:])

    if not props.debug_mode:
        remove_collection(HELPER_COLLECTION_NAME)

    scene.frame_set(original_frame)
    return True, f"Overlap applied to {len(chain) - start_index} control(s)."


# ---------------------------------------------------------------------------
# Properties
# ---------------------------------------------------------------------------

class OverlapperProperties(bpy.types.PropertyGroup):
    softness: bpy.props.FloatProperty(
        name="Softness",
        description="Delay, in frames, applied at every link. A parented FK/bone chain "
                    "compounds this naturally down the hierarchy, so the tip ends up "
                    "lagging more than the root even though this value is the same "
                    "everywhere. Higher = looser/lighter, lower = stiffer/heavier",
        default=3.0, min=0.0, soft_max=30.0,
    )
    scale: bpy.props.FloatProperty(
        name="Scale",
        description="Overlap amplitude. Higher = more overlap motion",
        default=1.0, min=0.0001, soft_max=10.0,
    )
    use_wind: bpy.props.BoolProperty(
        name="Wind", description="Add procedural wind sway, even on a stationary character",
        default=False,
    )
    wind_scale: bpy.props.FloatProperty(
        name="Scale", description="Wind amplitude", default=1.0, min=0.0, soft_max=10.0,
    )
    wind_speed: bpy.props.FloatProperty(
        name="Speed", description="Wind frequency", default=1.0, min=0.0001, soft_max=10.0,
    )
    show_options: bpy.props.BoolProperty(name="Options", default=True)
    show_advanced: bpy.props.BoolProperty(name="Advanced", default=False)

    dont_use_first: bpy.props.BoolProperty(
        name="Don't use first controls",
        description="Don't use the first (root) control in the selected chain",
        default=False,
    )
    add_translate: bpy.props.BoolProperty(
        name="Add translate",
        description="Also create overlapping translation, not just rotation "
                    "(good for chest, hips, belt items, loose flesh)",
        default=False,
    )
    hierarchy_mode: bpy.props.BoolProperty(
        name="Hierarchy",
        description="Automatically add every child object / child bone below each "
                    "selected control - select just the root of an FK chain (works "
                    "with plain FK chains and rigs such as Advanced Skeleton)",
        default=False,
    )
    cycle_mode: bpy.props.BoolProperty(
        name="Cycle",
        description="Create a seamless overlapping action for cycle animation. The "
                    "first and last frame of the selected range must already match",
        default=False,
    )

    debug_mode: bpy.props.BoolProperty(
        name="Debug mode",
        description="Don't delete Overlapper helper objects. Expert mode, be careful",
        default=False,
    )
    bake_new_layer: bpy.props.BoolProperty(
        name="Bake on anim layer",
        description="Bake the overlap onto a separate, non-destructive NLA track "
                    "(Add-blended) instead of writing directly into the existing action",
        default=False,
    )
    adaptive_scale: bpy.props.BoolProperty(
        name="Adaptive scale",
        description="Base the overlap on the distance between selected controls, so "
                    "tiny or huge rigs don't need the Scale slider re-tuned by hand. "
                    "When off, a fixed 1-unit baseline is used instead",
        default=True,
    )
    create_selection_set: bpy.props.BoolProperty(
        name="Create selection set",
        description="Add the overlapped controls to an 'OverlapperSet' collection "
                    "(or Bone Collection, for bones)",
        default=True,
    )
    delete_redundant: bpy.props.BoolProperty(
        name="Delete redundant",
        description="Delete redundant keys on overlapped controls after baking",
        default=False,
    )


# ---------------------------------------------------------------------------
# Operators
# ---------------------------------------------------------------------------

class OVERLAPPER_OT_run(bpy.types.Operator):
    bl_idname = "overlapper.run"
    bl_label = "Overlap"
    bl_description = "Create overlapping / follow-through animation for the selected chain"
    bl_options = {'REGISTER', 'UNDO'}

    @classmethod
    def poll(cls, context):
        if context.mode == 'POSE':
            return bool(context.selected_pose_bones)
        return len(context.selected_objects) >= 1

    def execute(self, context):
        import time
        props = context.scene.overlapper_props
        t0 = time.time()
        try:
            ok, message = run_overlapper(context, props)
        except Exception as exc:
            self.report({'ERROR'}, f"Overlapper failed: {exc}")
            return {'CANCELLED'}
        if not ok:
            self.report({'WARNING'}, message)
            return {'CANCELLED'}
        elapsed = time.time() - t0
        self.report({'INFO'}, f"{message} ({elapsed:.2f}s)")
        return {'FINISHED'}


class OVERLAPPER_OT_cleanup(bpy.types.Operator):
    bl_idname = "overlapper.cleanup"
    bl_label = "CleanUp"
    bl_description = "Delete all Overlapper helper objects"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        remove_collection(HELPER_COLLECTION_NAME)
        for obj in list(bpy.data.objects):
            if obj.name.startswith(HELPER_PREFIX):
                bpy.data.objects.remove(obj, do_unlink=True)
        self.report({'INFO'}, "Overlapper helpers cleaned up.")
        return {'FINISHED'}


