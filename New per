class PERFECTOVERLAP_PG_props(
    bpy.types.PropertyGroup
):

    start_frame: bpy.props.IntProperty(
        name="Start Frame",
        default=0,
        min=0
    )

    end_frame: bpy.props.IntProperty(
        name="End Frame",
        default=100,
        min=1
    )

    delay: bpy.props.FloatProperty(
        name="Delay",
        default=3.0,
        min=1.0,
        max=10.0,
        description=(
            "How far the chain lags behind the "
            "control driving it"
        )
    )

    recursion: bpy.props.FloatProperty(
        name="Recursion",
        default=5.0,
        min=0.0,
        max=10.0,
        description=(
            "How much momentum carries through"
        )
    )

    strength: bpy.props.FloatProperty(
        name="Strength",
        default=1.0,
        min=1.0,
        max=10.0,
        description=(
            "Exaggerates the overlap offset"
        )
    )

    threshold: bpy.props.FloatProperty(
        name="Threshold",
        default=0.001,
        min=0.00001,
        max=0.1,
        step=0.01,
        precision=4,
        description=(
            "Motion smaller than this is ignored"
        )
    )

    debug: bpy.props.BoolProperty(
        name="Debug",
        default=False
    )

    animate_translate: bpy.props.BoolProperty(
        name="Translation",
        default=False,
        description=(
            "Also overlap unlocked translation axes"
        )
    )

    cycle: bpy.props.BoolProperty(
        name="Cycle",
        default=False,
        description=(
            "Solve the range as a continuous loop"
        )
    )

    cycle_preroll: bpy.props.IntProperty(
        name="Pre-roll Passes",
        default=2,
        min=1,
        max=6,
        description=(
            "Number of cyclic settling passes"
        )
    )


# =============================================================================
# CONFIGURATION
# =============================================================================

def _configure(module, props):

    module.sf = props.start_frame
    module.ef = props.end_frame

    module.debug = props.debug

    module.delay = props.delay
    module.recursion = props.recursion
    module.strength = props.strength
    module.threshold = props.threshold

    module.animate_translate = (
        props.animate_translate
    )

    return module


def _frame_range_ok(operator, props):

    if props.start_frame < props.end_frame:

        return True

    message = (
        "Make the start frame smaller than "
        "the end frame."
    )

    # operator.report alone already surfaces in the status bar / info log.
    # A popup on top of that would show the same message twice.
    operator.report(
        {"INFO"},
        message
    )

    return False


# =============================================================================
# CALCULATE OPERATOR
# =============================================================================

class PERFECTOVERLAP_OT_calculate(
    bpy.types.Operator
):

    bl_idname = "perfect_overlap.calculate"
    bl_label = "Calculate"
    bl_description = (
        "Calculate overlapping follow-through animation"
    )
    bl_options = {"REGISTER", "UNDO"}

    @classmethod
    def poll(cls, context):

        return (
            context.active_object is not None
            and context.active_object.type == "ARMATURE"
        )

    def execute(self, context):

        props = (
            context.scene.perfect_overlap_props
        )

        module = _configure(
            SJPhaserModule(),
            props
        )

        if not _frame_range_ok(
            self,
            props
        ):

            return {"CANCELLED"}

        scene = context.scene

        scene.frame_set(
            props.start_frame
        )

        bpy.ops.wm.redraw_timer(
            type="DRAW_WIN_SWAP",
            iterations=1
        )

        trees = module.get_tree_list()

        if not trees:

            message = (
                "No usable control chain. "
                "Select the controls to overlap."
            )

            self.report(
                {"WARNING"},
                message
            )

            return {"CANCELLED"}

        # Capture BEFORE modifying animation.
        start_pose = module.capture_pose(
            trees
        )

        # del_animkey() ends with restore_pose(trees, pose_snapshot), so the
        # pose is already back to the user's start pose once this returns.
        module.del_animkey(
            trees,
            start_pose
        )

        scene.frame_set(
            props.start_frame
        )

        module.set_pre_data(
            trees
        )

        # ---------------------------------------------------------------------
        # NORMAL
        # ---------------------------------------------------------------------

        if not props.cycle:

            module.execute(
                trees,
                write=True,
                include_start=False
            )

            module.cleanup_keys(
                trees
            )

            module.remove_cyclic_modifiers(
                trees
            )

        # ---------------------------------------------------------------------
        # CYCLE
        # ---------------------------------------------------------------------

        else:

            passes = module.solve_cycle(
                trees,
                props.cycle_preroll
            )

            name, difference = (
                module.cycle_residual(
                    trees
                )
            )

            module.cleanup_keys(
                trees
            )

            module.enforce_cycle_seam(
                trees
            )

            module.set_cycle_seam_tangents(
                trees
            )

            module.add_cyclic_modifiers(
                trees
            )

            if difference > 0.01:

                self.report(
                    {"WARNING"},
                    (
                        "Cycle drift {:.4f} on '{}'. "
                        "Increase Pre-roll Passes."
                    ).format(
                        difference,
                        name
                    )
                )

            else:

                self.report(
                    {"INFO"},
                    (
                        "Cycle solved. "
                        "Pre-roll: {}. "
                        "Drift: {:.5f}"
                    ).format(
                        passes,
                        difference
                    )
                )

        # ---------------------------------------------------------------------
        # TRANSLATION REPORT
        # ---------------------------------------------------------------------

        if (
            props.animate_translate
            and module.translate_skipped
        ):

            self.report(
                {"WARNING"},
                (
                    "Translation skipped on {} "
                    "control(s) because they are "
                    "connected or location-locked."
                ).format(
                    len(
                        module.translate_skipped
                    )
                )
            )

        scene.frame_set(
            props.start_frame
        )

        bpy.ops.wm.redraw_timer(
            type="DRAW_WIN_SWAP",
            iterations=1
        )

        return {"FINISHED"}


# =============================================================================
# DELETE OPERATOR
# =============================================================================

class PERFECTOVERLAP_OT_del_anim(
    bpy.types.Operator
):

    bl_idname = "perfect_overlap.del_anim"
    bl_label = "Delete Keyframe"
    bl_description = (
        "Delete the overlap animation keys"
    )
    bl_options = {"REGISTER", "UNDO"}

    @classmethod
    def poll(cls, context):

        return (
            context.active_object is not None
            and context.active_object.type == "ARMATURE"
        )

    def execute(self, context):

        props = (
            context.scene.perfect_overlap_props
        )

        module = _configure(
            SJPhaserModule(),
            props
        )

        if not _frame_range_ok(
            self,
            props
        ):

            return {"CANCELLED"}

        context.scene.frame_set(
            props.start_frame
        )

        bpy.ops.wm.redraw_timer(
            type="DRAW_WIN_SWAP",
            iterations=1
        )

        trees = module.get_tree_list()

        if not trees:

            self.report(
                {"WARNING"},
                "No selected overlap chain."
            )

            return {"CANCELLED"}

        start_pose = module.capture_pose(
            trees
        )

        # del_animkey() restores the captured pose at the end and clears
        # every CYCLES modifier on the action, so a cycle baked with a
        # previous selection is stopped here too.
        module.del_animkey(
            trees,
            start_pose
        )

        bpy.ops.wm.redraw_timer(
            type="DRAW_WIN_SWAP",
            iterations=1
        )

        return {"FINISHED"}


