import bpy
import math
import mathutils


# =============================================================================
# CONSTANTS
# =============================================================================

NON_CONTROL_PREFIXES = (
    "def-", "def_", "def.",
    "org-", "org_", "org.",
    "mch-", "mch_", "mch.",
    "wgt-", "wgt_", "wgt.",
    "vis-", "vis_", "vis.",
)

EPS = 1.0e-6
ZERO = mathutils.Vector((0.0, 0.0, 0.0))
BONE_AXIS = mathutils.Vector((0.0, 1.0, 0.0))

MAX_LAG_ANGLE = math.radians(150.0)
MAX_HEAD_DRIFT = 2.0


# =============================================================================
# PERFECT OVERLAP SOLVER
# =============================================================================

class SJPhaserModule:

    def __init__(self):
        self.delay = 3.0
        self.recursion = 5.0
        self.strength = 1.0
        self.threshold = 0.001

        self.sf = 0
        self.ef = 100

        self.debug = False
        self.animate_translate = False

        self.passes_run = 0
        self.translate_skipped = []

    # -------------------------------------------------------------------------
    # SOLVER PARAMETERS
    # -------------------------------------------------------------------------

    def solver_params(self):

        k = 1.0 / max(self.delay, 1.0)
        k = min(max(k, 0.05), 0.9)

        rec = min(max(self.recursion, 0.0), 10.0)

        zeta = 1.15 - (rec / 10.0) * 0.8

        c = 2.0 * zeta * math.sqrt(k)

        c = min(
            max(c, 0.0),
            min(1.9, (4.0 - k) * 0.5 * 0.95)
        )

        amp = 1.0 + (
            min(max(self.strength, 1.0), 10.0) - 1.0
        ) / 9.0

        return k, c, amp

    # -------------------------------------------------------------------------
    # VECTOR LIMIT
    # -------------------------------------------------------------------------

    def _limit_dir(self, base, vec, max_angle):

        if base.length < EPS:
            return vec.normalized()

        if vec.length < EPS:
            return base.normalized()

        base = base.normalized()
        vec = vec.normalized()

        dot = min(max(base.dot(vec), -1.0), 1.0)

        angle = math.acos(dot)

        if angle <= max_angle or angle < EPS:
            return vec

        t = max_angle / angle

        sin_angle = math.sin(angle)

        # Antiparallel (or numerically indistinguishable from it): any
        # perpendicular axis is as good as another. Pick one deterministically
        # and rotate `max_angle` from `base` around it.
        if sin_angle < EPS:

            perp = base.orthogonal()

            if perp.length < EPS:
                perp = mathutils.Vector((1.0, 0.0, 0.0))

            perp.normalize()

            return (
                base * math.cos(max_angle)
                + perp * math.sin(max_angle)
            ).normalized()

        out = (
            base * math.sin((1.0 - t) * angle)
            + vec * math.sin(t * angle)
        ) / sin_angle

        return out.normalized()

    # =========================================================================
    # RIG INSPECTION
    # =========================================================================

    def _bone_visible(self, pbn):

        bone = pbn.bone

        if bone.hide:
            return False

        colls = getattr(bone, "collections", None)

        if colls:

            for c in colls:

                visible = getattr(
                    c,
                    "is_visible_effectively",
                    getattr(c, "is_visible", True)
                )

                if visible:
                    return True

            return False

        return True

    def is_control_bone(self, pbn):

        if pbn.name.lower().startswith(NON_CONTROL_PREFIXES):
            return False

        return self._bone_visible(pbn)

    def control_children(self, pbn, _depth=0):

        result = []

        for child in pbn.children:

            if self.is_control_bone(child):

                result.append(child)

            elif _depth < 8:

                result.extend(
                    self.control_children(
                        child,
                        _depth + 1
                    )
                )

        return result

    def next_in_chain(self, pbn, candidates):

        if not candidates:
            return None

        if len(candidates) == 1:
            return candidates[0]

        for child in candidates:

            if child.bone.use_connect:
                return child

        tail = pbn.tail

        direction = pbn.tail - pbn.head

        if direction.length > EPS:
            direction.normalize()
        else:
            direction = BONE_AXIS.copy()

        scale = max(pbn.length, EPS)

        best = None
        best_score = None

        for child in candidates:

            distance = (
                (child.head - tail).length / scale
            )

            child_direction = child.tail - child.head

            if child_direction.length > EPS:
                alignment = (
                    child_direction.normalized().dot(direction)
                )
            else:
                alignment = -1.0

            score = distance - alignment

            if best_score is None or score < best_score:

                best_score = score
                best = child

        return best

    # =========================================================================
    # TRANSLATION
    # =========================================================================

    def translate_axes(self, pbn):

        if not self.animate_translate:
            return []

        if pbn.bone.use_connect:
            return []

        return [
            axis
            for axis in range(3)
            if not pbn.lock_location[axis]
        ]

    def can_translate(self, pbn):

        return bool(self.translate_axes(pbn))

    # =========================================================================
    # SELECTION / CHAINS
    # =========================================================================

    def get_selection(self):

        return list(
            bpy.context.selected_pose_bones or []
        )

    def get_hierarchy_count(self, obj):

        count = 0

        obj = obj.parent

        while obj is not None:

            obj = obj.parent
            count += 1

        return count

    def get_default_data_table(self):

        return {
            "obj_list": [],
            "offset": [],
            "length": [],
            "state": [],
        }

    def get_tree_list(self):

        selected = self.get_selection()

        selected_names = {
            pbn.name for pbn in selected
        }

        ordered = sorted(
            selected,
            key=self.get_hierarchy_count
        )

        trees = {}
        used = set()
        tree_index = 0

        for pbn in ordered:

            if pbn.name in used:
                continue

            if pbn.parent is None:
                continue

            chain = [pbn]

            used.add(pbn.name)

            current = pbn

            while True:

                candidates = [
                    child
                    for child in self.control_children(current)
                    if (
                        child.name in selected_names
                        and child.name not in used
                    )
                ]

                next_bone = self.next_in_chain(
                    current,
                    candidates
                )

                if next_bone is None:
                    break

                chain.append(next_bone)

                used.add(next_bone.name)

                current = next_bone

            depth = self.get_hierarchy_count(pbn)

            if depth not in trees:
                trees[depth] = {}

            name = "tree{}".format(tree_index)

            trees[depth][name] = (
                self.get_default_data_table()
            )

            trees[depth][name]["obj_list"] = chain

            tree_index += 1

        return trees

    def iter_chains(self, trees):

        for depth in sorted(trees.keys()):

            for name in sorted(trees[depth].keys()):

                yield trees[depth][name]

    def iter_bones(self, trees):

        for chain in self.iter_chains(trees):

            for pbn in chain["obj_list"]:

                yield pbn

    # =========================================================================
    # TRANSFORMS
    # =========================================================================

    def world_matrix(self, pbn):

        obj = bpy.context.active_object

        return obj.matrix_world @ pbn.matrix

    def _tip_of(self, matrix, length):

        return matrix @ mathutils.Vector(
            (0.0, length, 0.0)
        )

    # =========================================================================
    # INITIAL STATE
    # =========================================================================

    def set_pre_data(self, trees):

        self.translate_skipped = []

        for chain in self.iter_chains(trees):

            bones = chain["obj_list"]

            chain["offset"] = []
            chain["length"] = []
            chain["state"] = []

            for index, pbn in enumerate(bones):

                if index > 0:
                    reference = bones[index - 1]
                else:
                    reference = pbn.parent

                reference_matrix = self.world_matrix(reference)

                bone_matrix = self.world_matrix(pbn)

                offset = (
                    reference_matrix.inverted()
                    @ bone_matrix
                )

                chain["offset"].append(offset)

                length = max(pbn.length, EPS)

                chain["length"].append(length)

                chain["state"].append({
                    "head": bone_matrix.translation.copy(),
                    "head_vel": ZERO.copy(),

                    "tip": self._tip_of(
                        bone_matrix,
                        length
                    ),

                    "tip_vel": ZERO.copy(),

                    "prev_quat":
                        pbn.rotation_quaternion.copy(),

                    "prev_euler":
                        pbn.rotation_euler.copy(),
                })

                if (
                    self.animate_translate
                    and not self.can_translate(pbn)
                ):
                    self.translate_skipped.append(
                        pbn.name
                    )

        return trees

    # =========================================================================
    # ROTATION
    # =========================================================================

    def rotation_data_path(self, pbn):

        if pbn.rotation_mode == 'QUATERNION':
            return 'rotation_quaternion'

        if pbn.rotation_mode == 'AXIS_ANGLE':
            return 'rotation_axis_angle'

        return 'rotation_euler'

    def make_rotation_continuous(self, pbn, state):

        mode = pbn.rotation_mode

        if mode == 'QUATERNION':

            quat = pbn.rotation_quaternion.copy()

            previous = state.get("prev_quat")

            if previous is not None:

                if quat.dot(previous) < 0.0:

                    quat = mathutils.Quaternion(
                        (
                            -quat.w,
                            -quat.x,
                            -quat.y,
                            -quat.z
                        )
                    )

                    pbn.rotation_quaternion = quat

            state["prev_quat"] = quat.copy()

        elif mode == 'AXIS_ANGLE':

            # Axis-angle values are already generated from the resulting
            # matrix. Keep them untouched to avoid changing the user's mode.
            pass

        else:

            euler = pbn.rotation_euler.copy()

            previous = state.get("prev_euler")

            if previous is not None:

                euler.make_compatible(previous)

                pbn.rotation_euler = euler

            state["prev_euler"] = euler.copy()

    # =========================================================================
    # KEYFRAME
    # =========================================================================

    def set_animkey(self, pbn):

        frame = bpy.context.scene.frame_current

        for axis in self.translate_axes(pbn):

            pbn.keyframe_insert(
                data_path="location",
                index=axis,
                frame=frame
            )

        pbn.keyframe_insert(
            data_path=self.rotation_data_path(pbn),
            frame=frame
        )

    # =========================================================================
    # POSE SNAPSHOT
    # =========================================================================

    def capture_pose(self, trees):

        snapshot = {}

        for pbn in self.iter_bones(trees):

            snapshot[pbn.name] = {
                "location": pbn.location.copy(),
                "rotation_quaternion":
                    pbn.rotation_quaternion.copy(),
                "rotation_euler":
                    pbn.rotation_euler.copy(),
                "rotation_axis_angle":
                    list(pbn.rotation_axis_angle),
                "scale": pbn.scale.copy(),
            }

        return snapshot

    def restore_pose(self, trees, snapshot):

        if not snapshot:
            return

        for pbn in self.iter_bones(trees):

            values = snapshot.get(pbn.name)

            if values is None:
                continue

            pbn.location = values["location"].copy()

            pbn.rotation_quaternion = (
                values["rotation_quaternion"].copy()
            )

            old_euler = values["rotation_euler"]

            pbn.rotation_euler = mathutils.Euler(
                (
                    old_euler[0],
                    old_euler[1],
                    old_euler[2]
                ),
                old_euler.order
            )

            pbn.rotation_axis_angle = (
                values["rotation_axis_angle"]
            )

            pbn.scale = values["scale"].copy()

        bpy.context.view_layer.update()

    # =========================================================================
    # BLENDER 4.4+ / 5.x ACTION API
    # =========================================================================

    def _fcurve_container(self, id_data):

        animation_data = id_data.animation_data

        if animation_data is None:
            return None

        action = animation_data.action

        if action is None:
            return None

        # Blender 5.1's slotted Action API.
        #
        # On 5.0+ Action.fcurves was removed entirely, so the legacy fallback
        # below must use getattr() rather than a bare attribute access -- a
        # missing attribute there would raise and take the whole bake down.
        # If the helper itself is renamed in a future build we degrade to
        # "no keys touched" instead of crashing.
        try:
            from bpy_extras import anim_utils
        except ImportError:
            return getattr(action, "fcurves", None)

        get_bag = getattr(
            anim_utils,
            "action_get_channelbag_for_slot",
            None
        )

        if get_bag is None:
            return getattr(action, "fcurves", None)

        slot = getattr(
            animation_data,
            "action_slot",
            None
        )

        if slot is not None:

            try:
                channelbag = get_bag(action, slot)
            except (AttributeError, RuntimeError, TypeError):
                channelbag = None

            if channelbag is not None:
                return channelbag.fcurves

        # Legacy fallback (a slot-less action, e.g. one authored on <= 4.3
        # and never re-saved under the slotted layout).
        return getattr(action, "fcurves", None)

    def _get_fcurves(self, id_data):

        container = self._fcurve_container(id_data)

        if container is None:
            return []

        return list(container)

    # =========================================================================
    # F-CURVE MAPPING
    # =========================================================================

    def _chain_fcurve_map(self, trees):

        armature = bpy.context.active_object

        bones = {
            pbn.path_from_id(): pbn
            for pbn in self.iter_bones(trees)
        }

        result = []

        for fcurve in self._get_fcurves(armature):

            for prefix, pbn in bones.items():

                if fcurve.data_path.startswith(
                    prefix + "."
                ):

                    channel = (
                        fcurve.data_path[
                            len(prefix) + 1:
                        ]
                    )

                    result.append(
                        (
                            fcurve,
                            pbn,
                            channel
                        )
                    )

                    break

        return result

    def _baked_channels(self, trees):

        groups = {}

        for fcurve, pbn, channel in self._chain_fcurve_map(trees):

            if channel == self.rotation_data_path(pbn):

                pass

            elif (
                channel == "location"
                and fcurve.array_index
                in self.translate_axes(pbn)
            ):

                pass

            else:

                continue

            key = (
                pbn.name,
                channel
            )

            groups.setdefault(
                key,
                []
            ).append(
                (fcurve, pbn)
            )

        return groups

    def _baked_fcurves(self, trees):

        result = []

        for curves in self._baked_channels(trees).values():

            result.extend(curves)

        return result

    # =========================================================================
    # REMOVE KEYS
    # =========================================================================

    def del_animkey(
        self,
        trees,
        pose_snapshot=None
    ):

        container = self._fcurve_container(
            bpy.context.active_object
        )

        emptied = []

        for (
            fcurve,
            pbn,
            channel
        ) in self._chain_fcurve_map(trees):

            if channel == "location":

                if (
                    fcurve.array_index
                    not in self.translate_axes(pbn)
                ):
                    continue

            elif channel not in (
                "rotation_euler",
                "rotation_quaternion",
                "rotation_axis_angle",
                "scale"
            ):

                continue

            points = fcurve.keyframe_points

            remove_indices = [
                index
                for index, point in enumerate(points)
                if (
                    self.sf
                    <= point.co[0]
                    <= self.ef
                )
            ]

            for index in reversed(remove_indices):

                points.remove(
                    points[index],
                    fast=True
                )

            fcurve.update()

            if len(points) == 0:

                emptied.append(fcurve)

        if container is not None:

            for fcurve in emptied:

                try:
                    container.remove(fcurve)

                except (
                    RuntimeError,
                    ReferenceError
                ):
                    pass

        bpy.context.view_layer.update()

        self.restore_pose(
            trees,
            pose_snapshot
        )

        frame = self.sf

        for pbn in self.iter_bones(trees):

            for axis in self.translate_axes(pbn):

                pbn.keyframe_insert(
                    data_path="location",
                    index=axis,
                    frame=frame
                )

            pbn.keyframe_insert(
                data_path=self.rotation_data_path(pbn),
                frame=frame
            )

        self.remove_cyclic_modifiers(trees)

    # =========================================================================
    # CYCLE MODIFIERS
    # =========================================================================

    def add_cyclic_modifiers(self, trees):

        for fcurve, _bone in self._baked_fcurves(trees):

            if not any(
                modifier.type == "CYCLES"
                for modifier in fcurve.modifiers
            ):

                # Keyword form: positional .new("CYCLES") is deprecated in
                # 4.4+ and gone in 5.0.
                fcurve.modifiers.new(
                    type="CYCLES"
                )

    def remove_cyclic_modifiers(self, trees=None):
        r"""Remove every CYCLES F-Curve modifier from the armature.

        `trees` is accepted for call-site compatibility but deliberately
        ignored: a selection-scoped sweep only touches the curves of bones
        that happen to be selected *right now*, so changing the selection
        after a cycle bake leaves the modifiers running on the curves they
        were added to. Walking the whole action is the only way to actually
        stop a cycle -- which matters for both "tick Cycle off, Calculate"
        and "Delete Keyframe" after a cycle bake."""

        armature = bpy.context.active_object

        if armature is None:
            return 0

        removed = 0

        for fcurve in self._get_fcurves(armature):

            for modifier in list(fcurve.modifiers):

                if modifier.type == "CYCLES":

                    fcurve.modifiers.remove(modifier)

                    removed += 1

        return removed

    # =========================================================================
    # KEY CLEANUP
    # =========================================================================

    def cleanup_keys(self, trees):

        tolerance = max(
            self.threshold,
            1.0e-6
        )

        removed = 0

        for curves in self._baked_channels(
            trees
        ).values():

            fcurves = [
                fc
                for fc, _bone in curves
            ]

            if not fcurves:
                continue

            frame_sets = []

            for fc in fcurves:

                frame_sets.append(
                    {
                        kp.co[0]
                        for kp in fc.keyframe_points
                        if (
                            self.sf
                            <= kp.co[0]
                            <= self.ef
                        )
                    }
                )

            if not frame_sets:
                continue

            common_frames = set.intersection(
                *frame_sets
            )

            frames = sorted(common_frames)

            if len(frames) <= 2:

                self._smooth(fcurves)

                continue

            lookup_values = []

            for fc in fcurves:

                lookup = {
                    kp.co[0]: kp.co[1]
                    for kp in fc.keyframe_points
                }

                lookup_values.append(
                    [
                        lookup[frame]
                        for frame in frames
                    ]
                )

            drop_frames = set()

            previous = 0

            for index in range(
                1,
                len(frames) - 1
            ):

                f0 = frames[previous]
                f1 = frames[index]
                f2 = frames[index + 1]

                if abs(f2 - f0) < EPS:
                    continue

                ratio = (
                    (f1 - f0)
                    / (f2 - f0)
                )

                redundant = True

                for values in lookup_values:

                    interpolated = (
                        values[previous]
                        + (
                            values[index + 1]
                            - values[previous]
                        ) * ratio
                    )

                    if abs(
                        values[index]
                        - interpolated
                    ) > tolerance:

                        redundant = False
                        break

                if redundant:

                    drop_frames.add(f1)

                else:

                    previous = index

            for fc in fcurves:

                points = fc.keyframe_points

                indices = [
                    index
                    for index, kp
                    in enumerate(points)
                    if kp.co[0] in drop_frames
                ]

                for index in reversed(indices):

                    points.remove(
                        points[index],
                        fast=True
                    )

                    removed += 1

                fc.update()

            self._smooth(fcurves)

        return removed

    def _smooth(self, fcurves):

        for fcurve in fcurves:

            for kp in fcurve.keyframe_points:

                if (
                    self.sf
                    <= kp.co[0]
                    <= self.ef
                ):

                    kp.interpolation = "BEZIER"

                    kp.handle_left_type = (
                        "AUTO_CLAMPED"
                    )

                    kp.handle_right_type = (
                        "AUTO_CLAMPED"
                    )

            fcurve.update()

    # =========================================================================
    # CYCLE ANALYSIS
    # =========================================================================

    def cycle_residual(self, trees):

        worst = 0.0
        worst_name = ""

        for fcurve, pbn in self._baked_fcurves(trees):

            start_value = fcurve.evaluate(
                self.sf
            )

            end_value = fcurve.evaluate(
                self.ef
            )

            difference = abs(
                end_value - start_value
            )

            if difference > worst:

                worst = difference
                worst_name = pbn.name

        return worst_name, worst

    def _seam_keys(self, fcurve):

        first = None
        last = None

        for kp in fcurve.keyframe_points:

            frame = int(
                round(kp.co[0])
            )

            if frame == self.sf:
                first = kp

            elif frame == self.ef:
                last = kp

        return first, last

    def enforce_cycle_seam(self, trees):

        for fcurve, _bone in self._baked_fcurves(trees):

            first, last = self._seam_keys(
                fcurve
            )

            if (
                first is None
                or last is None
                or first is last
            ):
                continue

            last.co[1] = first.co[1]

            fcurve.update()

    def set_cycle_seam_tangents(self, trees):

        for fcurve, _bone in self._baked_fcurves(trees):

            first, last = self._seam_keys(
                fcurve
            )

            if (
                first is None
                or last is None
                or first is last
            ):
                continue

            after = None
            before = None

            for kp in fcurve.keyframe_points:

                frame = kp.co[0]

                if (
                    first.co[0]
                    < frame
                    <= last.co[0]
                ):

                    if after is None:
                        after = kp

                    if frame < last.co[0]:
                        before = kp

            if (
                after is None
                or before is None
                or after is last
                or before is first
            ):
                continue

            dt_a = (
                after.co[0]
                - first.co[0]
            )

            dt_b = (
                last.co[0]
                - before.co[0]
            )

            if dt_a + dt_b < EPS:
                continue

            slope = (
                after.co[1]
                - before.co[1]
            ) / (
                dt_a + dt_b
            )

            first.interpolation = "BEZIER"
            last.interpolation = "BEZIER"

            first.handle_left_type = "FREE"
            first.handle_right_type = "FREE"

            last.handle_left_type = "FREE"
            last.handle_right_type = "FREE"

            first.handle_left = (
                first.co[0] - dt_b / 3.0,
                first.co[1] - slope * dt_b / 3.0
            )

            first.handle_right = (
                first.co[0] + dt_a / 3.0,
                first.co[1] + slope * dt_a / 3.0
            )

            last.handle_left = (
                last.co[0] - dt_b / 3.0,
                last.co[1] - slope * dt_b / 3.0
            )

            last.handle_right = (
                last.co[0] + dt_a / 3.0,
                last.co[1] + slope * dt_a / 3.0
            )

            fcurve.update()

    # =========================================================================
    # SOLVER
    # =========================================================================

    def solve_bone(
        self,
        chain,
        index,
        driver_matrix,
        k,
        c,
        amp
    ):

        pbn = chain["obj_list"][index]

        state = chain["state"][index]

        target_matrix = (
            driver_matrix
            @ chain["offset"][index]
        )

        target_quat = (
            target_matrix
            .to_quaternion()
            .normalized()
        )

        target_head = (
            target_matrix.translation.copy()
        )

        length = max(
            chain["length"][index],
            EPS
        )

        target_tip = self._tip_of(
            target_matrix,
            length
        )

        target_segment = (
            target_tip
            - target_head
        )

        if target_segment.length < EPS:

            target_direction = (
                target_quat
                @ BONE_AXIS
            ).normalized()

            target_tip = (
                target_head
                + target_direction * length
            )

        target_direction = (
            target_tip
            - target_head
        ).normalized()

        # ---------------------------------------------------------------------
        # HEAD / TRANSLATION
        # ---------------------------------------------------------------------

        if self.can_translate(pbn):

            head_velocity = (
                state["head_vel"] * (1.0 - c)
                + (
                    target_head
                    - state["head"]
                ) * k
            )

            if head_velocity.length < self.threshold:

                head_velocity = ZERO.copy()

            state["head_vel"] = head_velocity

            state["head"] += head_velocity

            drift = (
                state["head"]
                - target_head
            )

            if drift.length > (
                length * MAX_HEAD_DRIFT
            ):

                state["head"] = (
                    target_head
                    + drift.normalized()
                    * length
                    * MAX_HEAD_DRIFT
                )

                state["head_vel"] = ZERO.copy()

            output_head = (
                target_head
                + (
                    state["head"]
                    - target_head
                ) * amp
            )

        else:

            state["head"] = target_head.copy()
            state["head_vel"] = ZERO.copy()

            output_head = target_head.copy()

        # ---------------------------------------------------------------------
        # TIP SOLVER
        # ---------------------------------------------------------------------

        tip_velocity = (
            state["tip_vel"] * (1.0 - c)
            + (
                target_tip
                - state["tip"]
            ) * k
        )

        if tip_velocity.length < self.threshold:

            tip_velocity = ZERO.copy()

        state["tip_vel"] = tip_velocity

        state["tip"] += tip_velocity

        # Preserve exact bone length.
        span = (
            state["tip"]
            - state["head"]
        )

        if span.length < EPS:

            span = target_direction.copy()

        state["tip"] = (
            state["head"]
            + span.normalized()
            * length
        )

        simulated_direction = (
            state["tip"]
            - state["head"]
        ).normalized()

        # ---------------------------------------------------------------------
        # STRENGTH
        # ---------------------------------------------------------------------

        if amp > 1.0:

            output_direction = (
                target_direction
                + (
                    simulated_direction
                    - target_direction
                ) * amp
            )

            if output_direction.length > EPS:

                output_direction.normalize()

            else:

                output_direction = (
                    simulated_direction
                )

        else:

            output_direction = (
                simulated_direction
            )

        output_direction = self._limit_dir(
            target_direction,
            output_direction,
            MAX_LAG_ANGLE
        )

        # Preserve rig roll.
        output_quaternion = (
            target_direction.rotation_difference(
                output_direction
            )
            @ target_quat
        )

        output_quaternion.normalize()

        return (
            mathutils.Matrix.Translation(
                output_head
            )
            @ output_quaternion.to_matrix().to_4x4()
        )

    # =========================================================================
    # SOLVE CHAIN
    # =========================================================================

    def solve_chain(
        self,
        chain,
        k,
        c,
        amp,
        write
    ):

        armature = bpy.context.active_object

        armature_inverse = (
            armature.matrix_world.inverted()
        )

        bones = chain["obj_list"]

        if not bones:
            return

        driver_matrix = self.world_matrix(
            bones[0].parent
        )

        for index, pbn in enumerate(bones):

            original_location = (
                pbn.location.copy()
            )

            original_scale = (
                pbn.scale.copy()
            )

            should_translate = (
                self.can_translate(pbn)
            )

            solved_world = self.solve_bone(
                chain,
                index,
                driver_matrix,
                k,
                c,
                amp
            )

            # World -> pose space.
            solved_pose = (
                armature_inverse
                @ solved_world
            )

            pbn.matrix = solved_pose

            # Never allow solver to alter scale.
            pbn.scale = original_scale

            # Connected / locked translation must remain untouched.
            if not should_translate:

                pbn.location = (
                    original_location
                )

            else:

                for axis in range(3):

                    if pbn.lock_location[axis]:

                        pbn.location[axis] = (
                            original_location[axis]
                        )

            self.make_rotation_continuous(
                pbn,
                chain["state"][index]
            )

            # CRITICAL: PoseBone.matrix's setter writes only chan_mat, not
            # pose_mat -- pose_mat is written by depsgraph evaluation. The
            # next bone in this chain reads its driver through world_matrix(),
            # which reads pose_mat, so without this update the whole chain
            # would solve against the pre-solve parent transform every frame.
            # (No-op for a chain with a single bone, but a real cost on long
            # chains -- profile before removing.)
            bpy.context.view_layer.update()

            if write:

                self.set_animkey(pbn)

            # The next bone follows the ACTUAL resulting transform,
            # constraints and locks included.
            driver_matrix = self.world_matrix(
                pbn
            )

    # =========================================================================
    # EXECUTION
    # =========================================================================

    def execute(
        self,
        trees,
        write=True,
        include_start=False
    ):

        k, c, amp = self.solver_params()

        scene = bpy.context.scene

        first_frame = (
            self.sf
            if include_start
            else self.sf + 1
        )

        for frame in range(
            first_frame,
            self.ef + 1
        ):

            scene.frame_set(frame)

            for chain in self.iter_chains(trees):

                self.solve_chain(
                    chain,
                    k,
                    c,
                    amp,
                    write
                )

        self.passes_run += 1

        return True

    # =========================================================================
    # CYCLIC SOLVER
    # =========================================================================

    def solve_cycle(
        self,
        trees,
        preroll
    ):

        self.passes_run = 0

        passes = max(
            1,
            int(preroll)
        )

        for _ in range(passes):

            self.execute(
                trees,
                write=False,
                include_start=True
            )

        self.execute(
            trees,
            write=True,
            include_start=True
        )

        return passes

    # =========================================================================
    # MESSAGE
    # =========================================================================

    def message_box(
        self,
        message="",
        title="Message",
        icon="INFO"
    ):

        def draw(self, context):

            self.layout.label(
                text=message
            )

        bpy.context.window_manager.popup_menu(
            draw,
            title=title,
            icon=icon
        )


