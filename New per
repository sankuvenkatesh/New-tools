# =============================================================================

class PERFECTOVERLAP_OT_reset_settings(
    bpy.types.Operator
):

    bl_idname = "perfect_overlap.reset_settings"
    bl_label = "Reset Settings"
    bl_description = (
        "Reset Perfect Overlap settings"
    )
    bl_options = {"REGISTER", "UNDO"}

    def execute(self, context):

        props = (
            context.scene.perfect_overlap_props
        )

        for prop in props.bl_rna.properties:

            if prop.identifier in {
                "rna_type",
                "name"
            }:
                continue

            try:
                props.property_unset(
                    prop.identifier
                )
            except Exception:
                pass

        self.report(
            {"INFO"},
            "Perfect Overlap settings reset"
        )

        return {"FINISHED"}


