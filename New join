import bpy
from bpy_extras import anim_utils

# Blender 5.1 - 5.2.x (5.2 LTS) conservative armature/mesh merger.
#
# Bone names and vertex-group names are kept EXACTLY as they are (no prefix,
# no renaming). Because of that, bone names must be unique across all
# selected armatures; if two rigs share a bone name the script stops before
# changing anything and lists the duplicates.
#
# Run in Object Mode on a saved duplicate. Select >=2 armatures and only
# their meshes. Make the intended surviving armature active.
#
# Steps:
#  1. Preflight (nothing is modified): Blender version, selection, unique
#     bone names, every mesh belongs to exactly one selected armature,
#     modifiers on non-active meshes.
#  2. Copy the active action of every selected armature into one new action
#     (same bone paths, nothing remapped).
#  3. Detach meshes (parent + Armature modifiers removed), join meshes,
#     join armatures into the survivor, then reparent the joined mesh and
#     give it a new Armature modifier (first in the stack).

MIN_VERSION = (5, 1, 0)
ACTION_NAME = "MERGED_Combined_Action"


def log(msg):
    print("[Safe Rig Merger] " + str(msg))


def unique_name(collection, base):
    if base not in collection:
        return base
    i = 1
    while f"{base}.{i:03d}" in collection:
        i += 1
    return f"{base}.{i:03d}"


def deselect_all():
    for obj in bpy.context.view_layer.objects:
        if obj.select_get():
            obj.select_set(False)


def is_identity(matrix, eps=1e-5):
    for i in range(4):
        for j in range(4):
            expected = 1.0 if i == j else 0.0
            if abs(matrix[i][j] - expected) > eps:
                return False
    return True


def rig_for_mesh(mesh, armatures):
    found = []
    for mod in mesh.modifiers:
        if mod.type == 'ARMATURE' and mod.object in armatures:
            if mod.object not in found:
                found.append(mod.object)
    if mesh.parent in armatures and mesh.parent not in found:
        found.append(mesh.parent)
    if len(found) > 1:
        raise RuntimeError(
            f'{mesh.name}: linked to multiple selected armatures; resolve manually.'
        )
    return found[0] if found else None


def check_unique_bones(arms):
    """Names are kept unchanged, so bone names must not clash between rigs.

    Blender's Join would otherwise silently add .001 suffixes, which breaks
    animation paths and vertex-group bindings.
    """
    owners = {}
    clashes = {}
    for arm in arms:
        for bone in arm.data.bones:
            if bone.name in owners:
                clashes.setdefault(bone.name, [owners[bone.name]]).append(arm.name)
            else:
                owners[bone.name] = arm.name
    if clashes:
        lines = [f'"{name}" ({", ".join(rigs)})'
                 for name, rigs in sorted(clashes.items())]
        shown = "; ".join(lines[:10])
        extra = f" (+{len(lines) - 10} more)" if len(lines) > 10 else ""
        raise RuntimeError(
            "Bone names are kept unchanged, so they must be unique across the "
            "selected armatures. Duplicates: " + shown + extra + ". Rename or "
            "delete the duplicate bones in one of the rigs first."
        )


def armature_mod_settings(mesh, rig):
    for mod in mesh.modifiers:
        if mod.type == 'ARMATURE' and mod.object == rig:
            return {
                "use_deform_preserve_volume": mod.use_deform_preserve_volume,
                "use_multi_modifier": mod.use_multi_modifier,
            }
    return {}


def move_modifier_first(obj, modifier_name):
    try:
        obj.modifiers.move(len(obj.modifiers) - 1, 0)
        return
    except Exception:
        pass
    try:
        with bpy.context.temp_override(object=obj, active_object=obj):
            bpy.ops.object.modifier_move_to_index(
                modifier=modifier_name, index=0)
    except Exception as exc:
        log(f"WARNING: could not move the Armature modifier to the top of "
            f"{obj.name}'s stack ({exc}). Move it manually.")


def copy_fcurve(src, bag):
    path = src.data_path
    idx = src.array_index
    if bag.fcurves.find(path, index=idx) is not None:
        raise RuntimeError(
            f"Duplicate animation channel: {path}[{idx}]. Non-bone channels "
            "(object transform, custom properties) from several rigs cannot "
            "be merged; remove them from the source actions first."
        )
    kwargs = {"index": idx}
    if src.group:
        kwargs["group_name"] = src.group.name
    try:
        dst = bag.fcurves.new(path, **kwargs)
    except TypeError as exc:
        raise RuntimeError(
            "Channelbag fcurves.new(group_name=...) failed before scene "
            "joins: " + str(exc)
        )
    dst.extrapolation = src.extrapolation
    dst.auto_smoothing = src.auto_smoothing
    dst.mute = src.mute
    dst.lock = src.lock

    n = len(src.keyframe_points)
    if n:
        dst.keyframe_points.add(n)
        for a, b in zip(src.keyframe_points, dst.keyframe_points):
            b.co = a.co
            b.interpolation = a.interpolation
            b.easing = a.easing
            b.type = a.type
            b.handle_left_type = a.handle_left_type
            b.handle_right_type = a.handle_right_type
            b.handle_left = a.handle_left
            b.handle_right = a.handle_right
            for attr in ("back", "amplitude", "period"):
                if hasattr(a, attr) and hasattr(b, attr):
                    try:
                        setattr(b, attr, getattr(a, attr))
                    except Exception:
                        pass

    for src_mod in src.modifiers:
        try:
            dst_mod = dst.modifiers.new(src_mod.type)
        except Exception as exc:
            log(f"Could not copy FCurve modifier {src_mod.type}: {exc}")
            continue
        for prop in src_mod.bl_rna.properties:
            key = prop.identifier
            if key in {"rna_type", "type"} or prop.is_readonly:
                continue
            try:
                setattr(dst_mod, key, getattr(src_mod, key))
            except Exception:
                pass
    dst.update()


def collect_actions(armatures):
    sources = []
    for arm in armatures:
        ad = arm.animation_data
        if not ad or not ad.action:
            log(f"{arm.name}: no active action; skipped.")
            continue
        action, slot = ad.action, ad.action_slot
        if slot is None:
            log(f"{arm.name}: active action has no slot; skipped.")
            continue
        bag = anim_utils.action_get_channelbag_for_slot(action, slot)
        if bag is None:
            log(f"{arm.name}: no channelbag; skipped.")
            continue
        non_bone = sum(1 for fc in bag.fcurves
                       if not fc.data_path.startswith("pose.bones["))
        if non_bone:
            log(f"WARNING: {arm.name} has {non_bone} non-bone channel(s) "
                "(object transform, custom props...). They are copied as-is "
                "onto the surviving armature object.")
        sources.append({
            "curves": list(bag.fcurves),
            "start": action.frame_start,
            "end": action.frame_end,
            "use_range": action.use_frame_range,
        })
    return sources


def build_action(sources, survivor):
    """Create/populate the action before joins so API errors are non-destructive."""
    if not sources:
        return None, None
    action = bpy.data.actions.new(unique_name(bpy.data.actions, ACTION_NAME))
    action.use_fake_user = True
    try:
        slot = action.slots.new(id_type='OBJECT', name=survivor.name)
        bag = anim_utils.action_ensure_channelbag_for_slot(action, slot)
        starts, ends = [], []
        for source in sources:
            if source["use_range"]:
                starts.append(source["start"])
                ends.append(source["end"])
            for fc in source["curves"]:
                copy_fcurve(fc, bag)
        if starts:
            action.use_frame_range = True
            action.frame_start = min(starts)
            action.frame_end = max(ends)
        return action, slot
    except Exception:
        try:
            action.use_fake_user = False
            bpy.data.actions.remove(action)
        except Exception:
            pass
        raise


def warn_rig_state(armatures, survivor):
    selected_ids = set(armatures)

    for arm in armatures:
        ad = arm.animation_data

        if ad and arm != survivor:
            if len(ad.nla_tracks):
                log(f"WARNING: {arm.name} has {len(ad.nla_tracks)} NLA "
                    "track(s); NLA of non-survivor rigs is not merged.")
            if len(ad.drivers):
                log(f"WARNING: {arm.name} has {len(ad.drivers)} driver(s); "
                    "drivers on non-survivor rigs are not carried over by Join.")

        if ad and arm == survivor:
            for driver in ad.drivers:
                for variable in driver.driver.variables:
                    for target in variable.targets:
                        target_id = target.id
                        if (target_id is not None and target_id in selected_ids
                                and target_id != survivor):
                            log(f'REVIEW: survivor driver "{driver.data_path}" '
                                f"references {target_id.name}, which is joined "
                                "into the survivor; verify it after the merge.")

        for pose_bone in arm.pose.bones:
            if arm != survivor and not is_identity(pose_bone.matrix_basis):
                log(f"WARNING: {arm.name}/{pose_bone.name} has non-identity "
                    "pose transforms; verify after joining.")

            for constraint in pose_bone.constraints:
                target = getattr(constraint, "target", None)
                if (target is not None and target in selected_ids
                        and target != survivor):
                    sub = getattr(constraint, "subtarget", "")
                    where = f' / bone "{sub}"' if sub else ""
                    log(f"REVIEW: {arm.name}/{pose_bone.name} constraint "
                        f'"{constraint.name}" targets {target.name}{where}, '
                        "which is joined into the survivor; verify after merge.")


def validate():
    if bpy.app.version < MIN_VERSION:
        raise RuntimeError(
            "Requires Blender %d.%d.%d or newer." % MIN_VERSION
        )
    if bpy.context.mode != 'OBJECT':
        raise RuntimeError("Switch to Object Mode.")
    selected = list(bpy.context.selected_objects)
    arms = [o for o in selected if o.type == 'ARMATURE']
    meshes = [o for o in selected if o.type == 'MESH']
    if len(arms) < 2:
        raise RuntimeError("Select at least two armature objects.")
    ids = [a.data.as_pointer() for a in arms]
    if len(ids) != len(set(ids)):
        raise RuntimeError(
            "Selected armature objects share armature data. Make data single-user "
            "or deselect one of the offending objects."
        )
    active = bpy.context.view_layer.objects.active
    survivor = active if active in arms else arms[0]
    return arms, meshes, survivor


def main():
    created_action = None
    try:
        arms, meshes, survivor = validate()
        log(f"Survivor: {survivor.name}")

        check_unique_bones(arms)
        mesh_rigs = {m: rig_for_mesh(m, arms) for m in meshes}
        mesh_world = {m: m.matrix_world.copy() for m in meshes}

        active_obj = bpy.context.view_layer.objects.active
        active_mesh = (active_obj if active_obj in meshes
                       else (meshes[0] if meshes else None))

        # Preflight all meshes before modifying the scene.
        for mesh in meshes:
            rig = mesh_rigs[mesh]
            if rig is None:
                raise RuntimeError(
                    f'{mesh.name}: no selected rig detected. Deselect it or '
                    "assign it to the correct selected armature."
                )
            if mesh != active_mesh:
                unsupported = [mod.name for mod in mesh.modifiers
                               if mod.type != 'ARMATURE']
                if unsupported:
                    raise RuntimeError(
                        f'{mesh.name}: non-active mesh has modifiers that Join '
                        f"would discard: {', '.join(unsupported)}. Apply or "
                        "resolve them before merging."
                    )
            keys = mesh.data.shape_keys
            if keys and len(meshes) > 1:
                log(f"WARNING: {mesh.name} has shape keys; Join only merges "
                    "matching key layouts and the active mesh's Basis wins.")
            if keys and keys.animation_data:
                log(f"WARNING: {mesh.name} has shape-key animation/drivers; "
                    "these are not merged by Join.")
            for mod in mesh.modifiers:
                if (mod.type == 'ARMATURE' and mod.object == rig
                        and mod.use_bone_envelopes):
                    log(f"WARNING: {mesh.name}/{mod.name} uses bone envelopes; "
                        "the new modifier will use vertex groups only.")

        mod_settings = {}
        if active_mesh:
            mod_settings = armature_mod_settings(active_mesh, mesh_rigs[active_mesh])
        variants = {}
        for mesh in meshes:
            s = armature_mod_settings(mesh, mesh_rigs[mesh])
            if s:
                variants.setdefault(tuple(sorted(s.items())), []).append(mesh.name)
        if len(variants) > 1:
            log("WARNING: meshes have different Armature modifier settings "
                "(Preserve Volume / Multi-Modifier); the merged mesh uses the "
                f"active mesh's settings ({active_mesh.name}).")

        action_sources = collect_actions(arms)

        # Create/populate the action before destructive joins.
        created_action, combined_slot = build_action(action_sources, survivor)

        # Warnings are captured while original objects and references still exist.
        warn_rig_state(arms, survivor)

        # Create an undo boundary immediately before the first scene mutation.
        try:
            bpy.ops.ed.undo_push(message="Safe Armature and Mesh Merge")
        except Exception:
            pass

        # Detach meshes preserving world transforms; remove only selected-rig
        # Armature modifiers (they would point at rigs that are about to merge).
        for mesh in meshes:
            mesh.parent = None
            mesh.matrix_world = mesh_world[mesh]
            for mod in list(mesh.modifiers):
                if mod.type == 'ARMATURE' and mod.object in arms:
                    mesh.modifiers.remove(mod)

        # Join meshes. Only the active mesh's modifiers survive, hence preflight.
        joined_mesh = None
        if meshes:
            deselect_all()
            for mesh in meshes:
                mesh.select_set(True)
            bpy.context.view_layer.objects.active = active_mesh
            bpy.ops.object.join()
            joined_mesh = active_mesh
            joined_mesh.name = unique_name(
                bpy.data.objects, survivor.name + "_JoinedMesh"
            )

        # Join armatures into the chosen survivor (bone names are unique, so
        # Blender adds no suffixes).
        deselect_all()
        for arm in arms:
            arm.select_set(True)
        bpy.context.view_layer.objects.active = survivor
        bpy.ops.object.join()

        survivor.name = unique_name(
            bpy.data.objects, survivor.name + "_CombinedRig"
        )
        survivor.data.name = unique_name(
            bpy.data.armatures, survivor.name + "_ArmatureData"
        )

        if created_action:
            ad = survivor.animation_data or survivor.animation_data_create()
            ad.action = created_action
            ad.action_slot = combined_slot

        if joined_mesh:
            world = joined_mesh.matrix_world.copy()
            joined_mesh.parent = survivor
            joined_mesh.parent_type = 'OBJECT'
            joined_mesh.parent_bone = ""
            joined_mesh.matrix_world = world
            mod = joined_mesh.modifiers.new("Combined Armature", 'ARMATURE')
            mod.object = survivor
            mod.use_vertex_groups = True
            mod.use_bone_envelopes = False
            for key, value in mod_settings.items():
                try:
                    setattr(mod, key, value)
                except Exception:
                    pass
            move_modifier_first(joined_mesh, mod.name)

        deselect_all()
        survivor.select_set(True)
        if joined_mesh:
            joined_mesh.select_set(True)
        bpy.context.view_layer.objects.active = survivor
        if joined_mesh:
            log("Merge completed. Bone and vertex-group names were not changed. "
                "Thoroughly test deformation, animation, constraints, drivers, "
                "NLA and custom rig controls before production use.")
        else:
            log("Armature-only merge completed (no meshes selected). Bone names "
                "were not changed. Test animation, constraints, drivers and NLA "
                "before production use.")

    except Exception as exc:
        log("STOPPED: " + str(exc))
        if created_action and created_action.name in bpy.data.actions:
            try:
                created_action.use_fake_user = False
                if created_action.users == 0:
                    bpy.data.actions.remove(created_action)
            except Exception:
                pass
        log("If any scene changes occurred, use Ctrl+Z or reopen your backup.")
        raise


if __name__ == "__main__":
    main()
