def v4_slam_shake(master, words, letters):
    n = len(letters); rng = random.Random(7); IMPACT = 13
    # ---- ENTRY (1..30) ----
    key(master, F_START, loc=LOC(up=0.3), scl=SCL(2.8), style=S("QUART", "EASE_IN"))
    key(master, F_START, rot=ROT())
    key(master, IMPACT, loc=LOC(), rot=ROT(), scl=SCL(1.0, up=0.78, side=1.2))
    key(master, IMPACT+3, scl=SCL(1.0, up=1.07, side=0.96))
    key(master, IMPACT+6, scl=SCL(1.0, up=0.97, side=1.02))
    key(master, IMPACT+10, scl=SCL())
    for k, f in enumerate(range(IMPACT+1, F_ENTRY_END-1)):
        decay = 0.72**k
        sx = rng.uniform(0.6, 1.0) * (1 if k % 2 == 0 else -1)
        sz = rng.uniform(0.4, 1.0) * (-1 if k % 3 == 0 else 1)
        key(master, f, loc=LOC(up=0.20*decay*sz, side=0.20*decay*sx),
            rot=ROT(roll=4.0*decay*sx), style=S("LINEAR", "AUTO"))
    key_all(master, F_ENTRY_END)
    # word roots get slammed down with their own offset and overshoot
    for k, w in enumerate(words):
        d = k * 2
        key_all(w, F_START, loc=LOC(up=0.3), scl=SCL(1.2))
        key_all(w, IMPACT + d, loc=LOC(up=-0.08), scl=SCL(1.0, up=0.82, side=1.14), style=S("QUART", "EASE_IN"))
        key_all(w, IMPACT + d + 3, loc=LOC(up=0.0), scl=SCL(1.0, up=1.06, side=0.97))
        key_all(w, IMPACT + d + 8, scl=SCL())
        key_all(w, F_ENTRY_END)
    for i, b in enumerate(letters):
        d = organic_stagger(i, n, 3, 41); a = alt(i)
        key_all(b, F_START, scl=SCL(HIDDEN))
        key_all(b, F_START+d, scl=SCL(HIDDEN), style=S("QUAD", "EASE_OUT"))
        key_all(b, F_START+d+3); key_all(b, IMPACT+d)
        for dt, up, roll in ((3,0.08,9.0),(6,-0.02,-6.0),(9,0.03,3.5),(12,0.0,0.0)):
            key_all(b, IMPACT+d+dt, LOC(up=up), ROT(roll=roll*a))
        key_all(b, F_ENTRY_END)
    # ---- LOOP (31..85) ----
    def master_idle(f):
        u = (f - F_LOOP_START) / float(F_IDLE_END - F_LOOP_START)
        env = math.sin(math.pi * u); j = 0.014 * env
        s = 1.0 + 0.02 * (1.0 - math.cos(2.0*math.pi*3*u))
        return (LOC(up=rng.uniform(-1,1)*j, side=rng.uniform(-1,1)*j),
                ROT(roll=rng.uniform(-1,1)*0.8*env), SCL(s))
    sample(master, F_LOOP_START, F_IDLE_END, 2, master_idle)
    for k, w in enumerate(words):
        def wtremble(f, k=k):
            u = (f - F_LOOP_START) / float(F_IDLE_END - F_LOOP_START)
            env = math.sin(math.pi * u)
            r = random.Random(240 + k * 13)
            return LOC(up=r.uniform(-1,1)*0.02*env), ROT(roll=r.uniform(-1,1)*1.2*env), None
        sample(w, F_LOOP_START, F_IDLE_END, 2, wtremble)
    for i, b in enumerate(letters):
        g = organic_gain(i, 42, 0.7, 1.3)
        def tremble(f, i=i, g=g):
            u = (f - F_LOOP_START) / float(F_IDLE_END - F_LOOP_START)
            env = math.sin(math.pi * u)
            r = random.Random(seed_of(i, 42))
            return (LOC(up=r.uniform(-1,1)*0.012*env*g),
                    ROT(roll=r.uniform(-1,1)*1.6*env*g), None)
        sample(b, F_LOOP_START, F_IDLE_END, 2, tremble)
    # ---- EXIT (86..100) ----
    key_all(master, F_EXIT_START, style=S("QUAD", "EASE_OUT"))
    key_all(master, XF(79), scl=SCL(0.88), style=S("EXPO", "EASE_IN"))
    key_all(master, F_END, scl=SCL(3.6))
    for k, w in enumerate(words):
        key_all(w, F_EXIT_START, style=S("QUAD", "EASE_OUT"))
        key_all(w, XF(79), scl=SCL(0.9), style=S("EXPO", "EASE_IN"))
        key_all(w, F_END, scl=SCL(2.2))
    for i, b in enumerate(letters):
        a = alt(i); key_all(b, F_EXIT_START)
        key(b, XF(79), loc=LOC(), rot=ROT(), scl=SCL(), style=S("EXPO", "EASE_IN"))
        key(b, XF(96), scl=SCL(), style=S("QUAD", "EASE_IN"))
        key(b, F_END, loc=LOC(up=random.Random(seed_of(i, 43)).uniform(-0.5, 0.5)),
            rot=ROT(roll=a*random.Random(seed_of(i, 44)).uniform(25, 60)), scl=SCL(HIDDEN))


