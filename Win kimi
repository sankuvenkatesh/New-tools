# V9 - SCATTER ASSEMBLE
# ============================================================

def v9_scatter_assemble(master, words, letters):
    rng = random.Random(21)
    def far(r_min, r_max):
        ang = rng.uniform(0.0, 2.0*math.pi); r = rng.uniform(r_min, r_max)
        return LOC(up=r*math.sin(ang), side=r*math.cos(ang))
    # ---- ENTRY (1..30) ----
    key_all(master, F_START); key_all(master, 22)
    key_all(master, 25, scl=SCL(1.06)); key_all(master, F_ENTRY_END)
    # word roots drift in from opposite corners, slightly spun
    for k, w in enumerate(words):
        dirn = 1.0 if k == 0 else -1.0
        key_all(w, F_START, loc=LOC(up=0.5, side=0.7*dirn), rot=ROT(roll=18*dirn, yaw=-30*dirn))
        key_all(w, 8 + k*4, loc=LOC(up=-0.03, side=-0.06*dirn), rot=ROT(roll=-4*dirn, yaw=4*dirn),
                style=S("ELASTIC", "EASE_OUT", 0.3))
        key_all(w, F_ENTRY_END, loc=LOC(up=0.0, side=0.0), rot=ROT())
    for i, b in enumerate(letters):
        f0 = F_START + min(8, organic_stagger(i, len(letters), 8, 91, jitter=3)); start = far(1.3, 2.4)
        spun = ROT(pitch=rng.uniform(-70,70), roll=rng.uniform(-200,200))
        key(b, F_START, loc=start); key(b, f0, loc=start, style=S("BACK", "EASE_OUT"))
        key(b, F_ENTRY_END, loc=LOC())
        key(b, F_START, rot=spun)
        key(b, f0, rot=spun, style=S("ELASTIC", "EASE_OUT", 0.3))
        key(b, F_ENTRY_END, rot=ROT())
        key(b, F_START, scl=SCL(HIDDEN))
        key(b, f0, scl=SCL(HIDDEN), style=S("QUAD", "EASE_OUT"))
        key(b, f0+6, scl=SCL()); key(b, F_ENTRY_END, scl=SCL())
    # ---- LOOP (31..85) ----
    key_all(master, F_LOOP_START); key_all(master, F_IDLE_END)
    for k, w in enumerate(words):
        def worbit(f, k=k):
            u = (f - F_LOOP_START) / float(F_IDLE_END - F_LOOP_START)
            env = math.sin(math.pi*u); ang = 2.0*math.pi*u + k * math.pi
            return (LOC(up=0.02*env*math.sin(ang), side=0.02*env*math.cos(ang)),
                    ROT(yaw=1.5*env*math.sin(ang+0.7*k)), None)
        sample(w, F_LOOP_START, F_IDLE_END, 4, worbit)
    for i, b in enumerate(letters):
        ph = rng.uniform(0.0, 2.0*math.pi); a = alt(i)
        def orbit(f, ph=ph, a=a, i=i):
            u = (f - F_LOOP_START) / float(F_IDLE_END - F_LOOP_START)
            env = math.sin(math.pi*u); ang = 2.0*math.pi*2*u + ph
            g = organic_gain(i, 92, 0.7, 1.3)
            return (LOC(up=0.035*env*math.sin(ang)*g, side=0.035*env*math.cos(ang)*g),
                    ROT(roll=2.0*a*env*math.sin(ang+1.0)*g), None)
        sample(b, F_LOOP_START, F_IDLE_END, 3, orbit)
    # ---- EXIT (86..100) ----
    key_all(master, F_EXIT_START); key_all(master, F_END)
    for k, w in enumerate(words):
        dirn = 1.0 if k == 0 else -1.0
        key_all(w, F_EXIT_START, style=S("BACK", "EASE_IN"))
        key_all(w, F_END, loc=LOC(up=1.0, side=0.9*dirn), rot=ROT(roll=-25*dirn))
    for i, b in enumerate(letters):
        f0 = F_EXIT_START + min(XS(6), organic_stagger(i, len(letters), XS(6), 93, jitter=2)); gone = far(1.8, 3.0)
        scatter_rot = ROT(pitch=rng.uniform(-70,70), roll=rng.uniform(-270,270))
        key_all(b, F_EXIT_START)
        key(b, f0, loc=LOC(), style=S("BACK", "EASE_IN")); key(b, F_END, loc=gone)
        key(b, f0, rot=ROT(), style=S("QUAD", "EASE_IN")); key(b, F_END, rot=scatter_rot)
        key(b, f0, scl=SCL(), style=S("QUAD", "EASE_IN")); key(b, F_END, scl=SCL(HIDDEN))


# ============================================================
# V10 - GLITCH FLICKER
# ============================================================

def v10_glitch_flicker(master, words, letters):
    n = len(letters); rng = random.Random(10)
    STEP = S("CONSTANT", "AUTO", 0.0)
    OFF = (REST_LOC, REST_ROT, SCL(HIDDEN))
    def broken(strength):
        return (LOC(side=rng.uniform(-1,1)*0.22*strength, up=rng.uniform(-1,1)*0.06*strength),
                ROT(roll=rng.uniform(-1,1)*6.0*strength),
                SCL(1.0, up=1.0+rng.uniform(-0.25,0.25)*strength,
                    side=1.0+rng.uniform(-0.2,0.6)*strength))
    def put_state(b, f, state):
        loc, rot, scl = state; key(b, f, loc, rot, scl, style=STEP)
    # ---- ENTRY (1..30) ----
    key_all(master, F_START, style=STEP)
    for f in range(2, 26, 2):
        amp = 1.0 - f/26.0
        key(master, f,
            LOC(side=rng.uniform(-1,1)*0.08*amp, up=rng.uniform(-1,1)*0.03*amp),
            ROT(roll=rng.uniform(-1,1)*1.5*amp),
            SCL(1.0+rng.uniform(-0.04,0.06)*amp), style=STEP)
    key_all(master, 26); key_all(master, F_ENTRY_END)
    # word roots glitch in stepped offsets too (scale stays 1 so the letters
    # keep controlling their own visibility)
    for k, w in enumerate(words):
        key_all(w, F_START, style=STEP)
        for f in range(3 + k, 26, 4):
            amp = 1.0 - f/28.0
            key(w, f, LOC(side=rng.uniform(-1,1)*0.06*amp, up=rng.uniform(-1,1)*0.02*amp),
                ROT(roll=rng.uniform(-1,1)*1.0*amp),
                SCL(1.0+rng.uniform(-0.02,0.03)*amp), style=STEP)
        key_all(w, 26); key_all(w, F_ENTRY_END)
    for i, b in enumerate(letters):
        f0 = F_START + organic_stagger(i, n, 8, 101)
        key_all(b, F_START, scl=SCL(HIDDEN), style=STEP)
        for f in range(f0+1, 26, 2):
            prog = (f-f0)/float(26-f0)
            if rng.random() < 0.25 + 0.65*prog: put_state(b, f, broken(1.0-prog))
            else: put_state(b, f, OFF)
        key_all(b, 26); key_all(b, F_ENTRY_END)
    # ---- LOOP (31..85) ----
    for burst in (LF(44), LF(62)):
        key_all(master, burst-1, style=STEP)
        for f in range(burst, burst+4): put_state(master, f, broken(0.25))
        key_all(master, burst+4)
        for w in words:
            if rng.random() < 0.7:
                key_all(w, burst-1, style=STEP)
                for f in range(burst, burst+4): put_state(w, f, broken(0.35))
                key_all(w, burst+4)
        for b in letters:
            if rng.random() < 0.55:
                key_all(b, burst-1, style=STEP)
                for f in range(burst, burst+4):
                    put_state(b, f, OFF if rng.random() < 0.15 else broken(0.7))
                key_all(b, burst+4)
    # ---- EXIT (86..100) ----
    key_all(master, F_EXIT_START, style=STEP)
    for b in letters: key_all(b, F_EXIT_START, style=STEP)
    for w in words: key_all(w, F_EXIT_START, style=STEP)
    for f in range(F_EXIT_START+1, F_END-1, 2):
        amp = (f - F_EXIT_START)/float(F_END - F_EXIT_START)
        key(master, f,
            LOC(side=rng.uniform(-1,1)*0.10*amp, up=rng.uniform(-1,1)*0.04*amp),
            ROT(roll=rng.uniform(-1,1)*2.0*amp),
            SCL(1.0+rng.uniform(-0.04,0.08)*amp), style=STEP)
    key_all(master, F_END)
    for w in words:
        for f in range(F_EXIT_START+2, F_END-1, 4):
            amp = (f - F_EXIT_START)/float(F_END - F_EXIT_START)
            key(w, f, LOC(side=rng.uniform(-1,1)*0.07*amp, up=rng.uniform(-1,1)*0.03*amp),
                ROT(roll=rng.uniform(-1,1)*1.4*amp), SCL(), style=STEP)
        key_all(w, F_END)
    for i, b in enumerate(letters):
        f0 = F_EXIT_START + 1 + organic_stagger(i, n, XS(6), 103)
        for f in range(f0, F_END-2, 2):
            prog = (f-f0)/float(F_END-f0)
            if rng.random() < 0.2 + 0.7*prog: put_state(b, f, OFF)
            else: put_state(b, f, broken(0.4 + 0.6*prog))
        put_state(b, F_END-2, OFF); key_all(b, F_END, scl=SCL(HIDDEN))


