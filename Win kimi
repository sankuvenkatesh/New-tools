            elif built > 0:
                row.label(text=f"{built}/{rig_total}")
            else:
                row.label(text="", icon=_icon('BLANK1'))

            row2 = box.row(align=True)
            op = row2.operator("win_anim.apply", text="Apply", icon=_icon('PLAY'))
            op.variation = i
            op2 = row2.operator("win_anim.build_one", text="Build", icon=_icon('FILE_REFRESH'))
            op2.variation = i
            box.label(text=VARIATION_DESCRIPTIONS.get(i, ""), icon=_icon('INFO'))


