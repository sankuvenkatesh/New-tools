MASTER_NAME = "GLOBAL_MASTER"
WORD_SUFFIX = "_ROOT"    # word parent bones: MASSIVE_ROOT / WIN_ROOT ...


# ============================================================
# TIMING HELPERS
# The loop / exit timings of the variations were written for an idle of 45 frames
# (30..75) and an exit of 25 frames (75..100). These map them onto the new layout.
# ============================================================

def LF(old_frame):
    """Position inside the LOOP (31..85) of an event that used to sit at old_frame (30..75)."""
    return F_LOOP_START + int(round((old_frame - 30) * (F_IDLE_END - F_LOOP_START) / 45.0))


def XF(old_frame):
    """Position inside the EXIT (86..100) of an event that used to sit at old_frame (75..100)."""
    return F_EXIT_START + int(round((old_frame - 75) * (F_END - F_EXIT_START) / 25.0))


def XS(frames):
    """A stagger / duration that was written for the old 25-frame exit."""
    if not frames:
        return 0
    return max(1, int(round(frames * (F_END - F_EXIT_START) / 25.0)))


# ============================================================
# HELPERS
# All vectors are written in "logical" order: (side, depth, up) = world (X, Y, Z).
# key() converts them to the pose-bone channels of every bone.
# ============================================================

def LOC(up=0.0, side=0.0, depth=0.0):
    return (side, depth, up)


def ROT(pitch=0.0, roll=0.0, yaw=0.0):
    # pitch = around the side axis (X), roll = around the depth axis (Y), yaw = around the up axis (Z)
    return (math.radians(pitch), math.radians(roll), math.radians(yaw))


def SCL(s=1.0, up=1.0, side=1.0, depth=None):
    if depth is None:
        depth = side
    return (s * side, s * depth, s * up)


REST_LOC, REST_ROT, REST_SCL = LOC(), ROT(), SCL()
SMOOTH = ("BEZIER", "AUTO", 0.0)


def S(interp, ease="EASE_OUT", period=0.4):
    return (interp, ease, period)


# ============================================================
# ORGANIC MOTION HELPERS
# The 1.x animations looked "pure math" because every letter followed the same
# sine with an evenly spaced phase and a perfectly regular stagger. These helpers
# keep every motion LOOP-SAFE (frame f0 and f1 are always identical) while giving
# each bone its own slightly irregular timing and shape.
# ============================================================

def seed_of(i, base):
    """A deterministic, unique seed for letter i of a variation family."""
    return base * 1000 + i * 37


def organic(f, f0, f1, seed, cycles=2, amp=1.0):
    """Loop-safe organic oscillation.
    A sum of integer harmonics (1x / 2x / 3x the base cycles) with random phases
    and amplitudes, windowed by sin(pi*u) so the value is EXACTLY 0 at both ends
    of the interval - frame f0 and f1 always get the identical rest value.
    Looks alive instead of a pure sine, but never drifts and never pops at the
    loop point."""
    rnd = random.Random(seed)
    u = (f - f0) / float(f1 - f0)
    env = math.sin(math.pi * u)
    v = 0.0
    for cyc, share in ((1, 1.0), (2, 0.38), (3, 0.16)):
        ph = rnd.uniform(0.0, 2.0 * math.pi)
        a = share * rnd.uniform(0.55, 1.45)
        v += a * math.sin(2.0 * math.pi * cyc * cycles * u + ph)
    return amp * env * v / 1.54


def organic_stagger(i, n, frames, seed, jitter=2, reverse=False):
    """Even stagger + a small deterministic jitter, clamped into 0..frames."""
    base = stagger(i, n, frames, reverse)
    r = random.Random(seed * 131 + i * 17)
    j = r.randint(0, jitter) * r.choice((-1, 1))
    return max(0, min(int(frames), base + j))


def organic_gain(i, seed, lo=0.75, hi=1.25):
    """A deterministic per-letter gain, so no two letters move with identical strength."""
    return random.Random(seed_of(i, seed)).uniform(lo, hi)


# ============================================================
# EXACT AXIS CONVERSION  (pure Python 3x3 math, M[row][col])
# ============================================================

def _mm(a, b):
    return [[sum(a[i][k] * b[k][j] for k in range(3)) for j in range(3)] for i in range(3)]


def _mt(a):
    return [[a[j][i] for j in range(3)] for i in range(3)]


def _mv(a, v):
    return [sum(a[i][k] * v[k] for k in range(3)) for i in range(3)]


def _det3(a):
    return (a[0][0] * (a[1][1] * a[2][2] - a[1][2] * a[2][1])
            - a[0][1] * (a[1][0] * a[2][2] - a[1][2] * a[2][0])
            + a[0][2] * (a[1][0] * a[2][1] - a[1][1] * a[2][0]))


def _rx(a):
    c, s = math.cos(a), math.sin(a)
    return [[1.0, 0.0, 0.0], [0.0, c, -s], [0.0, s, c]]


def _ry(a):
    c, s = math.cos(a), math.sin(a)
    return [[c, 0.0, s], [0.0, 1.0, 0.0], [-s, 0.0, c]]


def _rz(a):
    c, s = math.cos(a), math.sin(a)
    return [[c, -s, 0.0], [s, c, 0.0], [0.0, 0.0, 1.0]]


def _euler_to_mat(e):
    """Blender 'XYZ' Euler (X is applied first, then Y, then Z) -> Rz * Ry * Rx."""
    return _mm(_rz(e[2]), _mm(_ry(e[1]), _rx(e[0])))


_TWO_PI = 2.0 * math.pi


def _near(angle, ref):
    """angle + k * 360 deg, choosing k so the result is as close as possible to ref."""
    return angle + _TWO_PI * round((ref - angle) / _TWO_PI)


def _mat_to_euler_near(M, ref):
    """'XYZ' Euler angles of the rotation matrix M that are closest to `ref`.
    Both Euler solutions are tried and every angle is shifted by whole turns, so the
    winding the animator asked for (360 / 540 degree spins ...) is kept."""
    cy = math.hypot(M[0][0], M[1][0])
    cands = []
    if cy > 1e-8:
        cands.append((math.atan2(M[2][1], M[2][2]),
                      math.atan2(-M[2][0], cy),
                      math.atan2(M[1][0], M[0][0])))
        cands.append((math.atan2(-M[2][1], -M[2][2]),
                      math.atan2(-M[2][0], -cy),
                      math.atan2(-M[1][0], -M[0][0])))
    else:
        # gimbal lock (y = +-90 deg): only x -/+ z is defined, keep z of the reference
        y = math.copysign(math.pi / 2.0, -M[2][0])
        z = ref[2]
        xb = math.atan2(-M[1][2], M[1][1])
        cands.append((xb + z if y > 0.0 else xb - z, y, z))
    best, best_d = None, None
    for c in cands:
        t = tuple(_near(c[i], ref[i]) for i in range(3))
        d = sum((t[i] - ref[i]) ** 2 for i in range(3))
        if best is None or d < best_d:
            best, best_d = t, d
    return best


def _snap(vec, one=False):
    """Remove float noise (1e-17 ...) so rest poses are exactly 0 / 1."""
    base = 1.0 if one else 0.0
    return tuple((base if abs(c - base) < 1e-12 else c) + 0.0 for c in vec)


def _clean_axis_value(x):
    if abs(x) < 1e-9:
        return 0.0
    if abs(abs(x) - 1.0) < 1e-9:
        return math.copysign(1.0, x)
    return x


# Everything the builders "key" is collected here first and written to the
# Action in one go afterwards (see write_action).
TRACK = {}    # (bone name, property) -> {frame: ((x, y, z), style)}
AXINFO = {}   # bone name -> axis information (see _bone_frame / _manual_info)


def _manual_info():
    return {"auto": False,
            "loc": ((AX_SIDE, 1.0), (AX_DEPTH, 1.0), (AX_UP, 1.0)),
            "rot": ((ROT_PITCH, 1.0), (ROT_ROLL, 1.0), (ROT_YAW, 1.0))}


def _manual_convert(vec, amap, scale=False):
    out = [1.0, 1.0, 1.0] if scale else [0.0, 0.0, 0.0]
    for k in range(3):
        out[amap[k][0]] = vec[k]
    return tuple(out)


def _bone_frame(armature, pb):
    """Orientation of a pose bone in the world.
    A    : 3x3 matrix whose columns are the bone's local X/Y/Z axes in world space
           (orthonormal: a rotation, or a rotation + mirror)
    perm : which bone axis (index, sign) lies along world X (side), Y (depth), Z (up)
    det  : +1 for a rotation, -1 for a mirrored frame
    Returns None when the frame is sheared or not lined up with the world axes."""
    try:
        mw = armature.matrix_world
        ml = pb.bone.matrix_local
        cols, lens = [], []
        for j in range(3):
            a = [ml[r][j] for r in range(3)]
            w = [mw[r][0] * a[0] + mw[r][1] * a[1] + mw[r][2] * a[2] for r in range(3)]
            ln = math.sqrt(w[0] * w[0] + w[1] * w[1] + w[2] * w[2])
            if ln < 1e-9:
                return None
            cols.append([c / ln for c in w])
            lens.append(ln)
        A = [[_clean_axis_value(cols[j][r]) for j in range(3)] for r in range(3)]
        G = _mm(_mt(A), A)
        if max(abs(G[i][j] - (1.0 if i == j else 0.0)) for i in range(3) for j in range(3)) > 1e-3:
            return None                                   # sheared / non-uniform scale
        perm, used = [], set()
        for k in range(3):                                # world X, Y, Z
            best, score = None, 0.0
            for j in range(3):
                if j not in used and abs(A[k][j]) > score:
                    best, score = j, abs(A[k][j])
            if best is None or score < 0.85:
                return None
            used.add(best)
            perm.append((best, 1.0 if A[k][best] > 0.0 else -1.0))
        # exact: the bone axes lie exactly on the world axes (a signed permutation matrix)
        exact = all(abs(A[k][j] - (perm[k][1] if j == perm[k][0] else 0.0)) < 1e-9
                    for k in range(3) for j in range(3))
        return {"auto": True, "A": A, "At": _mt(A), "perm": tuple(perm), "exact": exact,
                "det": 1.0 if _det3(A) > 0.0 else -1.0, "sidelen": lens[perm[0][0]]}
    except Exception as err:
        print("WARNING bone frame:", err)
        return None


def _loc_to_local(info, v):
    """World-aligned displacement (side, depth, up) -> pose-bone location:  t = A^T * v."""
    if not info["auto"]:
        return _snap(_manual_convert(v, info["loc"]))
    return _snap(_mv(info["At"], v))


def _scl_to_local(info, v):
    """Scale along the world axes -> scale along the bone axes that lie on them."""
    if not info["auto"]:
        return _snap(_manual_convert(v, info["loc"], True), True)
    out = [1.0, 1.0, 1.0]
    for k in range(3):
        out[info["perm"][k][0]] = v[k]
    return _snap(out, True)


def _rot_to_local(info, v):
    """World-axis rotation (pitch about X, roll about Y, yaw about Z; Euler XYZ) ->
    pose-bone 'XYZ' Euler:   R_bone = A^T * R_world * A,  then back to Euler angles."""
    if not info["auto"]:
        return _snap(_manual_convert(v, info["rot"]))
    nonzero = sum(1 for c in v if abs(c) > 1e-12)
    if nonzero == 0:
        return (0.0, 0.0, 0.0)
    ref = [0.0, 0.0, 0.0]
    for k in range(3):
        j, sgn = info["perm"][k]
        ref[j] = sgn * info["det"] * v[k]        # exact for a single-axis rotation on aligned bones
    if nonzero == 1 and info["exact"]:
        return _snap(ref)
    Rw = _euler_to_mat(v)
    Rb = _mm(info["At"], _mm(Rw, info["A"]))
    return _snap(_mat_to_euler_near(Rb, ref))


def _record(bone_name, prop, frame, vec, style):
    TRACK.setdefault((bone_name, prop), {})[frame] = (vec, style)


def key(bone, frame, loc=None, rot=None, scl=None, style=SMOOTH):
    frame = int(round(frame))
    info = AXINFO.get(bone.name)
    if info is None:
        info = _manual_info()
    if loc is not None:
        _record(bone.name, "location", frame, _loc_to_local(info, loc), style)
    if rot is not None:
        _record(bone.name, "rotation_euler", frame, _rot_to_local(info, rot), style)
    if scl is not None:
        _record(bone.name, "scale", frame, _scl_to_local(info, scl), style)


def key_all(bone, frame, loc=None, rot=None, scl=None, style=SMOOTH):
    key(bone, frame,
        REST_LOC if loc is None else loc,
        REST_ROT if rot is None else rot,
        REST_SCL if scl is None else scl, style)


def ensure_boundaries(bones):
    """Every channel of every bone gets a key (rest pose) on the four clip borders
    30 / 31 / 85 / 86 unless the variation already keyed that frame itself. This makes
    entry-end, loop-start, loop-end and exit-start identical and explicit."""
    for b in bones:
        for prop, rest in (("location", (0.0, 0.0, 0.0)),
                           ("rotation_euler", (0.0, 0.0, 0.0)),
                           ("scale", (1.0, 1.0, 1.0))):
            frames = TRACK.setdefault((b.name, prop), {})
            for f in (F_ENTRY_END, F_LOOP_START, F_IDLE_END, F_EXIT_START):
                frames.setdefault(f, (rest, SMOOTH))


def sample(bone, f0, f1, step, fn, style=SMOOTH):
    for f in list(range(f0, f1, step)) + [f1]:
        loc, rot, scl = fn(f)
        key(bone, f, loc, rot, scl, style)


def swing(f, f0, f1, cycles, phase=0.0):
    u = (f - f0) / float(f1 - f0)
    return math.sin(2.0 * math.pi * cycles * u - phase) * math.sin(math.pi * u)


def tpos(i, n):
    return i / float(n - 1) if n > 1 else 0.0


def stagger(i, n, frames, reverse=False):
    t = tpos(i, n)
    if reverse:
        t = 1.0 - t
    return int(round(t * frames))


def alt(i):
    return -1.0 if i % 2 else 1.0


# ============================================================
# LETTER / WORD POSITION CONTEXT
# ============================================================

CTX = {"wx": {}, "wc": {}, "k": {}, "center": 0.0, "span": 0.0}


def _world_x(mw, h):
    return mw[0][0] * h[0] + mw[0][1] * h[1] + mw[0][2] * h[2] + mw[0][3]


def prepare_context(armature, letters, master=None, words=None, auto_axes=True):
    CTX["wx"], CTX["wc"], CTX["k"], CTX["center"], CTX["span"] = {}, {}, {}, 0.0, 0.0
    AXINFO.clear()
    words = list(words or [])
    for pb in ([master] if master is not None else []) + words + list(letters):
        fr = _bone_frame(armature, pb) if auto_axes else None
        AXINFO[pb.name] = fr if fr is not None else _manual_info()
    try:
        mw = armature.matrix_world
        for pb in letters:
            h = pb.bone.head_local
            CTX["wx"][pb.name] = _world_x(mw, h)
            # the word row this letter belongs to = the world X of its parent word root
            par = pb.parent
            if par is not None and par.name.endswith(WORD_SUFFIX):
                CTX["wc"][pb.name] = _world_x(mw, par.bone.head_local)
            info = AXINFO[pb.name]
            if info["auto"]:
                # world distance -> armature units (the sign is handled by the axis conversion)
                CTX["k"][pb.name] = 1.0 / info["sidelen"] if info["sidelen"] > 1e-9 else 1.0
            else:
                ml = pb.bone.matrix_local
                axis = [ml[r][AX_SIDE] for r in range(3)]      # bone axis that carries "side"
                dir_x = mw[0][0] * axis[0] + mw[0][1] * axis[1] + mw[0][2] * axis[2]
                CTX["k"][pb.name] = 1.0 / dir_x if abs(dir_x) > 1e-6 else 1.0
        xs = list(CTX["wx"].values())
        CTX["center"] = (min(xs) + max(xs)) / 2.0
        CTX["span"] = max(xs) - min(xs)
    except Exception as err:
        print("WARNING prepare_context:", err)


def side_by(b, dx_world):
    return dx_world * CTX["k"].get(b.name, 1.0)


def letter_offset(b, i, n):
    """Offset of the letter from the center of ITS OWN WORD ROW (so variations like
    V12 fan each word around its own middle, not around the middle of both rows)."""
    if b.name in CTX["wx"]:
        wc = CTX["wc"].get(b.name, CTX["center"])
        return CTX["wx"][b.name] - wc
    return (i - (n - 1) / 2.0) * 0.5


# ============================================================
# FIND BONES
# ============================================================

def _bone_sort_key(armature, pb):
    """Reading order: the TOP row first, inside a row left to right (-Z then +X)."""
    try:
        m = armature.matrix_world
        h = pb.bone.head_local
        wx = _world_x(m, h)
        wz = m[2][0] * h[0] + m[2][1] * h[1] + m[2][2] * h[2] + m[2][3]
        return (-wz, wx)
    except Exception:
        return (0.0, 0.0)


def get_master_bone(armature):
    return armature.pose.bones.get(MASTER_NAME)


def get_word_bones(armature):
    """The word parent bones (MASSIVE_ROOT on top, WIN_ROOT below ...)."""
    result = [pb for pb in armature.pose.bones if pb.name.endswith(WORD_SUFFIX)]
    if SORT_LEFT_TO_RIGHT and len(result) > 1:
        try:
            result.sort(key=lambda pb: _bone_sort_key(armature, pb))
        except Exception as err:
            print("WARNING sort:", err)
    return result


def get_letter_bones(armature):
    result = []
    for bone in armature.pose.bones:
        if bone.name == MASTER_NAME:
            continue
        if bone.name.endswith(WORD_SUFFIX):
            continue
        if bone.name.endswith("_BONE"):
            result.append(bone)
    if SORT_LEFT_TO_RIGHT and len(result) > 1:
        try:
            result.sort(key=lambda pb: _bone_sort_key(armature, pb))
        except Exception as err:
            print("WARNING sort:", err)
    return result


def group_by_word(words, letters):
    """{word bone: [its letter bones]} - letters whose parent is not a known word
    root fall back to the first word."""
    out = {w: [] for w in words}
    if not words:
        return out
    for b in letters:
        par = b.parent
        target = out.get(par) if par is not None else None
        (target if target is not None else out[words[0]]).append(b)
    return out


# ============================================================
# V1 - ELASTIC POP
# ============================================================

def v1_elastic_pop(master, words, letters):
    n = len(letters)
    w0 = words[0]
    w1 = words[-1] if len(words) > 1 else words[0]
    # ---- ENTRY (1..30) ----
    key_all(master, F_START, scl=SCL(0.88), style=S("QUAD", "EASE_OUT"))
    key_all(master, 18, scl=SCL(1.05))
    key_all(master, F_ENTRY_END)
    # word roots: the TOP word pops in first, the bottom word lands a beat later
    key_all(w0, F_START, loc=LOC(up=0.22), scl=SCL(0.85))
    key_all(w0, 6, loc=LOC(up=-0.04), scl=SCL(1.06), style=S("ELASTIC", "EASE_OUT", 0.4))
    key_all(w0, 14, loc=LOC(up=0.0), scl=SCL(1.0))
    key_all(w1, F_START, loc=LOC(up=0.22), scl=SCL(0.85))
    key_all(w1, 12, loc=LOC(up=-0.04), scl=SCL(1.06), style=S("ELASTIC", "EASE_OUT", 0.4))
    key_all(w1, F_ENTRY_END, loc=LOC(up=0.0), scl=SCL(1.0))
    for i, b in enumerate(letters):
        f0 = F_START + organic_stagger(i, n, 8, 11)
        low, tilt, gone = LOC(up=-0.35), ROT(roll=25*alt(i)), SCL(HIDDEN)
        key_all(b, F_START, low, tilt, gone)
        key_all(b, f0, low, tilt, gone, style=S("ELASTIC", "EASE_OUT", 0.4))
        key_all(b, F_ENTRY_END)
    # ---- LOOP (31..85) ----
    # irregular heartbeat (the beats no longer sit on a perfect grid)
    beat = [(30,1.00),(34,1.07),(38,0.99),(41,1.05),(46,1.00),
            (52,1.01),(56,1.065),(60,0.995),(63,1.035),(68,1.0),(75,1.0)]
    for f, s in beat: key_all(master, LF(f), scl=SCL(s))
    # word roots sway slowly and independently, letters breathe organically
    for k, w in enumerate(words):
        def wsway(f, k=k):
            o = organic(f, F_LOOP_START, F_IDLE_END, 201 + k * 7, cycles=1, amp=1.0)
