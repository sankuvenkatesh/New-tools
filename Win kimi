# V11 - DOMINO FLIP
# ============================================================

def v11_domino_flip(master, words, letters):
    n = len(letters)
    # ---- ENTRY (1..30) ----
    key_all(master, F_START); key_all(master, F_ENTRY_END)
    # word roots rock back and snap upright as their letters stand up
    for k, w in enumerate(words):
        dirn = 1.0 if k == 0 else -1.0
        key_all(w, F_START, rot=ROT(pitch=-14*dirn))
        key_all(w, 14 + k*6, rot=ROT(pitch=4*dirn), style=S("BACK", "EASE_OUT"))
        key_all(w, F_ENTRY_END, rot=ROT())
    for i, b in enumerate(letters):
        f0 = F_START + organic_stagger(i, n, 12, 111); flat = ROT(pitch=-90)
        key(b, F_START, rot=flat); key(b, f0, rot=flat, style=S("BACK", "EASE_OUT"))
        key(b, F_ENTRY_END, rot=ROT())
        key(b, F_START, loc=LOC(up=-0.15))
        key(b, f0, loc=LOC(up=-0.15), style=S("BACK", "EASE_OUT"))
        key(b, F_ENTRY_END, loc=LOC())
        key(b, F_START, scl=SCL(HIDDEN))
        key(b, f0, scl=SCL(HIDDEN), style=S("QUAD", "EASE_OUT"))
        key(b, f0+3, scl=SCL()); key(b, F_ENTRY_END, scl=SCL())
    # ---- LOOP (31..85) ----
    key_all(master, F_LOOP_START); key_all(master, F_IDLE_END)
    for k, w in enumerate(words):
        def wrock(f, k=k):
            o = organic(f, F_LOOP_START, F_IDLE_END, 291 + k * 7, cycles=1, amp=1.0)
            return None, ROT(pitch=1.5*o), None
        sample(w, F_LOOP_START, F_IDLE_END, 4, wrock)
    # two domino ripples per row with jittered per-letter timing
    for i, b in enumerate(letters):
        t = tpos(i, n)
        r = random.Random(seed_of(i, 112))
        j1, j2 = r.randint(-2, 2), r.randint(-2, 2)
        s1 = F_LOOP_START + 2 + int(round(t*14)) + j1
        s2 = F_LOOP_START + 31 + int(round((1.0-t)*12)) + j2
        key_all(b, F_LOOP_START); key_all(b, s1, style=S("QUAD", "EASE_IN"))
        key_all(b, s1+4, LOC(up=-0.02), ROT(pitch=14), style=S("BACK", "EASE_OUT"))
        key_all(b, s1+10); key_all(b, s2, style=S("QUAD", "EASE_IN"))
        key_all(b, s2+4, LOC(up=-0.02), ROT(pitch=-12), style=S("BACK", "EASE_OUT"))
        key_all(b, s2+9); key_all(b, F_IDLE_END)
    # ---- EXIT (86..100) ----
    key_all(master, F_EXIT_START); key_all(master, F_END)
    for k, w in enumerate(words):
        dirn = 1.0 if k == 0 else -1.0
        key_all(w, F_EXIT_START)
        key_all(w, F_EXIT_START + XS(4) + k*XS(2), rot=ROT(pitch=10*dirn), style=S("QUAD", "EASE_IN"))
        key_all(w, F_END, rot=ROT(pitch=55*dirn), loc=LOC(up=-0.5))
    for i, b in enumerate(letters):
        f0 = F_EXIT_START + organic_stagger(i, n, XS(8), 113); fl = f0 + XS(10)
        key_all(b, F_EXIT_START)
        key(b, f0, rot=ROT(), style=S("BACK", "EASE_IN"))
        key(b, fl, rot=ROT(pitch=90)); key(b, F_END, rot=ROT(pitch=90))
        key(b, f0, loc=LOC(), style=S("QUAD", "EASE_IN"))
        key(b, fl, loc=LOC(up=-0.15)); key(b, F_END, loc=LOC(up=-0.15))
        key(b, fl, scl=SCL(), style=S("QUAD", "EASE_IN"))
        key(b, F_END, scl=SCL(HIDDEN))


