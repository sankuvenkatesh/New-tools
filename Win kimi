# V12 - ACCORDION SPREAD
# ============================================================

def v12_accordion_spread(master, words, letters):
    n = len(letters)
    off = {b.name: letter_offset(b, i, n) for i, b in enumerate(letters)}
    # ---- ENTRY (1..30) ----
    key_all(master, F_START, scl=SCL(0.9), style=S("BACK", "EASE_OUT"))
    key_all(master, F_ENTRY_END)
    # each word row fans out from its own middle
    for k, w in enumerate(words):
        key_all(w, F_START, scl=SCL(0.92))
        key_all(w, 6 + k*4, scl=SCL(1.05), style=S("BACK", "EASE_OUT"))
        key_all(w, F_ENTRY_END, scl=SCL())
    for i, b in enumerate(letters):
        s = 2.0*tpos(i, n) - 1.0
        f0 = F_START + int(round(abs(s)*6))
        packed = LOC(side=side_by(b, -off[b.name])); fan = ROT(roll=30*s)
        key(b, F_START, loc=packed, rot=fan)
        key(b, f0, loc=packed, rot=fan, style=S("BACK", "EASE_OUT"))
        key(b, F_ENTRY_END, loc=LOC(), rot=ROT())
        key(b, F_START, scl=SCL(HIDDEN))
        key(b, f0, scl=SCL(HIDDEN), style=S("QUAD", "EASE_OUT"))
        key(b, f0+4, scl=SCL()); key(b, F_ENTRY_END, scl=SCL())
    # ---- LOOP (31..85) ----
    key_all(master, F_LOOP_START); key_all(master, F_IDLE_END)
    # the two word rows breathe out of phase, like a real accordion
    for k, w in enumerate(words):
        def wbreathe(f, k=k):
            o = organic(f, F_LOOP_START, F_IDLE_END, 301 + k * 7, cycles=1, amp=1.0)
            sgn = 1.0 if k == 0 else -1.0
            return None, None, SCL(1.0 + 0.025*sgn*o)
        sample(w, F_LOOP_START, F_IDLE_END, 3, wbreathe)
    for i, b in enumerate(letters):
        s = 2.0*tpos(i, n) - 1.0; o = off[b.name]
        g = organic_gain(i, 122, 0.75, 1.25)
        def breathe(f, b=b, s=s, o=o, i=i, g=g):
            w = organic(f, F_LOOP_START, F_IDLE_END, seed_of(i, 121), cycles=2, amp=1.0)
            return (LOC(side=side_by(b, o*0.07*w*g), up=0.02*(1.0-abs(s))*w*w*g),
                    ROT(roll=3.0*s*w*g), SCL(1.0+0.02*w*g))
        sample(b, F_LOOP_START, F_IDLE_END, 2, breathe)
    # ---- EXIT (86..100) ----
    key_all(master, F_EXIT_START, style=S("QUAD", "EASE_IN"))
    key_all(master, F_END, scl=SCL(0.85))
    for k, w in enumerate(words):
        key_all(w, F_EXIT_START, style=S("QUAD", "EASE_IN"))
        key_all(w, F_EXIT_START + XS(3) + k*XS(2), scl=SCL(0.9), style=S("BACK", "EASE_IN"))
        key_all(w, F_END, scl=SCL(0.7))
    for i, b in enumerate(letters):
        s = 2.0*tpos(i, n) - 1.0
        f0 = F_EXIT_START + int(round((1.0-abs(s))*XS(6)))
        key_all(b, F_EXIT_START)
        key(b, f0, loc=LOC(), style=S("BACK", "EASE_IN"))
        key(b, F_END, loc=LOC(side=side_by(b, -off[b.name])))
        key(b, f0, rot=ROT(), style=S("QUAD", "EASE_IN"))
        key(b, F_END, rot=ROT(roll=-30*s))
        key(b, f0, scl=SCL(), style=S("QUAD", "EASE_IN"))
        key(b, F_END, scl=SCL(HIDDEN))


