# V7 - JELLY WOBBLE
# ============================================================

def v7_jelly_wobble(master, words, letters):
    n = len(letters)
    # ---- ENTRY (1..30) ----
    key_all(master, F_START, scl=SCL(0.9), style=S("BACK", "EASE_OUT"))
    key_all(master, F_ENTRY_END)
    # word roots plop down as blobs (top word first)
    for k, w in enumerate(words):
        d = k * 4
        key_all(w, F_START, loc=LOC(up=0.2), scl=SCL(1.0, up=0.6, side=1.35))
        key_all(w, 4 + d, loc=LOC(up=-0.06), scl=SCL(1.0, up=0.8, side=1.15), style=S("ELASTIC", "EASE_OUT", 0.35))
        key_all(w, 12 + d, loc=LOC(up=0.0), scl=SCL(1.0, up=1.05, side=0.98))
        key_all(w, F_ENTRY_END, scl=SCL())
    for i, b in enumerate(letters):
        f0 = F_START + organic_stagger(i, n, 8, 71)
        low, tilt = LOC(up=-0.25), ROT(roll=10*alt(i))
        blob = SCL(1.0, up=0.25, side=1.6)
        key(b, F_START, loc=low, rot=tilt)
        key(b, f0+2, loc=low, rot=tilt, style=S("ELASTIC", "EASE_OUT", 0.35))
        key(b, F_ENTRY_END, loc=LOC(), rot=ROT())
        key(b, F_START, scl=SCL(HIDDEN))
        key(b, f0, scl=SCL(HIDDEN), style=S("QUAD", "EASE_OUT"))
        key(b, f0+2, scl=blob, style=S("ELASTIC", "EASE_OUT", 0.35))
        key(b, F_ENTRY_END, scl=SCL())
    # ---- LOOP (31..85) ----
    key_all(master, F_LOOP_START, style=S("SINE", "EASE_IN_OUT"))
    key_all(master, LF(52), scl=SCL(1.0, up=1.04, side=0.98), style=S("SINE", "EASE_IN_OUT"))
    key_all(master, F_IDLE_END)
    for k, w in enumerate(words):
        def wjelly(f, k=k):
            o = organic(f, F_LOOP_START, F_IDLE_END, 271 + k * 7, cycles=1, amp=1.0)
            return LOC(up=0.02*o), ROT(roll=1.2*o), SCL(1.0, up=1.0+0.05*o, side=1.0-0.03*o)
        sample(w, F_LOOP_START, F_IDLE_END, 3, wjelly)
    for i, b in enumerate(letters):
        g = organic_gain(i, 72, 0.7, 1.3)
        def jelly(f, i=i, g=g):
            o = organic(f, F_LOOP_START, F_IDLE_END, seed_of(i, 72), cycles=2, amp=1.0)
            return (LOC(up=0.025*o*g), ROT(roll=2.0*o*g),
                    SCL(1.0, up=1.0+0.09*o*g, side=1.0-0.06*o*g))
        sample(b, F_LOOP_START, F_IDLE_END, 2, jelly)
    # ---- EXIT (86..100) ----
    key_all(master, F_EXIT_START); key_all(master, F_END)
    for k, w in enumerate(words):
        key_all(w, F_EXIT_START)
        key_all(w, F_EXIT_START + XS(2) + k*XS(2), scl=SCL(1.0, up=0.8, side=1.12), style=S("QUAD", "EASE_IN"))
        key_all(w, F_END, loc=LOC(up=1.5), scl=SCL(HIDDEN))
    for i, b in enumerate(letters):
        f0 = F_EXIT_START + organic_stagger(i, n, XS(6), 75, reverse=True); a = alt(i)
        key_all(b, F_EXIT_START); key_all(b, f0, style=S("QUAD", "EASE_OUT"))
        key_all(b, f0+XS(4), LOC(up=-0.05), ROT(roll=-4*a), SCL(1.0, up=0.55, side=1.30), style=S("QUAD", "EASE_IN"))
        key_all(b, f0+XS(8), LOC(up=0.35), ROT(roll=6*a), SCL(1.0, up=1.50, side=0.75), style=S("QUAD", "EASE_IN"))
        key_all(b, F_END, LOC(up=1.2), ROT(roll=-10*a), SCL(HIDDEN))


# ============================================================
# V8 - SPIN ZOOM
# ============================================================

def v8_spin_zoom(master, words, letters):
    n = len(letters)
    # ---- ENTRY (1..30) ----
    key(master, F_START, scl=SCL(HIDDEN), style=S("BACK", "EASE_OUT"))
    key(master, 24, scl=SCL()); key(master, F_ENTRY_END, scl=SCL())
    key(master, F_START, rot=ROT(roll=540), style=S("EXPO", "EASE_OUT"))
    key(master, 24, rot=ROT()); key(master, F_ENTRY_END, rot=ROT())
    key(master, F_START, loc=LOC(up=-0.4), style=S("QUAD", "EASE_OUT"))
    key(master, 24, loc=LOC()); key(master, F_ENTRY_END, loc=LOC())
    # word roots appear with a counter scale-pop BEFORE the letters glow
    # (they must be visible by frame ~5 - the first letters pop in at ~5-10)
    for k, w in enumerate(words):
        key_all(w, F_START, scl=SCL(HIDDEN))
        key_all(w, 5 + k*2, scl=SCL(HIDDEN), style=S("QUAD", "EASE_OUT"))
        key_all(w, 10 + k*3, scl=SCL(1.0, up=1.06, side=0.97))
        key_all(w, 20 + k*2, scl=SCL())
        key_all(w, F_ENTRY_END)
    for i, b in enumerate(letters):
        d = organic_stagger(i, n, 4, 81); dr = organic_stagger(i, n, 6, 82); a = alt(i)
        key_all(b, F_START, scl=SCL(HIDDEN))
        key_all(b, F_START+d, scl=SCL(HIDDEN), style=S("QUAD", "EASE_OUT"))
        key_all(b, F_START+d+4)
        key(b, 12+dr, rot=ROT(roll=16*a), style=S("ELASTIC", "EASE_OUT", 0.3))
        key_all(b, F_ENTRY_END)
    # ---- LOOP (31..85) ----
    def sway(f):
        w = organic(f, F_LOOP_START, F_IDLE_END, 281, cycles=2, amp=1.0)
        return LOC(up=0.03*w), ROT(roll=1.8*w), SCL(1.0+0.025*w*w)
    sample(master, F_LOOP_START, F_IDLE_END, 3, sway)
    for k, w in enumerate(words):
        def wshine(f, k=k):
            o = organic(f, F_LOOP_START, F_IDLE_END, 282 + k * 7, cycles=1, amp=1.0)
            return None, ROT(roll=1.0*o), SCL(1.0 + 0.03*o)
        sample(w, F_LOOP_START, F_IDLE_END, 4, wshine)
    # shine sweeps travel across each word row with jittered timing
    for i, b in enumerate(letters):
        a = alt(i); t = tpos(i, n); key_all(b, F_LOOP_START)
        r = random.Random(seed_of(i, 83))
        j1, j2 = r.randint(-2, 2), r.randint(-2, 2)
        for start in (F_LOOP_START+2+int(round(t*16))+j1, F_LOOP_START+29+int(round(t*16))+j2):
            key_all(b, start, style=S("QUAD", "EASE_OUT"))
            key_all(b, start+3, LOC(up=0.05), ROT(roll=3*a), SCL(1.16))
            key_all(b, start+7)
        key_all(b, F_IDLE_END)
    # ---- EXIT (86..100) ----
    key(master, F_EXIT_START, scl=SCL(), style=S("BACK", "EASE_IN"))
    key(master, F_END, scl=SCL(HIDDEN))
    key(master, F_EXIT_START, rot=ROT(), style=S("EXPO", "EASE_IN"))
    key(master, F_END, rot=ROT(roll=-540))
    key(master, F_EXIT_START, loc=LOC(), style=S("QUAD", "EASE_IN"))
    key(master, F_END, loc=LOC(up=0.5))
    # the master spins the whole rig away - word roots only carry a gentle
    # drift so they never fight the letters' own visibility keys
    for k, w in enumerate(words):
        key_all(w, F_EXIT_START)
        key_all(w, XF(96), loc=LOC(up=0.08), rot=ROT(roll=4*(1.0 if k == 0 else -1.0)),
                style=S("QUAD", "EASE_IN"))
        key_all(w, F_END, loc=LOC(up=0.3))
    for b in letters:
        key_all(b, F_EXIT_START); key_all(b, XF(96), style=S("QUAD", "EASE_IN"))
        key_all(b, F_END, scl=SCL(HIDDEN))


