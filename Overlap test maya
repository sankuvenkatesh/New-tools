class OVERLAPPER_OT_run(bpy.types.Operator):
    bl_idname = "overlapper.run"
    bl_label = "Overlap"
    bl_description = "Create overlapping / follow-through animation."
    bl_options = {'REGISTER', 'UNDO'}

    @classmethod
    def poll(cls, context):
        if context.mode == 'POSE':
            return bool(context.selected_pose_bones)
        return len(context.selected_objects) >= 1

    def execute(self, context):
        import time

        props = context.scene.overlapper_props
        t0 = time.time()

        try:
            ok, message = run_overlapper(context, props)
        except Exception as exc:
            self.report({'ERROR'}, f"Overlapper failed: {exc}")
            return {'CANCELLED'}

        if not ok:
            self.report({'WARNING'}, message)
            return {'CANCELLED'}

        elapsed = time.time() - t0

        self.report(
            {'INFO'},
            f"{message} ({elapsed:.2f}s)"
        )

        return {'FINISHED'}


class OVERLAPPER_OT_reset(bpy.types.Operator):
    bl_idname = "overlapper.reset"
    bl_label = "Reset Values"
    bl_description = "Reset Overlapper settings."
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        props = context.scene.overlapper_props

        for key in props.rna_type.properties.keys():
            if key in ('rna_type', 'name'):
                continue
            props.property_unset(key)

        self.report(
            {'INFO'},
            "Overlapper settings reset to defaults."
        )

        return {'FINISHED'}


class OVERLAPPER_OT_restore(bpy.types.Operator):
    bl_idname = "overlapper.restore"
    bl_label = "Restore Original Pose"
    bl_description = "Undo the most recent Overlap bake."
    bl_options = {'REGISTER', 'UNDO'}

    @classmethod
    def poll(cls, context):
        if _BACKUP_STORE:
            return True

        for obj in bpy.data.objects:
            if (
                obj.animation_data
                and obj.animation_data.nla_tracks.get("Overlapper_Base")
            ):
                return True

        return False

    def execute(self, context):
        count = restore_all_backups(context)

        if count == 0:
            self.report(
                {'WARNING'},
                "Nothing to restore."
            )
            return {'CANCELLED'}

        self.report(
            {'INFO'},
            f"Restored original animation on {count} object(s)."
        )

        return {'FINISHED'}


class OVERLAPPER_OT_cleanup(bpy.types.Operator):
    bl_idname = "overlapper.cleanup"
    bl_label = "CleanUp"
    bl_description = "Delete all Overlapper helper objects."
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        remove_collection(HELPER_COLLECTION_NAME)

        for obj in list(bpy.data.objects):
            if obj.name.startswith(HELPER_PREFIX):
                bpy.data.objects.remove(
                    obj,
                    do_unlink=True
                )

        self.report(
            {'INFO'},
            "Overlapper helpers cleaned up."
        )

        return {'FINISHED'}


