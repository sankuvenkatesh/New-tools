import bpy
import math
from mathutils import Vector, Euler, Quaternion

HELPER_COLLECTION_NAME = "Overlapper_Helpers"
HELPER_PREFIX = "OVL_"
RESULT_COLLECTION_NAME = "OverlapperSet"

VALID_EULER_ORDERS = {'XYZ', 'XZY', 'YXZ', 'YZX', 'ZXY', 'ZYX'}

_BACKUP_STORE = {}


# ---------------------------------------------------------------------------
# Version-safe Action / F-Curve access
# ---------------------------------------------------------------------------

def get_fcurve(id_obj, action, data_path, index):
    try:
        return action.fcurve_ensure_for_datablock(
            id_obj, data_path, index=index
        )
    except AttributeError:
        fc = action.fcurves.find(data_path, index=index)
        if fc is None:
            fc = action.fcurves.new(data_path, index=index)
        return fc


def ensure_action(id_obj):
    if id_obj.animation_data is None:
        id_obj.animation_data_create()
    if id_obj.animation_data.action is None:
        id_obj.animation_data.action = bpy.data.actions.new(
            name=f"{id_obj.name}Action"
        )
    return id_obj.animation_data.action


# ---------------------------------------------------------------------------
# Small utilities
# ---------------------------------------------------------------------------

def get_frame_range(context):
    scene = context.scene
    if scene.use_preview_range:
        return scene.frame_preview_start, scene.frame_preview_end
    return scene.frame_start, scene.frame_end


def get_or_create_collection(name, parent=None):
    if name in bpy.data.collections:
        return bpy.data.collections[name]
    coll = bpy.data.collections.new(name)
    if parent is None:
        parent = bpy.context.scene.collection
    parent.children.link(coll)
    return coll


def remove_collection(name):
    coll = bpy.data.collections.get(name)
    if coll is None:
        return
    for obj in list(coll.objects):
        bpy.data.objects.remove(obj, do_unlink=True)
    bpy.data.collections.remove(coll)


def create_empty(name, collection, size=0.15):
    empty = bpy.data.objects.new(name, None)
    empty.empty_display_type = 'PLAIN_AXES'
    empty.empty_display_size = size
    collection.objects.link(empty)
    return empty


def clamp(value, low, high):
    return max(low, min(high, value))


def safe_normalized(v, fallback=Vector((1.0, 0.0, 0.0))):
    if v.length < 1e-8:
        return fallback.copy()
    return v.normalized()


# ---------------------------------------------------------------------------
# ChainItem
# ---------------------------------------------------------------------------

class ChainItem:
    __slots__ = ("kind", "id_obj", "bone_name")

    def __init__(self, kind, id_obj, bone_name=None):
        self.kind = kind
        self.id_obj = id_obj
        self.bone_name = bone_name

    @property
    def name(self):
        if self.kind == 'BONE':
            return f"{self.id_obj.name}:{self.bone_name}"
        return self.id_obj.name

    @property
    def pose_bone(self):
        return self.id_obj.pose.bones[self.bone_name]

    @property
    def bone_data(self):
        return self.id_obj.data.bones[self.bone_name]

    def target(self):
        return self.pose_bone if self.kind == 'BONE' else self.id_obj

    def world_matrix(self):
        if self.kind == 'BONE':
            return self.id_obj.matrix_world @ self.pose_bone.matrix
        return self.id_obj.matrix_world.copy()

    def rotation_mode(self):
        return self.target().rotation_mode

    def data_path(self, prop):
        if self.kind == 'BONE':
            return f'pose.bones["{self.bone_name}"].{prop}'
        return prop

    def read_rotation_euler(self, order='XYZ'):
        target = self.target()
        mode = self.rotation_mode()
        if mode == 'QUATERNION':
            return target.rotation_quaternion.to_euler(order)
        if mode == 'AXIS_ANGLE':
            aa = target.rotation_axis_angle
            return Quaternion((aa[1], aa[2], aa[3]), aa[0]).to_euler(order)
        return target.rotation_euler.copy()

    def read_location(self):
        return self.target().location.copy()

    def hierarchy_depth(self):
        depth = 0
        if self.kind == 'BONE':
            b = self.bone_data.parent
            while b is not None:
                depth += 1
                b = b.parent
        else:
            obj = self.id_obj.parent
            while obj is not None:
                depth += 1
                obj = obj.parent
        return depth


def get_selected_chain(context):
    if context.mode == 'POSE' and context.selected_pose_bones:
        armature_obj = context.object
        return [
            ChainItem('BONE', armature_obj, b.name)
            for b in context.selected_pose_bones
        ]
    return [ChainItem('OBJECT', obj) for obj in context.selected_objects]


def expand_hierarchy(chain):
    seen = set()
    result = []

    def walk_object(obj):
        if obj.name in seen:
            return
        seen.add(obj.name)
        result.append(ChainItem('OBJECT', obj))
        for child in sorted(obj.children, key=lambda c: c.name):
            walk_object(child)

    def walk_bone(armature_obj, bone):
        key = (armature_obj.name, bone.name)
        if key in seen:
            return
        seen.add(key)
        result.append(ChainItem('BONE', armature_obj, bone.name))
        for child in sorted(bone.children, key=lambda c: c.name):
            walk_bone(armature_obj, child)

    for item in chain:
        if item.kind == 'BONE':
            walk_bone(item.id_obj, item.bone_data)
        else:
            walk_object(item.id_obj)

    return result


def order_chain(chain):
    return sorted(chain, key=lambda item: item.hierarchy_depth())


# ---------------------------------------------------------------------------
# NLA support
# ---------------------------------------------------------------------------

def remove_existing_overlap_tracks(id_obj):
    anim = id_obj.animation_data
    if anim is None:
        return
    for track in list(anim.nla_tracks):
        if track.name in {"Overlapper_Base", "Overlapper_Overlap"}:
            anim.nla_tracks.remove(track)


def push_base_action_to_nla(id_obj, frame_start):
    if id_obj.animation_data is None:
        id_obj.animation_data_create()

    anim = id_obj.animation_data

    if anim.action is not None:
        # Do not stack another Overlapper base layer on top of an earlier run.
        old_base = anim.nla_tracks.get("Overlapper_Base")
        if old_base is not None:
            anim.nla_tracks.remove(old_base)

        track = anim.nla_tracks.new()
        track.name = "Overlapper_Base"
        action = anim.action
        strip = track.strips.new(action.name, int(frame_start), action)
        strip.action_frame_start = action.frame_range[0]
        strip.action_frame_end = action.frame_range[1]
        anim.action = None


def add_overlap_nla_layer(id_obj, action, frame_start):
    anim = id_obj.animation_data
    # Remove a stale overlap layer before creating a new one.
    old = anim.nla_tracks.get("Overlapper_Overlap")
    if old is not None:
        anim.nla_tracks.remove(old)

    track = anim.nla_tracks.new()
    track.name = "Overlapper_Overlap"
    strip = track.strips.new(action.name, int(frame_start), action)
    strip.blend_type = 'ADD'
    strip.extrapolation = 'NOTHING'
    strip.name = "Overlap"


def restore_nla(id_obj):
    anim = id_obj.animation_data
    if anim is None:
        return False

    base_track = anim.nla_tracks.get("Overlapper_Base")
    if base_track is None or not base_track.strips:
        return False

    base_action = base_track.strips[0].action
    anim.action = base_action

    overlap_track = anim.nla_tracks.get("Overlapper_Overlap")
    if overlap_track is not None:
        anim.nla_tracks.remove(overlap_track)

    anim.nla_tracks.remove(base_track)
    return True


# ---------------------------------------------------------------------------
# Direct-bake backup / restore
# ---------------------------------------------------------------------------

def backup_fcurve(id_obj, fc):
    store = _BACKUP_STORE.setdefault(id_obj.name, {})
    fid = (fc.data_path, fc.array_index)
    if fid in store:
        return
    store[fid] = [
        (kp.co[0], kp.co[1], kp.interpolation)
        for kp in fc.keyframe_points
    ]


def backup_channel_if_needed(id_obj, action, data_path, index):
    # get_fcurve works identically on 4.x and 5.x (it's the same call used
    # to write later), so snapshotting through it - rather than through a
    # separate "find without create" - can't silently miss existing keys.
    # A channel that's genuinely new just yields an empty snapshot, which
    # restore_fcurve already treats correctly as "nothing to put back".
    fc = get_fcurve(id_obj, action, data_path, index)
    backup_fcurve(id_obj, fc)


def restore_fcurve(id_obj, action, data_path, index, points):
    fc = get_fcurve(id_obj, action, data_path, index)

    if not points:
        # Channel didn't exist before Overlapper touched it - drop it.
        try:
            action.fcurves.remove(fc)
        except (AttributeError, RuntimeError):
            pass
        return

    fc.keyframe_points.clear()

    for frame, value, interp in points:
        kp = fc.keyframe_points.insert(frame, value, options={'FAST'})
        kp.interpolation = interp

    fc.update()


def restore_all_backups(context):
    restored = set()

    for obj in bpy.data.objects:
        if restore_nla(obj):
            restored.add(obj.name)

    for obj_name, curves in list(_BACKUP_STORE.items()):
        id_obj = bpy.data.objects.get(obj_name)
        if id_obj is None:
            continue

        action = ensure_action(id_obj)

        for (data_path, index), points in curves.items():
            restore_fcurve(id_obj, action, data_path, index, points)

        restored.add(obj_name)

    _BACKUP_STORE.clear()
    context.scene.frame_set(context.scene.frame_current)
    return len(restored)


# ---------------------------------------------------------------------------
# Curve evaluation
# ---------------------------------------------------------------------------

def evaluate_curves(loc_fcurves, rot_fcurves, frame,
                    frame_start, frame_end, cyclic, cycle_len):
    if cyclic and cycle_len > 0:
        frame = frame_start + ((frame - frame_start) % cycle_len)
    else:
        frame = max(frame_start, min(frame_end, frame))

    loc = Vector((
        loc_fcurves[0].evaluate(frame),
        loc_fcurves[1].evaluate(frame),
        loc_fcurves[2].evaluate(frame),
    ))

    quat = Quaternion((
        rot_fcurves[0].evaluate(frame),
        rot_fcurves[1].evaluate(frame),
        rot_fcurves[2].evaluate(frame),
        rot_fcurves[3].evaluate(frame),
    ))

    if quat.magnitude > 1e-8:
        quat.normalize()
    else:
        quat = Quaternion((1, 0, 0, 0))

    return loc, quat


def wind_offset(frame, speed, seed):
    phase = (seed * 12.9898) % (2 * math.pi)
    t = frame * 0.15 * max(speed, 0.0001) + phase

    y = math.sin(t) + 0.5 * math.sin(t * 2.13 + 1.0)
    z = math.cos(t * 0.87 + 1.3) + 0.5 * math.cos(t * 1.9 + 0.4)

    return y, z


def simplify_fcurves(fcurves, tolerance=0.0001):
    for fc in fcurves:
        pts = fc.keyframe_points
        if len(pts) < 3:
            continue

        to_remove = []

        for idx in range(1, len(pts) - 1):
            prev_v = pts[idx - 1].co[1]
            cur_v = pts[idx].co[1]
            next_v = pts[idx + 1].co[1]

            if (
                abs(cur_v - prev_v) < tolerance
                and abs(cur_v - next_v) < tolerance
            ):
                to_remove.append(idx)

        for idx in reversed(to_remove):
            pts.remove(pts[idx])

        fc.update()


def add_to_selection_set(chain):
    object_items = [it for it in chain if it.kind == 'OBJECT']
    bone_items = [it for it in chain if it.kind == 'BONE']

    if object_items:
        coll = get_or_create_collection(RESULT_COLLECTION_NAME)

        for it in object_items:
            if it.id_obj.name not in coll.objects:
                coll.objects.link(it.id_obj)

    if bone_items:
        by_armature = {}

        for it in bone_items:
            by_armature.setdefault(it.id_obj, []).append(it.bone_name)

        for armature_obj, bone_names in by_armature.items():
            try:
                arm_data = armature_obj.data
                bcoll = arm_data.collections.get(RESULT_COLLECTION_NAME)

                if bcoll is None:
                    bcoll = arm_data.collections.new(RESULT_COLLECTION_NAME)

                for bname in bone_names:
                    bone = arm_data.bones.get(bname)
                    if bone is not None:
                        bcoll.assign(bone)
            except AttributeError:
                pass


# ---------------------------------------------------------------------------
# Rotation helpers
# ---------------------------------------------------------------------------

def get_rotation_settings(item):
    mode = item.rotation_mode()

    if mode == 'QUATERNION':
        return "rotation_quaternion", 4, 'XYZ'

    if mode == 'AXIS_ANGLE':
        return "rotation_axis_angle", 4, 'XYZ'

    order = mode if mode in VALID_EULER_ORDERS else 'XYZ'
    return "rotation_euler", 3, order


def rotation_delta_to_euler(delta_local, euler_order):
    return delta_local.to_euler(euler_order)


def clamp_euler_delta(delta, max_degrees):
    if max_degrees <= 0:
        return delta

    maximum = math.radians(max_degrees)

    return Euler((
        clamp(delta.x, -maximum, maximum),
        clamp(delta.y, -maximum, maximum),
        clamp(delta.z, -maximum, maximum),
    ), delta.order)


# ---------------------------------------------------------------------------
# Core algorithm
# ---------------------------------------------------------------------------

def run_overlapper(context, props):
    scene = context.scene
    chain = get_selected_chain(context)

    if props.hierarchy_mode:
        chain = expand_hierarchy(chain)

    chain = order_chain(chain)

    if len(chain) < 2:
        return False, "Select at least two controls (objects, or pose bones in Pose Mode)."

    frame_start, frame_end = get_frame_range(context)
    frame_start = int(frame_start)
    frame_end = int(frame_end)

    if frame_end <= frame_start:
        return False, "Invalid frame range."

    cycle_len = frame_end - frame_start
    cyclic = props.cycle_mode

    start_index = 1 if props.dont_use_first else 0

    if len(chain) - start_index < 1:
        return False, "Not enough controls after 'Don't use first controls'."

    original_frame = scene.frame_current

    # A fresh run gets a fresh direct-bake backup.
    if not props.bake_new_layer:
        _BACKUP_STORE.clear()

    helper_coll = get_or_create_collection(HELPER_COLLECTION_NAME)

    # -----------------------------------------------------------------------
    # STEP 1 - Bake exact world-space followers.
    # -----------------------------------------------------------------------

    follower_curves = []

    for i, item in enumerate(chain):
        empty = create_empty(
            f"{HELPER_PREFIX}{i:02d}_{item.name}",
            helper_coll
        )

        action = ensure_action(empty)

        loc_fcs = [
            get_fcurve(empty, action, "location", c)
            for c in range(3)
        ]

        rot_fcs = [
            get_fcurve(empty, action, "rotation_quaternion", c)
            for c in range(4)
        ]

        follower_curves.append((loc_fcs, rot_fcs))

    # Baselines are required for direct bake.
    need_baseline = not props.bake_new_layer

    baseline_rot = (
        {i: [] for i in range(start_index, len(chain))}
        if need_baseline else None
    )

    baseline_loc = (
        {i: [] for i in range(start_index, len(chain))}
        if (need_baseline and props.add_translate) else None
    )

    spacing_samples = []

    # One scene evaluation pass.
    for f in range(frame_start, frame_end + 1):
        scene.frame_set(f)

        prev_loc = None

        for i, item in enumerate(chain):
            mat = item.world_matrix()
            loc, quat, _scale = mat.decompose()

            loc_fcs, rot_fcs = follower_curves[i]

            for c in range(3):
                loc_fcs[c].keyframe_points.insert(
                    f, loc[c], options={'FAST'}
                )

            for c in range(4):
                rot_fcs[c].keyframe_points.insert(
                    f, quat[c], options={'FAST'}
                )

            if prev_loc is not None:
                spacing_samples.append((loc - prev_loc).length)

            prev_loc = loc

            if need_baseline and i >= start_index:
                order = item.rotation_mode()
                order = (
                    order
                    if order in VALID_EULER_ORDERS
                    else 'XYZ'
                )

                baseline_rot[i].append(
                    item.read_rotation_euler(order)
                )

                if baseline_loc is not None:
                    baseline_loc[i].append(
                        item.read_location()
                    )

    for loc_fcs, rot_fcs in follower_curves:
        for fc in loc_fcs + rot_fcs:
            for kp in fc.keyframe_points:
                kp.interpolation = 'LINEAR'
            fc.update()

    scene.frame_set(original_frame)

    # -----------------------------------------------------------------------
    # STEP 2 - Bind directions.
    # -----------------------------------------------------------------------

    bind_pos = []
    bind_quat = []

    for i in range(len(chain)):
        p, q = evaluate_curves(
            *follower_curves[i],
            frame_start,
            frame_start,
            frame_end,
            False,
            0
        )
        bind_pos.append(p)
        bind_quat.append(q)

    bind_local_dir = []

    for i in range(len(chain)):
        if i < len(chain) - 1:
            world_dir = bind_pos[i + 1] - bind_pos[i]
        elif i > 0:
            world_dir = bind_pos[i] - bind_pos[i - 1]
        else:
            world_dir = Vector((1.0, 0.0, 0.0))

        world_dir = safe_normalized(world_dir)

        local_dir = bind_quat[i].inverted() @ world_dir
        bind_local_dir.append(safe_normalized(local_dir))

    # -----------------------------------------------------------------------
    # STEP 3 - Scale / spacing.
    # -----------------------------------------------------------------------

    intensity = max(props.scale, 0.0001)

    if props.adaptive_scale and spacing_samples:
        avg_spacing = sum(spacing_samples) / len(spacing_samples)
    else:
        avg_spacing = 1.0

    whisker_length = max(avg_spacing, 0.0001) / intensity

    # -----------------------------------------------------------------------
    # STEP 4 - Build groups.
    # -----------------------------------------------------------------------

    groups = {}
    order = []

    for i in range(start_index, len(chain)):
        item = chain[i]
        key = item.id_obj.name

        if key not in groups:
            groups[key] = []
            order.append(key)

        groups[key].append(i)

    # -----------------------------------------------------------------------
    # STEP 5 - Bake overlap.
    # -----------------------------------------------------------------------

    for key in order:
        entries = groups[key]
        id_obj = chain[entries[0]].id_obj

        if props.bake_new_layer:
            # If the previous generated layer exists, restore its base first.
            restore_nla(id_obj)

            push_base_action_to_nla(id_obj, frame_start)

            target_action = bpy.data.actions.new(
                name=f"{id_obj.name}_Overlap"
            )

            id_obj.animation_data.action = target_action
            additive_only = True

        else:
            target_action = ensure_action(id_obj)
            additive_only = False

        for i in entries:
            item = chain[i]
            follower_curve = follower_curves[i]
            local_dir = bind_local_dir[i]

            rot_prop, rot_channels, euler_order = get_rotation_settings(item)

            rot_path = item.data_path(rot_prop)

            # For direct baking, explicitly back up the channels before
            # creating/overwriting them.
            rot_fcurves = []

            for c in range(rot_channels):
                if not additive_only:
                    backup_channel_if_needed(
                        id_obj, target_action, rot_path, c
                    )
                rot_fcurves.append(
                    get_fcurve(
                        id_obj,
                        target_action,
                        rot_path,
                        c
                    )
                )

            loc_fcurves = None

            if props.add_translate:
                loc_fcurves = []

                for c in range(3):
                    path = item.data_path("location")

                    if not additive_only:
                        backup_channel_if_needed(
                            id_obj, target_action, path, c
                        )

                    loc_fcurves.append(
                        get_fcurve(
                            id_obj,
                            target_action,
                            path,
                            c
                        )
                    )

            # ----------------------------------------------------------------
            # Per-link delay.
            #
            # softness remains the original base delay.
            # delay_falloff=0 -> same delay on every link.
            # delay_falloff=1 -> linearly increasing delay to the tip.
            # tip_delay_multiplier > 1 can exaggerate the tip.
            # ----------------------------------------------------------------

            chain_span = max(1, len(chain) - 1)

            normalized_link = i / chain_span

            delay = (
                max(props.softness, 0.0)
                * (
                    1.0
                    + props.delay_falloff * normalized_link
                )
            )

            if props.tip_delay_multiplier > 0:
                tip_weight = normalized_link ** max(
                    props.tip_falloff_power,
                    0.01
                )
                delay *= (
                    1.0
                    + (props.tip_delay_multiplier - 1.0)
                    * tip_weight
                )

            delay = max(delay, 0.0)

            # Rotation/translation strength can be weighted toward the tip.
            falloff_power = max(props.falloff_power, 0.01)

            if props.root_strength == props.tip_strength:
                link_strength = props.root_strength
            else:
                t = normalized_link ** falloff_power
                link_strength = (
                    props.root_strength
                    + (props.tip_strength - props.root_strength) * t
                )

            seed = (i + 1) * 7.13

            for f_index, f in enumerate(
                range(frame_start, frame_end + 1)
            ):
                own_pos, own_quat = evaluate_curves(
                    *follower_curve,
                    f,
                    frame_start,
                    frame_end,
                    cyclic,
                    cycle_len
                )

                delayed_frame = f - delay

                d_pos, d_quat = evaluate_curves(
                    *follower_curve,
                    delayed_frame,
                    frame_start,
                    frame_end,
                    cyclic,
                    cycle_len
                )

                aim_now = safe_normalized(
                    own_quat @ local_dir
                )

                whisker_delayed_dir = safe_normalized(
                    d_quat @ local_dir
                )

                delayed_target = (
                    d_pos
                    + whisker_delayed_dir * whisker_length
                )

                if props.use_wind:
                    up1 = safe_normalized(
                        d_quat @ Vector((0.0, 1.0, 0.0))
                    )
                    up2 = safe_normalized(
                        d_quat @ Vector((0.0, 0.0, 1.0))
                    )

                    wy, wz = wind_offset(
                        f,
                        props.wind_speed,
                        seed
                    )

                    wind_amp = (
                        0.07
                        * whisker_length
                        * props.wind_scale
                        * props.wind_strength
                    )

                    delayed_target += (
                        up1 * (wy * wind_amp)
                        + up2 * (wz * wind_amp)
                    )

                aim_dir = delayed_target - own_pos

                if aim_dir.length < 1e-6:
                    aim_dir = aim_now.copy()
                else:
                    aim_dir.normalize()

                swing = aim_now.rotation_difference(aim_dir)

                # Convert world swing into local space.
                delta_local = (
                    own_quat.inverted()
                    @ swing
                    @ own_quat
                )

                d_rot = rotation_delta_to_euler(
                    delta_local,
                    euler_order
                )

                # Apply overlap strength.
                d_rot = Euler((
                    d_rot.x * link_strength,
                    d_rot.y * link_strength,
                    d_rot.z * link_strength,
                ), euler_order)

                # Optional maximum rotation per frame.
                d_rot = clamp_euler_delta(
                    d_rot,
                    props.max_rotation
                )

                if additive_only:
                    final_rot_euler = d_rot
                else:
                    base_euler = baseline_rot[i][f_index]

                    final_rot_euler = Euler((
                        base_euler.x + d_rot.x,
                        base_euler.y + d_rot.y,
                        base_euler.z + d_rot.z,
                    ), euler_order)

                if rot_prop == "rotation_quaternion":
                    q = final_rot_euler.to_quaternion()

                    for c in range(4):
                        rot_fcurves[c].keyframe_points.insert(
                            f,
                            q[c],
                            options={'FAST'}
                        )

                elif rot_prop == "rotation_axis_angle":
                    q = final_rot_euler.to_quaternion()
                    axis, angle = q.to_axis_angle()

                    if axis.length < 1e-8:
                        axis = Vector((0.0, 1.0, 0.0))

                    values = (
                        angle,
                        axis.x,
                        axis.y,
                        axis.z
                    )

                    for c in range(4):
                        rot_fcurves[c].keyframe_points.insert(
                            f,
                            values[c],
                            options={'FAST'}
                        )

                else:
                    for c in range(3):
                        rot_fcurves[c].keyframe_points.insert(
                            f,
                            final_rot_euler[c],
                            options={'FAST'}
                        )

                if loc_fcurves is not None:
                    d_loc = d_pos - own_pos

                    # Translation strength can be independent from rotation.
                    d_loc *= (
                        props.translate_strength
                        * link_strength
                    )

                    if props.max_translation > 0:
                        length = d_loc.length
                        maximum = props.max_translation

                        if length > maximum:
                            d_loc *= maximum / length

                    if additive_only:
                        final_loc = d_loc
                    else:
                        final_loc = (
                            baseline_loc[i][f_index]
                            + d_loc
                        )

                    for c in range(3):
                        loc_fcurves[c].keyframe_points.insert(
                            f,
                            final_loc[c],
                            options={'FAST'}
                        )

            for fc in rot_fcurves:
                fc.update()

            if loc_fcurves is not None:
                for fc in loc_fcurves:
                    fc.update()

            if props.delete_redundant:
                simplify_fcurves(
                    rot_fcurves + (loc_fcurves or []),
                    props.redundant_tolerance
                )

        if props.bake_new_layer:
            add_overlap_nla_layer(
                id_obj,
                target_action,
                frame_start
            )

    if props.create_selection_set:
        add_to_selection_set(chain[start_index:])

    if not props.debug_mode:
        remove_collection(HELPER_COLLECTION_NAME)

    scene.frame_set(original_frame)

    return (
        True,
        f"Overlap applied to {len(chain) - start_index} control(s)."
    )


