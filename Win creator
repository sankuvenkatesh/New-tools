def v7_jelly_wobble(master, letters):
    n = len(letters)
    # ---- ENTRY (1..30) ----
    key_all(master, F_START, scl=SCL(0.9), style=S("BACK", "EASE_OUT"))
    key_all(master, F_ENTRY_END)
    for i, b in enumerate(letters):
        f0 = F_START + ostagger(b, i, n, 8)
        low, tilt = LOC(up=-0.25 * vary(b, "lo", 0.3)), ROT(roll=10*alt(i)*vary(b, "tl", 0.4))
        blob = SQ(b, "blob", 0.25, 1.6, 0.2)
        key(b, F_START, loc=low, rot=tilt)
        key(b, f0+2, loc=low, rot=tilt, style=S("ELASTIC", "EASE_OUT", 0.35 * vary(b, "per", 0.25)))
        key(b, F_ENTRY_END, loc=LOC(), rot=ROT())
        key(b, F_START, scl=SCL(HIDDEN))
        key(b, f0, scl=SCL(HIDDEN), style=S("QUAD", "EASE_OUT"))
        key(b, f0+2, scl=blob, style=S("ELASTIC", "EASE_OUT", 0.35 * vary(b, "per", 0.25)))
        key(b, F_ENTRY_END, scl=SCL())
    # ---- LOOP (31..85) ----
    key_all(master, F_LOOP_START, style=S("SINE", "EASE_IN_OUT"))
    key_all(master, LF(52) + int(round(jit(master, "m52", 2.0))), scl=SQ(master, "m52a", 1.04, 0.98, 0.4),
            style=S("SINE", "EASE_IN_OUT"))
    key_all(master, F_IDLE_END)
    for i, b in enumerate(letters):
        ph = tpos(i, n) * math.pi * 1.5
        up_a = 0.025 * vary(b, "ju", 0.3)
        roll_a = 2.0 * vary(b, "jr", 0.4)
        sy_a = 0.09 * vary(b, "jy", 0.3)
        sx_a = 0.06 * vary(b, "jx", 0.3)
        def jelly(f, b=b, ph=ph, up_a=up_a, roll_a=roll_a, sy_a=sy_a, sx_a=sx_a):
            w = wave(b, "w", f, 2.5, ph)
            return (LOC(up=up_a*w), ROT(roll=roll_a*w),
                    SCL(1.0, up=1.0+sy_a*w, side=1.0-sx_a*w))
        sample(b, F_LOOP_START, F_IDLE_END, 2, jelly)
    # ---- EXIT (86..100) ----
    key_all(master, F_EXIT_START); key_all(master, F_END)
    for i, b in enumerate(letters):
        f0 = F_EXIT_START + ostagger(b, i, n, XS(6), reverse=True); a = alt(i)
        key_all(b, F_EXIT_START); key_all(b, f0, style=S("QUAD", "EASE_OUT"))
        key_all(b, f0+XS(4), LOC(up=-0.05), ROT(roll=-4*a*vary(b, "xr", 0.4)), SQ(b, "x1", 0.55, 1.30),
                style=S("QUAD", "EASE_IN"))
        key_all(b, f0+XS(8), LOC(up=0.35 * vary(b, "xu", 0.3)), ROT(roll=6*a*vary(b, "xs", 0.4)),
                SQ(b, "x2", 1.50, 0.75), style=S("QUAD", "EASE_IN"))
        key_all(b, F_END, LOC(up=1.2 * vary(b, "xe", 0.2)), ROT(roll=-10*a*vary(b, "xk", 0.4)), SCL(HIDDEN))


