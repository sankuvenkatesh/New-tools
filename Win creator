# V12 - ACCORDION SPREAD  (fans out around the middle of EACH word)
# ============================================================

def v12_accordion_spread(master, letters):
    n = len(letters)
    off = {b.name: letter_offset(b, i, n) for i, b in enumerate(letters)}
    # ---- ENTRY (1..30) ----
    key_all(master, F_START, scl=SCL(0.9), style=S("BACK", "EASE_OUT"))
    key_all(master, F_ENTRY_END)
    for i, b in enumerate(letters):
        s = 2.0*tpos_word(b, i, n) - 1.0
        f0 = F_START + max(0, int(round(abs(s)*6 + jit(b, "f0", 1.0))))
        packed = LOC(side=side_by(b, -off[b.name])); fan = ROT(roll=30*s*vary(b, "fan", 0.2))
        key(b, F_START, loc=packed, rot=fan)
        key(b, f0, loc=packed, rot=fan, style=S("BACK", "EASE_OUT"))
        key(b, F_ENTRY_END, loc=LOC(), rot=ROT())
        key(b, F_START, scl=SCL(HIDDEN))
        key(b, f0, scl=SCL(HIDDEN), style=S("QUAD", "EASE_OUT"))
        key(b, f0+4, scl=SCL()); key(b, F_ENTRY_END, scl=SCL())
    # ---- LOOP (31..85) ----
    key_all(master, F_LOOP_START); key_all(master, F_IDLE_END)
    for i, b in enumerate(letters):
        s = 2.0*tpos_word(b, i, n) - 1.0; o = off[b.name]
        side_a = 0.07 * vary(b, "bx", 0.3)
        up_a = 0.02 * vary(b, "bu", 0.3)
        roll_a = 3.0 * vary(b, "br", 0.3)
        sc_a = 0.02 * vary(b, "bs", 0.3)
        def breathe(f, b=b, s=s, o=o, side_a=side_a, up_a=up_a, roll_a=roll_a, sc_a=sc_a):
            w = wave(b, "w", f, 2, 0.0)
            return (LOC(side=side_by(b, o*side_a*w), up=up_a*(1.0-abs(s))*w*w),
                    ROT(roll=roll_a*s*w), SCL(1.0+sc_a*w))
        sample(b, F_LOOP_START, F_IDLE_END, 2, breathe)
    # ---- EXIT (86..100) ----
    key_all(master, F_EXIT_START, style=S("QUAD", "EASE_IN"))
    key_all(master, F_END, scl=SCL(dv(0.85, master, "x100", 0.3)))
    for i, b in enumerate(letters):
        s = 2.0*tpos_word(b, i, n) - 1.0
        f0 = F_EXIT_START + max(0, int(round((1.0-abs(s))*XS(6) + jit(b, "x0", 1.0))))
        key_all(b, F_EXIT_START)
        key(b, f0, loc=LOC(), style=S("BACK", "EASE_IN"))
        key(b, F_END, loc=LOC(side=side_by(b, -off[b.name])))
        key(b, f0, rot=ROT(), style=S("QUAD", "EASE_IN"))
        key(b, F_END, rot=ROT(roll=-30*s*vary(b, "xr", 0.2)))
        key(b, f0, scl=SCL(), style=S("QUAD", "EASE_IN"))
        key(b, F_END, scl=SCL(HIDDEN))


