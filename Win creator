def v8_spin_zoom(master, letters):
    n = len(letters)
    # ---- ENTRY (1..30) ----
    key(master, F_START, scl=SCL(HIDDEN), style=S("BACK", "EASE_OUT"))
    key(master, 24, scl=SCL()); key(master, F_ENTRY_END, scl=SCL())
    key(master, F_START, rot=ROT(roll=540), style=S("EXPO", "EASE_OUT"))
    key(master, 24, rot=ROT()); key(master, F_ENTRY_END, rot=ROT())
    key(master, F_START, loc=LOC(up=-0.4), style=S("QUAD", "EASE_OUT"))
    key(master, 24, loc=LOC()); key(master, F_ENTRY_END, loc=LOC())
    for i, b in enumerate(letters):
        d = ostagger(b, i, n, 4); dr = ostagger(b, i, n, 6); a = alt(i)
        key_all(b, F_START, scl=SCL(HIDDEN))
        key_all(b, F_START+d, scl=SCL(HIDDEN), style=S("QUAD", "EASE_OUT"))
        key_all(b, F_START+d+4)
        key(b, 12+dr, rot=ROT(roll=16*a*vary(b, "wr", 0.4)), style=S("ELASTIC", "EASE_OUT", 0.3 * vary(b, "per", 0.3)))
        key_all(b, F_ENTRY_END)
    # ---- LOOP (31..85) ----
    def sway(f):
        w = wave(master, "sw", f, 1.5, 0.0)
        return LOC(up=0.03*w), ROT(roll=1.8*w), SCL(1.0+0.025*w*w)
    sample(master, F_LOOP_START, F_IDLE_END, 3, sway)
    for i, b in enumerate(letters):
        a = alt(i); t = tpos(i, n); key_all(b, F_LOOP_START)
        st1 = F_LOOP_START+2+int(round(t*16)) + int(round(jit(b, "h1", 1.0)))
        st2 = F_LOOP_START+29+int(round(t*16)) + int(round(jit(b, "h2", 1.0)))
        for hn, start in enumerate((st1, st2)):
            key_all(b, start, style=S("QUAD", "EASE_OUT"))
            key_all(b, start+3, LOC(up=0.05 * vary(b, "hu%d" % hn, 0.3)), ROT(roll=3*a*vary(b, "hr%d" % hn, 0.4)),
                    SCL(dv(1.16, b, "hs%d" % hn, 0.3)))
            key_all(b, start+7)
        key_all(b, F_IDLE_END)
    # ---- EXIT (86..100) ----
    key(master, F_EXIT_START, scl=SCL(), style=S("BACK", "EASE_IN"))
    key(master, F_END, scl=SCL(HIDDEN))
    key(master, F_EXIT_START, rot=ROT(), style=S("EXPO", "EASE_IN"))
    key(master, F_END, rot=ROT(roll=-540))
    key(master, F_EXIT_START, loc=LOC(), style=S("QUAD", "EASE_IN"))
    key(master, F_END, loc=LOC(up=0.5))
    for b in letters:
        key_all(b, F_EXIT_START); key_all(b, XF(96), style=S("QUAD", "EASE_IN"))
        key_all(b, F_END, scl=SCL(HIDDEN))


