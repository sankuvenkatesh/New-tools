"""
Slot Symbol Animation Generator — Blender Addon (v1.2.0)
=========================================================
Compatible: Blender 4.2 LTS → 5.2 LTS

NEW in v1.2.0:
  ✓ Squash & Stretch   — volume-preserving scale on win (cartoony pop)
  ✓ Anticipation       — brief backward wind-up before forward rush
  ✓ Overshoot + Bounce — impact squashes past target, then settles
  ✓ "Juicy Mode" toggle in panel (default ON)

Unchanged:
  • Idle segment f1–30 (loop, identity endpoints)
  • Win segment f31–90
  • Endpoints: f1 = f30 = f31 = f90 = IDENTITY
  • Single Root bone, static camera (VR safe), FPS=30
"""

bl_info = {
    "name": "Slot Symbol Animation Generator",
    "author": "VR Slot Dev",
    "version": (1, 2, 0),
    "blender": (4, 2, 0),
    "location": "View3D > N-Panel > Slot Symbol",
    "description": "Generate slot symbol rig + juicy idle/win actions",
    "category": "Animation",
}

import bpy
import math
import random
from bpy.props import BoolProperty, IntProperty, FloatProperty, StringProperty
from bpy.types import Panel, PropertyGroup

try:
    from bpy_extras import anim_utils
    _HAS_ANIM_UTILS = True
except ImportError:
    _HAS_ANIM_UTILS = False


# ==========================================================
# CONSTANTS
# ==========================================================
FPS         = 30
RANDOM_SEED = 42


# ==========================================================
# HELPERS
# ==========================================================
def _is_blender_5_plus():
    return bpy.app.version >= (5, 0, 0)


def _version_string():
    v = bpy.app.version
    return f"{v[0]}.{v[1]}.{v[2]}"


def _ensure_object_mode():
    obj = bpy.context.object
    if obj and obj.mode != 'OBJECT':
        try:
            bpy.ops.object.mode_set(mode='OBJECT')
        except Exception:
            pass


def _get_rig():
    return bpy.data.objects.get("SymbolRig")


def _iter_fcurves(action):
    if hasattr(action, "fcurves"):
        try:
            for fc in action.fcurves:
                yield fc
            return
        except Exception:
            pass
    if _HAS_ANIM_UTILS:
        try:
            for slot in action.slots:
                cb = anim_utils.action_ensure_channelbag_for_slot(action, slot)
                if cb is not None:
                    for fc in cb.fcurves:
                        yield fc
        except Exception:
            pass


def _assign_action_with_slot(rig, act):
    ad = rig.animation_data
    ad.action = act
    if _is_blender_5_plus() and hasattr(ad, "action_slot"):
        if act.slots:
            ad.action_slot = act.slots[0]
        else:
            slot = act.slots.new(id_type='OBJECT', name=rig.name)
            ad.action_slot = slot


# ==========================================================
# CREATE SYMBOL
# ==========================================================
def create_symbol():
    if _get_rig() is not None:
        return "SymbolRig already exists"

    _ensure_object_mode()
    random.seed(RANDOM_SEED)

    arm_data = bpy.data.armatures.new("SymbolArmature")
    arm_obj  = bpy.data.objects.new("SymbolRig", arm_data)
    bpy.context.collection.objects.link(arm_obj)

    bpy.ops.object.select_all(action='DESELECT')
    arm_obj.select_set(True)
    bpy.context.view_layer.objects.active = arm_obj

    bpy.ops.object.mode_set(mode='EDIT')
    eb   = arm_data.edit_bones
    root = eb.new("Root")
    root.head = (0, 0, 0)
    root.tail = (0, -0.5, 0)
    bpy.ops.object.mode_set(mode='OBJECT')

    bpy.ops.mesh.primitive_uv_sphere_add(radius=0.28, location=(0, 0, 0))
    mesh = bpy.context.active_object
    mesh.name = "SymbolMesh"
    bpy.ops.object.shade_smooth()

    bpy.ops.object.select_all(action='DESELECT')
    mesh.select_set(True)
    arm_obj.select_set(True)
    bpy.context.view_layer.objects.active = arm_obj
    bpy.ops.object.parent_set(type='ARMATURE_AUTO')

    scene = bpy.context.scene
    if scene.camera is None:
        bpy.ops.object.camera_add(location=(0, -2.5, 0.5))
        cam = bpy.context.active_object
        cam.name = "VR_StaticCamera"
        cam.rotation_euler = (math.radians(85), 0.0, 0.0)
        cam.data.lens = 50
        scene.camera = cam

    scene.render.fps      = FPS
    scene.render.fps_base = 1.0
    scene.frame_start     = 1
    scene.frame_end       = 90

    return f"Symbol created  [{_version_string()}]"


# ==========================================================
# CREATE ACTIONS
# ==========================================================
def create_actions(rig, num_actions, idle_end, win_start, win_end,
                   win_forward, juicy_mode=True):
    rig.animation_data_create()
    random.seed(RANDOM_SEED)

    def reset_pose():
        for pb in rig.pose.bones:
            pb.rotation_mode  = 'XYZ'
            pb.location       = (0, 0, 0)
            pb.rotation_euler = (0, 0, 0)
            pb.scale          = (1, 1, 1)

    def key_full(frame, loc=(0, 0, 0), rot=(0, 0, 0), scl=(1, 1, 1)):
        pb = rig.pose.bones["Root"]
        pb.location       = loc
        pb.rotation_mode  = 'XYZ'
        pb.rotation_euler = rot
        pb.scale          = scl
        pb.keyframe_insert("location",       frame=frame)
        pb.keyframe_insert("rotation_euler", frame=frame)
        pb.keyframe_insert("scale",          frame=frame)

    def make_cyclic(action):
        for fc in _iter_fcurves(action):
            for kp in fc.keyframe_points:
                kp.interpolation     = 'BEZIER'
                kp.handle_left_type  = 'AUTO_CLAMPED'
                kp.handle_right_type = 'AUTO_CLAMPED'
            mod = fc.modifiers.new('CYCLES')
            mod.mode_before = 'REPEAT'
            mod.mode_after  = 'REPEAT'

    rig.animation_data.action = None
    for tr in list(rig.animation_data.nla_tracks):
        rig.animation_data.nla_tracks.remove(tr)

    created = 0
    for idx in range(1, num_actions + 1):
        name = f"Symbol_{idx:02d}"

        old = bpy.data.actions.get(name)
        if old:
            try:
                bpy.data.actions.remove(old, do_unlink=True)
            except Exception:
                pass

        act = bpy.data.actions.new(name)
        act.use_fake_user = True
        _assign_action_with_slot(rig, act)
        reset_pose()

        # ---- Randomised parameters ----
        phase_i    = idx * (2 * math.pi / num_actions)
        phase_w    = idx * (2 * math.pi / num_actions) + math.pi * 0.37
        idle_inten = 0.75 + 0.50 * random.random()
        idle_speed = 0.85 + 0.30 * random.random()
        win_inten  = 0.85 + 0.40 * random.random()
        win_fwd    = win_forward * (0.7 + 0.6 * random.random())
        win_peak_s = 1.12 + 0.10 * random.random()
        spin_dir   = 1.0 if (idx % 2 == 0) else -1.0

        # ==================================================
        # IDLE SEGMENT  (unchanged)
        # ==================================================
        key_full(1, (0, 0, 0), (0, 0, 0), (1, 1, 1))
        for f in (8, 15, 22):
            if f >= idle_end:
                continue
            t    = (f - 1) / max(idle_end - 1, 1)
            bob  = math.sin(t * 2*math.pi * idle_speed + phase_i)       * 0.03 * idle_inten
            sway = math.sin(t * 2*math.pi * idle_speed + phase_i + 1.0) * 0.02 * idle_inten
            spin = math.sin(t * 2*math.pi * idle_speed + phase_i)       * 0.08 * idle_inten
            key_full(f, (0, 0, bob), (sway, 0, spin), (1, 1, 1))
        key_full(idle_end, (0, 0, 0), (0, 0, 0), (1, 1, 1))

        # ==================================================
        # WIN SEGMENT
        # ==================================================
        span = max(win_end - win_start, 1)

        if juicy_mode:
            # ----------------------------------------------
            # JUICY: squash-stretch + anticipation + overshoot
            # ----------------------------------------------
            base_spin = spin_dir * math.pi * math.sin(phase_w)

            # (t,  fwd_ratio, up,  (sx,   sy,   sz ),  spin_ratio)
            win_keys = [
                (0.00,  0.00,  0.00, (1.00, 1.00, 1.00),  0.00),  # identity
                (0.10, -0.10,  0.00, (1.15, 1.00, 0.88), -0.15),  # anticipation (back+squash)
                (0.30,  0.75,  0.10, (0.82, 1.00, 1.22),  0.70),  # rush (stretch tall)
                (0.50,  1.08,  0.05, (1.25, 1.00, 0.80),  1.00),  # impact (squash+overshoot)
                (0.62,  0.92,  0.00, (1.05, 1.00, 0.98),  1.15),  # bounce settle
                (0.80,  0.35,  0.06, (0.88, 1.00, 1.14),  0.60),  # return stretch
                (0.92, -0.03,  0.00, (1.06, 1.00, 0.94), -0.05),  # return overshoot
                (1.00,  0.00,  0.00, (1.00, 1.00, 1.00),  0.00),  # identity
            ]

            prev_frame = win_start - 1
            for t, fwd_r, up, scl, spin_r in win_keys:
                frame = win_start + int(round(span * t))
                if frame > win_end:
                    frame = win_end
                if frame <= prev_frame:
                    frame = prev_frame + 1
                    if frame > win_end:
                        break
                prev_frame = frame

                loc = (0.0, win_fwd * fwd_r, up * win_inten)
                rot = (0.0, 0.0, base_spin * spin_r)
                key_full(frame, loc, rot, scl)
        else:
            # ----------------------------------------------
            # CLASSIC: uniform scale, straight forward move
            # ----------------------------------------------
            p1 = win_start + int(span * 0.23)
            p2 = win_start + int(span * 0.50)
            p3 = win_start + int(span * 0.77)

            key_full(win_start, (0, 0, 0), (0, 0, 0), (1, 1, 1))
            key_full(p1,
                     (0, win_fwd * 0.35, 0.12 * win_inten),
                     (0, 0, spin_dir * math.pi * 0.5 * math.sin(phase_w)),
                     (1.05, 1.05, 1.05))
            key_full(p2,
                     (0, win_fwd, 0.05),
                     (0, 0, spin_dir * math.pi * math.sin(phase_w)),
                     (win_peak_s, win_peak_s, win_peak_s))
            key_full(p3,
                     (0, win_fwd * 0.30, 0.08 * win_inten),
                     (0, 0, spin_dir * math.pi * 1.5 * math.sin(phase_w)),
                     (1.05, 1.05, 1.05))
            key_full(win_end, (0, 0, 0), (0, 0, 0), (1, 1, 1))

        make_cyclic(act)
        created += 1

    # ---- NLA pushdown ----
    rig.animation_data.action = None
    for idx in range(1, num_actions + 1):
        name = f"Symbol_{idx:02d}"
        act  = bpy.data.actions.get(name)
        if not act:
            continue
        track = rig.animation_data.nla_tracks.new()
        track.name = name
        strip = track.strips.new(name, 1, act)
        strip.name = name
        try:
            if _is_blender_5_plus() and hasattr(strip, "action_slot") and act.slots:
                strip.action_slot = act.slots[0]
        except Exception:
            pass

    # ---- Reset pose ----
    bpy.context.view_layer.objects.active = rig
    bpy.ops.object.mode_set(mode='POSE')
    bpy.ops.pose.select_all(action='SELECT')
    bpy.ops.pose.transforms_clear()
    bpy.ops.object.mode_set(mode='OBJECT')

    mode = "Juicy" if juicy_mode else "Classic"
    return f"Created {created} actions [{mode}]  [{_version_string()}]"


# ==========================================================
# UPDATE CALLBACKS
# ==========================================================
def _update_create_symbol(self, context):
    if not self.create_symbol:
        return
    self.create_symbol = False
    try:
        _ensure_object_mode()
        self.status = create_symbol()
    except Exception as e:
        self.status = f"ERROR: {e}"


def _update_create_actions(self, context):
    if not self.create_actions:
        return
    self.create_actions = False
    try:
        rig = _get_rig()
        if rig is None:
            self.status = "ERROR: Create Symbol first!"
            return
        _ensure_object_mode()
        self.status = create_actions(
            rig,
            self.num_actions,
            self.idle_end,
            self.win_start,
            self.win_end,
            self.win_forward,
            self.juicy_mode,
        )
    except Exception as e:
        self.status = f"ERROR: {e}"


# ==========================================================
# PROPERTY GROUP
# ==========================================================
class SlotSymbolSettings(PropertyGroup):

    create_symbol: BoolProperty(
        name="Create Symbol",
        description="Generate 3D symbol with single-bone rig",
        default=False,
        update=_update_create_symbol,
    )

    create_actions: BoolProperty(
        name="Create Actions",
        description="Generate all idle+win animation actions",
        default=False,
        update=_update_create_actions,
    )

    juicy_mode: BoolProperty(
        name="Juicy Mode",
        description="Squash-stretch + anticipation/overshoot (cartoony pop)",
        default=True,
    )

    num_actions: IntProperty(
        name="Actions",
        description="Number of animation variations",
        default=24, min=1, max=200,
    )

    idle_end: IntProperty(
        name="Idle End Frame",
        default=30, min=2, max=500,
    )

    win_start: IntProperty(
        name="Win Start Frame",
        default=31, min=2, max=500,
    )

    win_end: IntProperty(
        name="Win End Frame",
        default=90, min=3, max=1000,
    )

    win_forward: FloatProperty(
        name="Forward Distance (m)",
        default=0.40, min=0.01, max=2.0,
    )

    status: StringProperty(
        name="Status",
        default="Ready",
    )


# ==========================================================
# UI PANEL
# ==========================================================
class SLOTSYMBOL_PT_main(Panel):
    bl_label       = "Slot Symbol Generator"
    bl_idname      = "SLOTSYMBOL_PT_main"
    bl_space_type  = 'VIEW_3D'
    bl_region_type = 'UI'
    bl_category    = "Slot Symbol"

    def draw(self, context):
        layout = self.layout
        s = context.scene.slot_symbol_settings

        header = layout.box()
        hrow   = header.row()
        hrow.label(text="3D Slot Symbol Tools", icon='ARMATURE_DATA')

        act_box = layout.box()
        acol = act_box.column(align=True)
        acol.scale_y = 1.35
        acol.prop(s, "create_symbol",  text="Create Symbol",  icon='MESH_UVSPHERE')
        acol.prop(s, "create_actions", text="Create Actions", icon='ACTION')

        # ---- Style toggle ----
        layout.separator(factor=0.5)
        style = layout.box()
        sc = style.column(align=True)
        sc.label(text="Animation Style", icon='SHADERFX')
        sc.separator(factor=0.3)
        sc.prop(s, "juicy_mode", text="Juicy (Squash + Overshoot)")

        layout.separator(factor=0.6)
        sett = layout.box()
        scol = sett.column(align=True)
        scol.label(text="Settings", icon='PREFERENCES')
        scol.separator(factor=0.4)
        scol.prop(s, "num_actions")
        scol.prop(s, "idle_end",    text="Idle End Frame")
        scol.prop(s, "win_start",   text="Win Start Frame")
        scol.prop(s, "win_end",     text="Win End Frame")
        scol.prop(s, "win_forward", text="Forward (m)")

        layout.separator(factor=0.6)
        info = layout.box()
        icol = info.column(align=True)
        icol.label(text="Timeline Layout", icon='INFO')
        icol.separator(factor=0.3)
        icol.scale_y = 0.85
        icol.label(text=f"Idle : f1 → f{s.idle_end}   (loop)")
        icol.label(text=f"Win  : f{s.win_start} → f{s.win_end}")
        icol.label(text="Endpoints = IDENTITY:")
        icol.label(text=f"   f1 = f{s.idle_end} = f{s.win_start} = f{s.win_end}")
        icol.label(text="Camera : static  (VR-safe)")
        icol.label(text="Bones  : 1 (Root)   FPS : 30")

        layout.separator(factor=0.6)
        compat = layout.box()
        ccol = compat.column(align=True)
        ccol.label(text="Compatibility", icon='BLENDER')
        ccol.scale_y = 0.85
        ccol.label(text=f"Blender: {_version_string()}")
        if _is_blender_5_plus():
            ccol.label(text="API: Slotted Actions (5.x)  ✓")
        else:
            ccol.label(text="API: Legacy fcurves (4.x)  ✓")

        layout.separator(factor=0.6)
        stat = layout.box()
        icon = 'ERROR' if s.status.startswith("ERROR") else 'CHECKMARK'
        stat.label(text=f"Status: {s.status}", icon=icon)


# ==========================================================
# REGISTER
# ==========================================================
_classes = (SlotSymbolSettings, SLOTSYMBOL_PT_main)


def register():
    for cls in _classes:
        bpy.utils.register_class(cls)
    bpy.types.Scene.slot_symbol_settings = bpy.props.PointerProperty(
        type=SlotSymbolSettings
    )


def unregister():
    if hasattr(bpy.types.Scene, "slot_symbol_settings"):
        del bpy.types.Scene.slot_symbol_settings
    for cls in reversed(_classes):
        bpy.utils.unregister_class(cls)


if __name__ == "__main__":
    register()
