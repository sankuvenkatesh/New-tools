# ---------------------------------------------------------------------------
# Production Frame Architecture
# ---------------------------------------------------------------------------
FPS = 30
RIG_NAME = "SymbolRig"
MESH_NAME = "SymbolCube"
ROOT_BONE = "Root"

# పర్ఫెక్ట్ లూప్ టైమింగ్స్
IDLE_PERIOD = 50   # 1 to 50 frames
WIN_DURATION = 100 # 51 to 151 frames
TOTAL_FRAMES = IDLE_PERIOD + WIN_DURATION + 1 # 151 frames total

IDLE_STYLES = (
    "FloatingSpin", "HoverDance", "JumpingIdle", "Lean",
    "Orbit", "PulsingIdle", "Rocking", "Shake",
    "SideHop", "SpinningIdle", "SpringBounce", "SquashStretchIdle",
    "TiltingIdle", "Tumble", "Twist", "WobbleIdle"
)

_ROOT_PROPS = ("location", "rotation_euler", "scale")

# ---------------------------------------------------------------------------
# Envelopes (The Magic behind the smooth transition)
# ---------------------------------------------------------------------------
def ease_in_out(q):
    return q * q * (3.0 - 2.0 * q)

def get_travel_envelope(t_win):
    """0.0 నుండి 1.0 వరకు వెళ్ళే విన్ టైమ్‌లో, సింబల్ ఎప్పుడు ముందుకు రావాలి, ఎప్పుడు వెనక్కి వెళ్ళాలి"""
    if t_win <= 0.0: return 0.0
    
    if t_win < 0.15: # 15% Time: ముందుకు రావడం (Travel Forward)
        return ease_in_out(t_win / 0.15)
    elif t_win < 0.85: # 70% Time: కెమెరా ముందే ఉండి యాక్షన్ చేయడం (Hold)
        return 1.0
    elif t_win < 1.0: # 15% Time: వెనక్కి వెళ్లిపోవడం (Return to Origin)
        return 1.0 - ease_in_out((t_win - 0.85) / 0.15)
    return 0.0

def get_squash_stretch(t_win):
    """కెమెరా ముందుకు వచ్చేటప్పుడు జ్యూసీ ఫీల్ (Juicy feel) కోసం స్క్వాష్ & స్ట్రెచ్"""
    if t_win <= 0.0 or t_win >= 1.0: 
        return (1.0, 1.0, 1.0)
    
    if t_win < 0.15: # గాలిలో ముందుకు వస్తున్నప్పుడు సాగడం (Stretch)
        q = math.sin((t_win / 0.15) * math.pi)
        return (1.0 - 0.1*q, 1.0 + 0.3*q, 1.0 - 0.1*q)
    elif t_win < 0.35: # ఆగిన వెంటనే నొక్కుకుపోవడం (Impact Squash Wobble)
        q = (t_win - 0.15) / 0.20
        w = math.cos(q * math.pi * 3.0) * (1.0 - q) # తగ్గుతూ వచ్చే వైబ్రేషన్
        return (1.0 + 0.2*w, 1.0 - 0.3*w, 1.0 + 0.2*w)
    elif t_win > 0.85: # వెనక్కి వెళ్లేటప్పుడు మళ్ళీ సాగడం (Return Stretch)
        q = math.sin(((t_win - 0.85) / 0.15) * math.pi)
        return (1.0 - 0.1*q, 1.0 + 0.2*q, 1.0 - 0.1*q)
        
    return (1.0, 1.0, 1.0)

# ---------------------------------------------------------------------------
# Base Continuous Math Motions (Pure 16 Styles)
# ---------------------------------------------------------------------------
def _idle_base(style, t, variant):
    """
    t అనేది కంటిన్యూయస్ టైమ్ (ఉదాహరణకు 0.0 నుండి 3.0 వరకు). 
    దీనివల్ల ఐడిల్ మరియు విన్ మధ్యలో యానిమేషన్ కట్ అవ్వదు!
    """
    p = 2.0 * math.pi * t
    phase = variant * 0.37
    wave = math.sin(p)
    wave2 = math.sin(2.0 * p)
    
    wx = wy = wz = 0.0
    wrx = wry = wrz = 0.0
    wsx = wsy = wsz = 1.0

    if style == "FloatingSpin":
        wz = 0.10 * wave
        wrz = t * (2.0 * math.pi) # స్మూత్ గా కంటిన్యూయస్ 360 స్పిన్
    elif style == "HoverDance":
        wx = 0.15 * math.sin(p + phase)
        wz = 0.10 * wave2
        wry = 0.15 * wave
    elif style == "JumpingIdle":
        wz = 0.25 * max(0.0, wave)
        wsx = wsy = 1.0 + 0.1 * math.sin(2.0 * p + math.pi)
        wsz = 1.0 - 0.15 * math.sin(2.0 * p + math.pi)
    elif style == "Lean":
        wrx = 0.25 + 0.05 * wave
        wry = 0.10 * math.sin(p * 2.0)
    elif style == "Orbit":
        wx = 0.20 * math.cos(p)
        wz = 0.10 * math.sin(2.0 * p)
        wry = 0.15 * wave
    elif style == "PulsingIdle":
        wsx = wsy = 1.0 + 0.15 * wave
        wsz = 1.0 - 0.15 * wave
    elif style == "Rocking":
        wrx = 0.35 * wave
        wz = 0.05 * wave2
    elif style == "Shake":
        wx = 0.08 * math.sin(4.0 * p)
        wrz = 0.15 * math.sin(5.0 * p)
    elif style == "SideHop":
        wx = 0.20 * wave
        wz = 0.15 * max(0.0, wave2)
        wrz = 0.20 * wave
    elif style == "SpinningIdle":
        wrz = t * (4.0 * math.pi) # డబుల్ స్పీడ్ స్పిన్
    elif style == "SpringBounce":
        wz = 0.25 * abs(wave)
        wsx = wsy = 1.0 - 0.1 * abs(wave)
        wsz = 1.0 + 0.2 * abs(wave)
    elif style == "SquashStretchIdle":
        wsx = wsy = 1.0 + 0.20 * wave
        wsz = 1.0 - 0.25 * wave
    elif style == "TiltingIdle":
        wry = 0.30 * wave
        wrx = 0.15 * math.sin(p + 1.5)
    elif style == "Tumble":
        wrx = t * (2.0 * math.pi) # కంటిన్యూయస్ ఫ్రంట్ ఫ్లిప్
    elif style == "Twist":
        wrz = 0.60 * wave
        wry = 0.15 * wave2
    elif style == "WobbleIdle":
        wrx = 0.25 * wave
        wry = 0.25 * math.sin(p + 1.5)

    return wx, wy, wz, wrx, wry, wrz, wsx, wsy, wsz

def world_to_bone_space(wx, wy, wz, wrx, wry, wrz, wsx, wsy, wsz):
    """World Space నుండి Vertical Bone Space కి పర్ఫెక్ట్ మ్యాపింగ్"""
    return (wx, wz, wy), (wrx, wrz, wry), (wsx, wsz, wsy)

# ---------------------------------------------------------------------------
# The Master Evaluator (Combines everything perfectly)
# ---------------------------------------------------------------------------
def _evaluate_frame(style, variant, frame, travel_y, idle_intensity, win_intensity):
    # 1. టైమ్ క్యాలిక్యులేషన్ (Time Calculation)
    t_continuous = (frame - 1) / float(IDLE_PERIOD)
    
    t_win = 0.0
    if frame > IDLE_PERIOD + 1:
        t_win = (frame - (IDLE_PERIOD + 1)) / float(WIN_DURATION)
        t_win = max(0.0, min(1.0, t_win))

    # 2. బేస్ మోషన్ అండ్ జీరోయింగ్ (Base motion & Zeroing for perfect loop)
    bx, by, bz, brx, bry, brz, bsx, bsy, bsz = _idle_base(style, t_continuous, variant)
    b0x, b0y, b0z, b0rx, b0ry, b0rz, b0sx, b0sy, b0sz = _idle_base(style, 0.0, variant)

    wx = bx - b0x
    wy = by - b0y
    wz = bz - b0z
    wrx = brx - b0rx
    wry = bry - b0ry
    wrz = brz - b0rz
    
    dsx = (bsx / b0sx) - 1.0
    dsy = (bsy / b0sy) - 1.0
    dsz = (bsz / b0sz) - 1.0

    # 3. విన్ ఎన్వలప్ మరియు ఇంటెన్సిటీ (Win Envelope & Intensity)
    env = get_travel_envelope(t_win)
    current_intensity = idle_intensity + (win_intensity - idle_intensity) * env

    wx *= current_intensity
    wy *= current_intensity
    wz *= current_intensity
    wrx *= current_intensity
    wry *= current_intensity
    wrz *= current_intensity
    
    wsx = 1.0 + (dsx * current_intensity)
    wsy = 1.0 + (dsy * current_intensity)
    wsz = 1.0 + (dsz * current_intensity)

    # 4. ముందుకి రావడం (Apply Forward Travel on World Y)
    wy += travel_y * env

    # 5. జ్యూసీ స్క్వాష్ & స్ట్రెచ్ (Apply Juicy Squash/Stretch)
    ssx, ssy, ssz = get_squash_stretch(t_win)
    wsx *= ssx
    wsy *= ssy
    wsz *= ssz

    # 6. ఫైనల్ బ్రోన్ స్పేస్ మ్యాపింగ్
    return world_to_bone_space(wx, wy, wz, wrx, wry, wrz, wsx, wsy, wsz)


# ---------------------------------------------------------------------------
# Rig & Curve Baking Helpers
# ---------------------------------------------------------------------------
def _bake_curves(rig, action, samples):
    for prop_index, prop in enumerate(_ROOT_PROPS):
        data_path = f'pose.bones["{ROOT_BONE}"].{prop}'
        for axis in range(3):
            if hasattr(action, "fcurve_ensure_for_datablock"):
                fc = action.fcurve_ensure_for_datablock(rig, data_path, index=axis, group_name=ROOT_BONE)
            else:
                fc = action.fcurves.find(data_path, index=axis)
                if fc is None:
                    fc = action.fcurves.new(data_path, index=axis, action_group=ROOT_BONE)

            for frame, pose in samples:
                fc.keyframe_points.insert(frame, pose[prop_index][axis], options={'FAST'})
                
            for key in fc.keyframe_points:
                key.interpolation = 'BEZIER'
                key.handle_left_type = 'AUTO'
                key.handle_right_type = 'AUTO'
            
            fc.update()

def create_symbol():
    if bpy.data.objects.get(RIG_NAME) is not None:
        raise RuntimeError("SymbolRig already exists. Delete it first.")

    if bpy.context.object and bpy.context.object.mode != 'OBJECT':
        bpy.ops.object.mode_set(mode='OBJECT')
        
    context, scene, collection = bpy.context, bpy.context.scene, bpy.context.collection

    arm_data = bpy.data.armatures.new("SymbolArmature")
    arm_data.display_type = 'OCTAHEDRAL'
    arm_data.show_axes = True

    rig = bpy.data.objects.new(RIG_NAME, arm_data)
    collection.objects.link(rig)

    bpy.ops.object.select_all(action='DESELECT')
    rig.select_set(True)
    context.view_layer.objects.active = rig
    bpy.ops.object.mode_set(mode='EDIT')
    try:
        bone = arm_data.edit_bones.new(ROOT_BONE)
        bone.head = (0.0, 0.0, 0.0)
        bone.tail = (0.0, 0.0, 1.0) # Vertical Bone
        bone.roll = 0.0
        bone.use_deform = True
    finally:
        bpy.ops.object.mode_set(mode='OBJECT')

    bpy.ops.mesh.primitive_cube_add(size=0.58, location=(0.0, 0.0, 0.0))
    mesh = context.object
    mesh.name = MESH_NAME
    mesh.data.name = "SymbolCubeMesh"
    
    bpy.ops.object.shade_smooth()

    mesh.parent = rig
    group = mesh.vertex_groups.new(name=ROOT_BONE)
    if mesh.data.vertices:
        group.add([v.index for v in mesh.data.vertices], 1.0, 'REPLACE')

    arm_mod = mesh.modifiers.new("Armature", 'ARMATURE')
    arm_mod.object = rig
    arm_mod.use_vertex_groups = True

    bevel = mesh.modifiers.new("Soft Rounded Edges", 'BEVEL')
    bevel.width = 0.055
    bevel.segments = 4
    bevel.limit_method = 'ANGLE'

    weighted = mesh.modifiers.new("Weighted Corner Normals", 'WEIGHTED_NORMAL')
    weighted.keep_sharp = True

    if scene.camera is None:
        camera_data = bpy.data.cameras.new("VR_StaticCamera")
        camera_data.lens = 50
        camera = bpy.data.objects.new("VR_StaticCamera", camera_data)
        collection.objects.link(camera)
        camera.location = (0.0, -2.5, 0.45)
        camera.rotation_euler = (math.radians(82.0), 0.0, 0.0)
        scene.camera = camera

    scene.render.fps = FPS
    scene.frame_start = 1
    scene.frame_end = TOTAL_FRAMES

    bpy.ops.object.select_all(action='DESELECT')
    rig.select_set(True)
    context.view_layer.objects.active = rig
    scene.frame_set(1)
    return f"Created Rig & Cube successfully! [{_version_string()}]"

def create_animations(rig, travel_y, idle_intensity, win_intensity):
    if rig is None or rig.type != 'ARMATURE' or ROOT_BONE not in rig.pose.bones:
        raise RuntimeError("Create the Symbol Cube rig first.")

    ad = rig.animation_data_create()
    ad.action = None
    pb = rig.pose.bones[ROOT_BONE]
    
    pb.rotation_mode = 'XYZ'
    pb.location = pb.rotation_euler = (0.0, 0.0, 0.0)
    pb.scale = (1.0, 1.0, 1.0)
    
    created = 0

    try:
        for style_index, style in enumerate(IDLE_STYLES):
            action_name = f"Anim_{style}"
            old = bpy.data.actions.get(action_name)
            if old: bpy.data.actions.remove(old, do_unlink=True)
            
            action = bpy.data.actions.new(action_name)
            action.use_fake_user = True
            ad.action = action
            
            samples = []
            # ఫ్రేమ్ 1 నుండి 151 వరకు ప్రతి ఫ్రేమ్ ని ఎవాల్యూయేట్ చేస్తున్నాం
            for frame in range(1, TOTAL_FRAMES + 1):
                pose = _evaluate_frame(style, style_index + 1, frame, travel_y, idle_intensity, win_intensity)
                samples.append((frame, pose))
                
            _bake_curves(rig, action, samples)
            
            if hasattr(action, "use_frame_range"):
                action.use_frame_range = True
                action.frame_start = 1
                action.frame_end = TOTAL_FRAMES
                
            created += 1

    finally:
        ad.action = None
        pb.location = pb.rotation_euler = (0.0, 0.0, 0.0)
        pb.scale = (1.0, 1.0, 1.0)

    return f"Created {created} Master Actions (1-{TOTAL_FRAMES} frames)!"

# ---------------------------------------------------------------------------
# Settings & UI
# ---------------------------------------------------------------------------
class SlotSymbolSettings(PropertyGroup):
    win_travel_y: FloatProperty(
        name="Forward Pop Distance",
        description="How far the object pops towards the camera (Local Z Axis)",
        default=0.80, min=0.01, max=5.0, unit='LENGTH',
    )
    idle_intensity: FloatProperty(
        name="Idle Intensity",
        description="Multiplier for idle animation movements",
        default=1.0, min=0.1, max=5.0,
    )
    win_intensity: FloatProperty(
        name="Win Intensity",
        description="Multiplier for win animation exaggerations",
        default=1.3, min=0.1, max=5.0,
    )
    status: StringProperty(name="Status", default="Ready")

class SLOTSYMBOL_OT_create_symbol(Operator):
    bl_idname = "slotsymbol.create_symbol"
    bl_label = "Create Symbol Cube"
    bl_description = "Create a beveled cube driven by a standard vertical single-bone Root rig"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        try:
            context.scene.slot_symbol_settings.status = create_symbol()
        except Exception as exc:
            traceback.print_exc()
            context.scene.slot_symbol_settings.status = f"ERROR: {exc}"
            self.report({'ERROR'}, str(exc))
            return {'CANCELLED'}
        return {'FINISHED'}

class SLOTSYMBOL_OT_create_animations(Operator):
    bl_idname = "slotsymbol.create_animations"
    bl_label = "Generate 16 Master Actions"
    bl_description = "Generates seamless 151-frame actions combining Idle & Forward Win"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        settings = context.scene.slot_symbol_settings
        try:
            settings.status = create_animations(
                bpy.data.objects.get(RIG_NAME),
                settings.win_travel_y,
                settings.idle_intensity,
                settings.win_intensity
            )
        except Exception as exc:
            traceback.print_exc()
            settings.status = f"ERROR: {exc}"
            self.report({'ERROR'}, str(exc))
            return {'CANCELLED'}
        return {'FINISHED'}

class SLOTSYMBOL_PT_main(Panel):
    bl_label = "Slot Symbol Generator"
    bl_idname = "SLOTSYMBOL_PT_main"
    bl_space_type = 'VIEW_3D'
    bl_region_type = 'UI'
    bl_category = "Slot Symbol"

    def draw(self, context):
        layout = self.layout
        settings = context.scene.slot_symbol_settings

        box = layout.box()
        row = box.row()
        row.alignment = 'CENTER'
        row.label(text="SLOT SYMBOL GENERATOR", icon='ACTION') 

        col = layout.column(align=True)
        col.scale_y = 1.3
        col.operator("slotsymbol.create_symbol", text="1. Create Rig & Cube", icon='ARMATURE_DATA')

        layout.separator()

        box = layout.box()
        box.label(text="Win Animation", icon='OPTIONS')
        col = box.column(align=True)
        col.use_property_split = True
        col.use_property_decorate = False
        col.prop(settings, "win_travel_y")

        box = layout.box()
        box.label(text="Intensities", icon='MODIFIER')
        col = box.column(align=True)
        col.use_property_split = True
        col.use_property_decorate = False
        col.prop(settings, "idle_intensity")
        col.prop(settings, "win_intensity")

        box = layout.box()
        box.label(text="Perfect Frame Timing", icon='TIME')
        col = box.column(align=True)
        col.label(text=f"• Idle Loop: 1 to 50")
        col.label(text=f"• Win Action: 51 to 151")

        layout.separator()

        col = layout.column(align=True)
        col.scale_y = 1.5
        col.operator("slotsymbol.create_animations", text="2. Generate Actions", icon='PLAY')

        if settings.status != "Ready":
            layout.separator()
            row = layout.row()
            row.alert = settings.status.startswith("ERROR")
            row.label(text=settings.status, icon='ERROR' if row.alert else 'CHECKMARK')

_CLASSES = (
    SlotSymbolSettings,
    SLOTSYMBOL_OT_create_symbol,
    SLOTSYMBOL_OT_create_animations,
    SLOTSYMBOL_PT_main,
)

def register():
    for cls in _CLASSES:
        bpy.utils.register_class(cls)
    bpy.types.Scene.slot_symbol_settings = bpy.props.PointerProperty(type=SlotSymbolSettings)

def unregister():
    if hasattr(bpy.types.Scene, "slot_symbol_settings"):
        del bpy.types.Scene.slot_symbol_settings
    for cls in reversed(_CLASSES):
        bpy.utils.unregister_class(cls)

if __name__ == "__main__":
    try: unregister()
    except: pass
    register()
