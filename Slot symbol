        col.prop(settings, "win_travel_y")

        box = layout.box()
        box.label(text="Global Intensities", icon='MODIFIER')
        col = box.column(align=True)
        col.use_property_split = True
        col.use_property_decorate = False
        col.prop(settings, "idle_intensity")
        col.prop(settings, "win_intensity")

        box = layout.box()
        box.label(text="Action Frame Ranges", icon='TIME')
        col = box.column(align=True)
        col.label(text=f"• Idle Loop: {IDLE_START} to {IDLE_END}")
        col.label(text=f"• Win Action: {WIN_START} to {WIN_END}")
        col.label(text="• Single Action (1-106) per style")

        layout.separator()

        col = layout.column(align=True)
        col.scale_y = 1.5
        col.operator("slotsymbol.create_animations", text="2. Generate Animations", icon='PLAY')

        if settings.status != "Ready":
            layout.separator()
            row = layout.row()
            row.alert = settings.status.startswith("ERROR")
            row.label(text=settings.status, icon='ERROR' if row.alert else 'CHECKMARK')

_CLASSES = (
    SlotSymbolSettings,
    SLOTSYMBOL_OT_create_symbol,
    SLOTSYMBOL_OT_create_animations,
    SLOTSYMBOL_PT_main,
)

def register():
    for cls in _CLASSES:
        bpy.utils.register_class(cls)
    bpy.types.Scene.slot_symbol_settings = bpy.props.PointerProperty(
        type=SlotSymbolSettings
    )

def unregister():
    if hasattr(bpy.types.Scene, "slot_symbol_settings"):
        del bpy.types.Scene.slot_symbol_settings
    for cls in reversed(_CLASSES):
        bpy.utils.unregister_class(cls)

if __name__ == "__main__":
    try:
        unregister()
    except Exception:
        pass
    register()
