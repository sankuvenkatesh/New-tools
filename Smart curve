class ROTATION_OT_smart_euler_filter(bpy.types.Operator):
    """Smart Euler Filter - Works on selected rotation curves OR all rotation curves"""
    bl_idname = "graph.smart_euler_filter"
    bl_label = "Smart Euler Filter"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        fcurves = get_graph_fcurves(context)
        if not fcurves:
            self.report({'ERROR'}, "No F-Curves found")
            return {'CANCELLED'}

        entity, rot_mode, rna_path_prefix = get_selection_info(context)
        if not entity:
            self.report({'ERROR'}, "No active object or pose bone")
            return {'CANCELLED'}

        if rot_mode == "QUATERNION":
            mode_code = "QUATERNION"
        elif rot_mode in {"XYZ", "XZY", "YXZ", "YZX", "ZXY", "ZYX"}:
            mode_code = "EULER"
        else:
            mode_code = "EULER"

        rotation_fcurves_all, err = get_rotation_fcurves(mode_code, fcurves, rna_path_prefix)
        if rotation_fcurves_all is None:
            self.report({'ERROR'}, err)
            return {'CANCELLED'}

        # FIXED: If user selected specific rotation channels, use only those. Otherwise use all.
        selected_fcurves = [fc for fc in rotation_fcurves_all if getattr(fc, 'select', False)]
        rotation_fcurves = selected_fcurves if selected_fcurves else rotation_fcurves_all

        keyframes = collect_keyframes_with_handles_any(rotation_fcurves)
        if not keyframes:
            self.report({'ERROR'}, "No rotation keyframes found")
            return {'CANCELLED'}

        if mode_code == "EULER":
            unwrapped = unwrap_keyframe_values_euler_any(keyframes)
        else:
            unwrapped = unwrap_keyframe_values_quaternion_any(keyframes)

        preserve_and_update_fcurve_points_any(rotation_fcurves, unwrapped)
        if context.area:
            context.area.tag_redraw()

        self.report({'INFO'}, f"{mode_code} continuity applied to {len(rotation_fcurves)} channel(s) ({'selected' if selected_fcurves else 'all'})")
        return {'FINISHED'}


