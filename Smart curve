class CurveSmoothProperties(bpy.types.PropertyGroup):
    iterations: bpy.props.IntProperty(
        name="Iterations",
        description="Number of smoothing iterations",
        default=5, min=1, max=50
    )
    strength: bpy.props.FloatProperty(
        name="Strength",
        description="Smoothing intensity (0-1) - used by Weighted Average method",
        default=0.5, min=0.0, max=1.0
    )
    sensitivity: bpy.props.FloatProperty(
        name="Sensitivity",
        description="Smoothing sensitivity falloff (Reversed effect, 0-1) - used by Weighted Average method",
        default=0.5, min=0.0, max=1.0
    )
    preserve_ends: bpy.props.BoolProperty(
        name="Preserve Ends",
        description="Do not smooth the first and last selected keyframes",
        default=True
    )

    # --- Smoothing method selection ---
    smoothing_method: bpy.props.EnumProperty(
        name="Method",
        description="Algorithm used for smoothing",
        items=[
            ('WEIGHTED', "Weighted Average", "Original adaptive weighted smoothing"),
            ('MOVING_AVERAGE', "Moving Average", "Simple sliding-window average"),
            ('GAUSSIAN', "Gaussian", "Gaussian-weighted sliding window"),
        ],
        default='WEIGHTED'
    )
    ma_window: bpy.props.IntProperty(
        name="Window Size",
        description="Window size (in keyframes) for Moving Average / Gaussian smoothing",
        default=5, min=3, max=51
    )
    gaussian_sigma: bpy.props.FloatProperty(
        name="Sigma",
        description="Standard deviation for Gaussian smoothing (larger = smoother)",
        default=1.5, min=0.1, max=10.0
    )

    # --- Easing presets ---
    ease_interpolation: bpy.props.EnumProperty(
        name="Interpolation",
        items=EASE_INTERPOLATIONS,
        default='BEZIER'
    )
    ease_mode: bpy.props.EnumProperty(
        name="Easing",
        items=EASE_MODES,
        default='EASE_IN_OUT'
    )

    # --- Quantize keyframe timing ---
    quantize_step: bpy.props.IntProperty(
        name="Step (frames)",
        description="Snap keyframes to the nearest multiple of this many frames (e.g. 2 for 'on 2s')",
        default=4, min=1, max=60
    )

    # --- Remap value range ---
    remap_target_min: bpy.props.FloatProperty(
        name="Target Min",
        description="New minimum value after remapping",
        default=0.0
    )
    remap_target_max: bpy.props.FloatProperty(
        name="Target Max",
        description="New maximum value after remapping",
        default=1.0
    )


class CurveSmoothOperator(bpy.types.Operator):
    """Smooth Selected Keyframes of Selected F-Curves (Advanced)"""
    bl_idname = "graph.smooth_selected_keyframes"
    bl_label = "Smooth Selected Keyframes (Advanced)"
    bl_options = {'REGISTER', 'UNDO', 'PRESET'}

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        smoothed_count = 0
        total_keys = 0
        biggest_move = 0
        curves = getattr(context, "selected_editable_fcurves", [])

        if not curves:
            self.report({'WARNING'}, "No editable F-Curves selected")
            return {'CANCELLED'}

        for fcurve in curves:
            selected_keys = [kp for kp in fcurve.keyframe_points if kp.select_control_point]
            if len(selected_keys) >= 3:
                stats = dispatch_smooth(fcurve, settings, all_keyframes=False)
                set_bezier_and_auto_clamp_handles(fcurve)
                smoothed_count += 1
                total_keys += stats['moved']
                biggest_move = max(biggest_move, stats['max_delta'])

        if smoothed_count == 0:
            self.report({'WARNING'}, "Not enough selected keyframes to smooth")
            return {'CANCELLED'}

        self.report({'INFO'},
                    f"Smoothed {total_keys} keyframes in {smoothed_count} F-Curve(s). Largest change: {biggest_move:.2f}")
        return {'FINISHED'}

class CurveSmoothAllOperator(bpy.types.Operator):
    """Batch Smooth All F-Curves (Advanced)"""
    bl_idname = "graph.smooth_all_keyframes"
    bl_label = "Batch Smooth All F-Curves"
    bl_options = {'REGISTER', 'UNDO', 'PRESET'}

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        smoothed_count = 0
        total_keys = 0
        biggest_move = 0

        fcurves = get_graph_fcurves(context)
        if not fcurves:
            self.report({'WARNING'}, "No F-Curves found")
            return {'CANCELLED'}

        for fcurve in fcurves:
            if len(fcurve.keyframe_points) >= 3:
                stats = dispatch_smooth(fcurve, settings, all_keyframes=True)  # Always process all keyframes in batch mode
                set_bezier_and_auto_clamp_handles(fcurve)
                smoothed_count += 1
                total_keys += stats['moved']
                biggest_move = max(biggest_move, stats['max_delta'])

        if smoothed_count == 0:
            self.report({'WARNING'}, "No F-Curves to smooth")
            return {'CANCELLED'}

        self.report({'INFO'},
                    f"Batch smoothed {total_keys} keyframes in {smoothed_count} F-Curve(s). Largest change: {biggest_move:.2f}")
        return {'FINISHED'}

