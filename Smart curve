class GRAPH_OT_bake_spring_overshoot(bpy.types.Operator):
    """Simulate spring/overshoot dynamics on selected F-Curves and bake the result as new keyframes
    (adds secondary-motion follow-through after fast movement). Rebuilds the curve at the scene's
    frame range, so this replaces existing keyframes on the curve - undo if you don't like the result."""
    bl_idname = "graph.smart_spring_overshoot"
    bl_label = "Bake Spring Overshoot"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        curves = getattr(context, "selected_editable_fcurves", [])
        if not curves:
            self.report({'WARNING'}, "No editable F-Curves selected")
            return {'CANCELLED'}

        scene = context.scene
        frame_start = scene.frame_start
        frame_end = scene.frame_end
        step = max(1, settings.spring_sample_step)

        count = 0
        for fcurve in curves:
            try:
                keyframes = fcurve.keyframe_points
                if len(keyframes) < 2:
                    continue

                frames = list(range(frame_start, frame_end + 1, step))
                if not frames:
                    continue

                original_values = [fcurve.evaluate(f) for f in frames]
                spring_values = simulate_spring(
                    original_values,
                    settings.spring_stiffness,
                    settings.spring_damping,
                    settings.spring_mass,
                    dt=float(step)
                )

                blended = [
                    orig + (spring - orig) * settings.spring_overshoot
                    for orig, spring in zip(original_values, spring_values)
                ]

                for kp in list(keyframes):
                    keyframes.remove(kp)
                for f, v in zip(frames, blended):
                    keyframes.insert(f, v)

                set_bezier_and_auto_clamp_handles(fcurve)
                auto_fix_bad_keyframes(fcurve)
                fcurve.update()
                count += 1
            except Exception:
                continue

        if count == 0:
            self.report({'WARNING'}, "No F-Curves processed")
            return {'CANCELLED'}

        self.report({'INFO'}, f"Baked spring overshoot on {count} F-Curve(s), frames {frame_start}-{frame_end}")
        return {'FINISHED'}


class GRAPH_OT_apply_ease_preset(bpy.types.Operator):
    """Apply an easing/interpolation preset to selected keyframes"""
    bl_idname = "graph.apply_ease_preset"
    bl_label = "Apply Ease Preset"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        curves = getattr(context, "selected_editable_fcurves", [])
        if not curves:
            self.report({'WARNING'}, "No editable F-Curves selected")
            return {'CANCELLED'}

        count = 0
        for fcurve in curves:
            for kp in fcurve.keyframe_points:
                if kp.select_control_point:
                    kp.interpolation = settings.ease_interpolation
                    if settings.ease_interpolation not in {'LINEAR', 'CONSTANT'}:
                        try:
                            kp.easing = settings.ease_mode
                        except Exception:
                            pass
                    count += 1
            fcurve.update()

        if count == 0:
            self.report({'WARNING'}, "No selected keyframes found")
            return {'CANCELLED'}

        self.report({'INFO'}, f"Applied {settings.ease_interpolation} / {settings.ease_mode} to {count} keyframe(s)")
        return {'FINISHED'}


class GRAPH_OT_stagger_keyframes(bpy.types.Operator):
    """Time-offset (and optionally scale) each selected F-Curve by an increasing amount,
    creating a staggered wave / follow-through effect across a chain of curves (e.g. a tail,
    chain of bones, or cloth points). Curves are processed in the order the Graph Editor returns them."""
    bl_idname = "graph.smart_stagger_keyframes"
    bl_label = "Stagger Keyframes"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        curves = list(getattr(context, "selected_editable_fcurves", []))
        if not curves:
            self.report({'WARNING'}, "No editable F-Curves selected")
            return {'CANCELLED'}

        offset_step = settings.stagger_offset
        scale_step = settings.stagger_value_scale

        count = 0
        for idx, fcurve in enumerate(curves):
            time_offset = offset_step * idx
            value_scale = 1.0 + (scale_step * idx)
            keyframes = fcurve.keyframe_points
            if len(keyframes) == 0:
                continue

            values = [kp.co[1] for kp in keyframes]
            pivot = sum(values) / len(values)

            for kp in keyframes:
                kp.co[0] += time_offset
                kp.co[1] = pivot + (kp.co[1] - pivot) * value_scale
                if kp.handle_left_type not in {'AUTO', 'AUTO_CLAMPED'}:
                    kp.handle_left[0] += time_offset
                    kp.handle_left[1] = pivot + (kp.handle_left[1] - pivot) * value_scale
                if kp.handle_right_type not in {'AUTO', 'AUTO_CLAMPED'}:
                    kp.handle_right[0] += time_offset
                    kp.handle_right[1] = pivot + (kp.handle_right[1] - pivot) * value_scale

            fcurve.update()
            count += 1

        if count == 0:
            self.report({'WARNING'}, "No F-Curves processed")
            return {'CANCELLED'}

        self.report({'INFO'}, f"Staggered {count} F-Curve(s), {offset_step:g} frame(s) apart")
        return {'FINISHED'}


class GRAPH_OT_mirror_curve_values(bpy.types.Operator):
    """Flip (mirror) the values of selected keyframes around a pivot value.
    Operates on selected keyframes if any are selected, otherwise all keyframes on the curve."""
    bl_idname = "graph.smart_mirror_values"
    bl_label = "Mirror Curve Values"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        curves = getattr(context, "selected_editable_fcurves", [])
        if not curves:
            self.report({'WARNING'}, "No editable F-Curves selected")
            return {'CANCELLED'}

        count = 0
        for fcurve in curves:
            keyframes = fcurve.keyframe_points
            selected = [kp for kp in keyframes if kp.select_control_point]
            target = selected if selected else list(keyframes)
            if not target:
                continue

            if settings.mirror_pivot_mode == 'ZERO':
                pivot = 0.0
            elif settings.mirror_pivot_mode == 'AVERAGE':
                pivot = sum(kp.co[1] for kp in target) / len(target)
            else:
                pivot = settings.mirror_pivot_value

            for kp in target:
                kp.co[1] = pivot - (kp.co[1] - pivot)
                if kp.handle_left_type not in {'AUTO', 'AUTO_CLAMPED'}:
                    kp.handle_left[1] = pivot - (kp.handle_left[1] - pivot)
                if kp.handle_right_type not in {'AUTO', 'AUTO_CLAMPED'}:
                    kp.handle_right[1] = pivot - (kp.handle_right[1] - pivot)
                count += 1
            fcurve.update()

        if count == 0:
            self.report({'WARNING'}, "No keyframes found to mirror")
            return {'CANCELLED'}

        self.report({'INFO'}, f"Mirrored {count} keyframe(s)")
        return {'FINISHED'}


