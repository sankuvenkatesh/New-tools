        settings.remap_target_min = 0.0
        settings.remap_target_max = 1.0
        self.report({'INFO'}, "Reset smoothing parameters to default values")
        return {'FINISHED'}


class GRAPH_OT_apply_ease_preset(bpy.types.Operator):
    """Apply an easing/interpolation preset to selected keyframes"""
    bl_idname = "graph.apply_ease_preset"
    bl_label = "Apply Ease Preset"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        curves = getattr(context, "selected_editable_fcurves", [])
        if not curves:
            self.report({'WARNING'}, "No editable F-Curves selected")
            return {'CANCELLED'}

        count = 0
        for fcurve in curves:
            for kp in fcurve.keyframe_points:
                if kp.select_control_point:
                    kp.interpolation = settings.ease_interpolation
                    if settings.ease_interpolation not in {'LINEAR', 'CONSTANT'}:
                        try:
                            kp.easing = settings.ease_mode
                        except Exception:
                            pass
                    count += 1
            fcurve.update()

        if count == 0:
            self.report({'WARNING'}, "No selected keyframes found")
            return {'CANCELLED'}

        self.report({'INFO'}, f"Applied {settings.ease_interpolation} / {settings.ease_mode} to {count} keyframe(s)")
        return {'FINISHED'}


class GRAPH_OT_select_extremes(bpy.types.Operator):
    """Select keyframes that are local extremes (peaks or valleys) on selected F-Curves -
    useful for quickly finding key poses to clean up or use as breakdown anchors."""
    bl_idname = "graph.smart_select_extremes"
    bl_label = "Select Extreme Keyframes"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        curves = getattr(context, "selected_editable_fcurves", [])
        if not curves:
            self.report({'WARNING'}, "No editable F-Curves selected")
            return {'CANCELLED'}

        count = 0
        for fcurve in curves:
            keyframes = fcurve.keyframe_points
            n = len(keyframes)
            if n < 3:
                continue
            order = sorted(range(n), key=lambda i: keyframes[i].co[0])
            for pos in range(1, len(order) - 1):
                i = order[pos]
                prev_i = order[pos - 1]
                next_i = order[pos + 1]
                y_prev = keyframes[prev_i].co[1]
                y_curr = keyframes[i].co[1]
                y_next = keyframes[next_i].co[1]
                is_extreme = (y_curr > y_prev and y_curr > y_next) or (y_curr < y_prev and y_curr < y_next)
                keyframes[i].select_control_point = is_extreme
                keyframes[i].select_left_handle = is_extreme
                keyframes[i].select_right_handle = is_extreme
                if is_extreme:
                    count += 1
            # endpoints are not extremes under this definition
            keyframes[order[0]].select_control_point = False
            keyframes[order[-1]].select_control_point = False

        if count == 0:
            self.report({'WARNING'}, "No extreme keyframes found")
            return {'CANCELLED'}

        if context.area:
            context.area.tag_redraw()
        self.report({'INFO'}, f"Selected {count} extreme keyframe(s)")
        return {'FINISHED'}


class GRAPH_OT_quantize_keyframes(bpy.types.Operator):
    """Snap keyframe frame positions to the nearest multiple of a step size (e.g. every 2 or 4 frames),
    for retro / stepped / 'on 2s' animation timing. Values are left unchanged, only timing is quantized."""
    bl_idname = "graph.smart_quantize_keyframes"
    bl_label = "Quantize Keyframe Timing"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        curves = getattr(context, "selected_editable_fcurves", [])
        if not curves:
            self.report({'WARNING'}, "No editable F-Curves selected")
            return {'CANCELLED'}

        step = max(1, settings.quantize_step)
        count = 0
        skipped = 0

        for fcurve in curves:
            keyframes = fcurve.keyframe_points
            target = [kp for kp in keyframes if kp.select_control_point] or list(keyframes)
            existing_frames = {round(kp.co[0]) for kp in keyframes}

            for kp in target:
                original_frame = round(kp.co[0])
                new_frame = round(original_frame / step) * step
                if new_frame == original_frame:
                    continue
                if new_frame in existing_frames:
                    skipped += 1
                    continue
                delta = new_frame - original_frame
                existing_frames.discard(original_frame)
                kp.co[0] = new_frame
                if kp.handle_left_type not in {'AUTO', 'AUTO_CLAMPED'}:
                    kp.handle_left[0] += delta
                if kp.handle_right_type not in {'AUTO', 'AUTO_CLAMPED'}:
                    kp.handle_right[0] += delta
                existing_frames.add(new_frame)
                count += 1
            fcurve.update()

        if count == 0 and skipped == 0:
            self.report({'WARNING'}, "No keyframes needed quantizing")
            return {'CANCELLED'}

        msg = f"Quantized {count} keyframe(s) to {step}-frame steps"
        if skipped:
            msg += f", {skipped} skipped (frame collision)"
        self.report({'INFO'}, msg)
        return {'FINISHED'}


class GRAPH_OT_remap_value_range(bpy.types.Operator):
    """Linearly remap keyframe values from their current min/max range to a new target range -
    e.g. normalize a curve to 0-1, or fit an imported curve into a shape key's expected range."""
    bl_idname = "graph.smart_remap_range"
    bl_label = "Remap Value Range"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        curves = getattr(context, "selected_editable_fcurves", [])
        if not curves:
            self.report({'WARNING'}, "No editable F-Curves selected")
            return {'CANCELLED'}

        target_min = settings.remap_target_min
        target_max = settings.remap_target_max
        if target_max == target_min:
            self.report({'ERROR'}, "Target Min and Target Max cannot be equal")
            return {'CANCELLED'}

        count = 0
        for fcurve in curves:
            keyframes = fcurve.keyframe_points
            selected = [kp for kp in keyframes if kp.select_control_point]
            target = selected if selected else list(keyframes)
            if not target:
                continue

            values = [kp.co[1] for kp in target]
            src_min = min(values)
            src_max = max(values)
            if src_max == src_min:
                continue  # flat curve, nothing to remap

            src_range = src_max - src_min
            target_range = target_max - target_min

            for kp in target:
                t = (kp.co[1] - src_min) / src_range
                if kp.handle_left_type not in {'AUTO', 'AUTO_CLAMPED'}:
                    ht = (kp.handle_left[1] - src_min) / src_range
                    kp.handle_left[1] = target_min + ht * target_range
                if kp.handle_right_type not in {'AUTO', 'AUTO_CLAMPED'}:
                    ht = (kp.handle_right[1] - src_min) / src_range
                    kp.handle_right[1] = target_min + ht * target_range
                kp.co[1] = target_min + t * target_range
                count += 1
            fcurve.update()

        if count == 0:
            self.report({'WARNING'}, "No keyframes remapped (flat curve or nothing selected)")
            return {'CANCELLED'}

        self.report({'INFO'}, f"Remapped {count} keyframe(s) to range [{target_min:g}, {target_max:g}]")
        return {'FINISHED'}



