class GRAPH_OT_decimate_keyframes(bpy.types.Operator):
    """Decimate/simplify keyframes on selected F-Curves using error-tolerance reduction (removes redundant keys)"""
    bl_idname = "graph.smart_decimate_keyframes"
    bl_label = "Decimate Keyframes"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        curves = getattr(context, "selected_editable_fcurves", [])
        if not curves:
            self.report({'WARNING'}, "No editable F-Curves selected")
            return {'CANCELLED'}

        total_before = 0
        total_after = 0

        for fcurve in curves:
            try:
                keyframes = fcurve.keyframe_points
                n = len(keyframes)
                if n < 3:
                    total_before += n
                    total_after += n
                    continue
                points = [(kp.co[0], kp.co[1]) for kp in keyframes]
                total_before += n
                kept_points = rdp_decimate(points, settings.decimate_error)
                kept_frames = {round(p[0], 4) for p in kept_points}
                kept_frames.add(round(points[0][0], 4))
                kept_frames.add(round(points[-1][0], 4))

                to_remove = []
                for i in range(n - 1, -1, -1):
                    f = round(keyframes[i].co[0], 4)
                    if f not in kept_frames:
                        to_remove.append(i)

                for i in to_remove:
                    keyframes.remove(keyframes[i])

                total_after += (n - len(to_remove))
                fcurve.update()
            except Exception:
                continue

        removed = total_before - total_after
        self.report({'INFO'}, f"Removed {removed} keyframe(s) ({total_before} -> {total_after})")
        return {'FINISHED'}


class GRAPH_OT_apply_ease_preset(bpy.types.Operator):
    """Apply an easing/interpolation preset to selected keyframes"""
    bl_idname = "graph.apply_ease_preset"
    bl_label = "Apply Ease Preset"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        curves = getattr(context, "selected_editable_fcurves", [])
        if not curves:
            self.report({'WARNING'}, "No editable F-Curves selected")
            return {'CANCELLED'}

        count = 0
        for fcurve in curves:
            for kp in fcurve.keyframe_points:
                if kp.select_control_point:
                    kp.interpolation = settings.ease_interpolation
                    if settings.ease_interpolation not in {'LINEAR', 'CONSTANT'}:
                        try:
                            kp.easing = settings.ease_mode
                        except Exception:
                            pass
                    count += 1
            fcurve.update()

        if count == 0:
            self.report({'WARNING'}, "No selected keyframes found")
            return {'CANCELLED'}

        self.report({'INFO'}, f"Applied {settings.ease_interpolation} / {settings.ease_mode} to {count} keyframe(s)")
        return {'FINISHED'}


