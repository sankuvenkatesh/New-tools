    # --- Smoothing method selection ---
    smoothing_method: bpy.props.EnumProperty(
        name="Method",
        description="Algorithm used for smoothing",
        items=[
            ('WEIGHTED', "Weighted Average", "Original adaptive weighted smoothing"),
            ('MOVING_AVERAGE', "Moving Average", "Simple sliding-window average"),
            ('GAUSSIAN', "Gaussian", "Gaussian-weighted sliding window"),
        ],
        default='WEIGHTED'
    )
    ma_window: bpy.props.IntProperty(
        name="Window Size",
        description="Window size (in keyframes) for Moving Average / Gaussian smoothing",
        default=5, min=3, max=51
    )
    gaussian_sigma: bpy.props.FloatProperty(
        name="Sigma",
        description="Standard deviation for Gaussian smoothing (larger = smoother)",
        default=1.5, min=0.1, max=10.0
    )

    # --- Easing presets ---
    ease_interpolation: bpy.props.EnumProperty(
        name="Interpolation",
        items=EASE_INTERPOLATIONS,
        default='BEZIER'
    )
    ease_mode: bpy.props.EnumProperty(
        name="Easing",
        items=EASE_MODES,
        default='EASE_IN_OUT'
    )

    # --- Spring / overshoot simulator ---
    spring_stiffness: bpy.props.FloatProperty(
        name="Stiffness",
        description="How strongly the spring pulls toward the original curve (higher = snappier, less overshoot)",
        default=0.3, min=0.01, max=2.0
    )
    spring_damping: bpy.props.FloatProperty(
        name="Damping",
        description="How quickly the overshoot settles (higher = settles faster, lower = more bouncy)",
        default=0.7, min=0.0, max=2.0
    )
    spring_mass: bpy.props.FloatProperty(
        name="Mass",
        description="Simulated mass - higher values produce slower, heavier-feeling overshoot",
        default=1.0, min=0.01, max=20.0
    )
    spring_overshoot: bpy.props.FloatProperty(
        name="Overshoot Amount",
        description="Blend between the original motion (0) and the full spring simulation (1); values above 1 exaggerate it",
        default=1.0, min=0.0, max=2.0
    )
    spring_sample_step: bpy.props.IntProperty(
        name="Sample Step",
        description="Frame interval used to sample and rebake the curve (1 = every frame)",
        default=1, min=1, max=10
    )

    # --- Stagger keyframes across curves ---
    stagger_offset: bpy.props.FloatProperty(
        name="Frame Offset / Curve",
        description="How many frames to shift each successive selected F-Curve by, creating a wave/follow-through effect",
        default=2.0, min=-50.0, max=50.0
    )
    stagger_value_scale: bpy.props.FloatProperty(
        name="Amplitude Change / Curve",
        description="Additional amplitude scale applied to each successive curve (0 = no change, e.g. 0.1 = +10% per curve)",
        default=0.0, min=-1.0, max=1.0
    )

    # --- Mirror curve values ---
    mirror_pivot_mode: bpy.props.EnumProperty(
        name="Pivot",
        description="What value to mirror keyframes around",
        items=[
            ('ZERO', "Zero", "Mirror around a value of 0"),
            ('AVERAGE', "Curve Average", "Mirror around each curve's own average value"),
            ('CUSTOM', "Custom", "Mirror around a manually specified value"),
        ],
        default='AVERAGE'
    )
    mirror_pivot_value: bpy.props.FloatProperty(
        name="Custom Pivot Value",
        description="Value to mirror around when Pivot is set to Custom",
        default=0.0
    )


class CurveSmoothOperator(bpy.types.Operator):
    """Smooth Selected Keyframes of Selected F-Curves (Advanced)"""
    bl_idname = "graph.smooth_selected_keyframes"
    bl_label = "Smooth Selected Keyframes (Advanced)"
    bl_options = {'REGISTER', 'UNDO', 'PRESET'}

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        smoothed_count = 0
        total_keys = 0
        biggest_move = 0
        curves = getattr(context, "selected_editable_fcurves", [])

        if not curves:
            self.report({'WARNING'}, "No editable F-Curves selected")
            return {'CANCELLED'}

        for fcurve in curves:
            selected_keys = [kp for kp in fcurve.keyframe_points if kp.select_control_point]
            if len(selected_keys) >= 3:
                stats = dispatch_smooth(fcurve, settings, all_keyframes=False)
                set_bezier_and_auto_clamp_handles(fcurve)
                smoothed_count += 1
                total_keys += stats['moved']
                biggest_move = max(biggest_move, stats['max_delta'])

        if smoothed_count == 0:
            self.report({'WARNING'}, "Not enough selected keyframes to smooth")
            return {'CANCELLED'}

        self.report({'INFO'},
                    f"Smoothed {total_keys} keyframes in {smoothed_count} F-Curve(s). Largest change: {biggest_move:.2f}")
        return {'FINISHED'}

class CurveSmoothAllOperator(bpy.types.Operator):
    """Batch Smooth All F-Curves (Advanced)"""
    bl_idname = "graph.smooth_all_keyframes"
    bl_label = "Batch Smooth All F-Curves"
    bl_options = {'REGISTER', 'UNDO', 'PRESET'}

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        smoothed_count = 0
        total_keys = 0
        biggest_move = 0

        fcurves = get_graph_fcurves(context)
        if not fcurves:
            self.report({'WARNING'}, "No F-Curves found")
            return {'CANCELLED'}

        for fcurve in fcurves:
            if len(fcurve.keyframe_points) >= 3:
                stats = dispatch_smooth(fcurve, settings, all_keyframes=True)  # Always process all keyframes in batch mode
                set_bezier_and_auto_clamp_handles(fcurve)
                smoothed_count += 1
                total_keys += stats['moved']
                biggest_move = max(biggest_move, stats['max_delta'])

        if smoothed_count == 0:
            self.report({'WARNING'}, "No F-Curves to smooth")
            return {'CANCELLED'}

        self.report({'INFO'},
                    f"Batch smoothed {total_keys} keyframes in {smoothed_count} F-Curve(s). Largest change: {biggest_move:.2f}")
        return {'FINISHED'}

