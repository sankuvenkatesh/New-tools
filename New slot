class SlotSymbolSettings(PropertyGroup):
    win_travel_y: FloatProperty(
        name="Forward Pop Distance",
        description="How far the object pops towards the camera",
        default=0.80,
        min=0.01,
        max=5.0,
        unit="LENGTH",
        update=_on_live_setting_changed,
    )
    idle_intensity: FloatProperty(
        name="Idle Intensity",
        description="Multiplier for idle animation movements",
        default=1.0,
        min=0.1,
        max=5.0,
        update=_on_live_setting_changed,
    )
    win_intensity: FloatProperty(
        name="Win Intensity",
        description="Multiplier for win animation exaggerations",
        default=1.3,
        min=0.1,
        max=5.0,
        update=_on_live_setting_changed,
    )
    squash_intensity: FloatProperty(
        name="Juiciness (Squash)",
        description="Controls Squash & Stretch intensity across Idle and Win animations (0.0 = Rigid, 1.0 = Balanced, 2.0+ = Extra Juicy)",
        default=1.0,
        min=0.0,
        max=3.0,
        soft_min=0.0,
        soft_max=2.5,
        update=_on_live_setting_changed,
    )
    preview_style: EnumProperty(
        name="Target Action",
        description="Select a single style to preview, or ALL to generate everything",
        items=_STYLE_ENUM_ITEMS,
        default="ALL",
        update=_on_live_setting_changed,
    )
    live_preview: BoolProperty(
        name="Real-Time Preview",
        description="Automatically update animation curves as you drag sliders (auto-unlinks cleanly when turned OFF)",
        default=False,
        update=_on_live_preview_toggled,
    )
    live_sync_all: BoolProperty(
        name="Sync All 16 Live",
        description="When Real-Time Preview is ON, update ALL 16 actions together instead of only the active preview action",
        default=False,
        update=_on_live_setting_changed,
    )
    status: StringProperty(name="Status", default="Ready")


class SLOTSYMBOL_OT_create_symbol(Operator):
    bl_idname = "slotsymbol.create_symbol"
    bl_label = "Create Symbol Cube"
    bl_description = "Create a beveled cube driven by a standard vertical single-bone Root rig"
    bl_options = {"REGISTER", "UNDO"}

    def execute(self, context):
        try:
            context.scene.slot_symbol_settings.status = create_symbol()
        except Exception as exc:
            traceback.print_exc()
            context.scene.slot_symbol_settings.status = f"ERROR: {exc}"
            self.report({"ERROR"}, str(exc))
            return {"CANCELLED"}
        return {"FINISHED"}


class SLOTSYMBOL_OT_create_animations(Operator):
    bl_idname = "slotsymbol.create_animations"
    bl_label = "Generate AAA Master Actions"
    bl_description = "Generates seamless C2-enveloped actions with Blender 5.2.4 LTS Channel Bags API"
    bl_options = {"REGISTER", "UNDO"}

    def execute(self, context):
        settings = context.scene.slot_symbol_settings
        try:
            settings.status = create_animations(
                bpy.data.objects.get(RIG_NAME),
                settings.win_travel_y,
                settings.idle_intensity,
                settings.win_intensity,
                settings.squash_intensity,
                settings.preview_style,
            )
        except Exception as exc:
            traceback.print_exc()
            settings.status = f"ERROR: {exc}"
            self.report({"ERROR"}, str(exc))
            return {"CANCELLED"}
        return {"FINISHED"}


class SLOTSYMBOL_OT_unlink_preview(Operator):
    bl_idname = "slotsymbol.unlink_preview"
    bl_label = "Unlink Preview Action"
    bl_description = "Safely unlink active preview action from SymbolRig and reset rest pose (Action remains saved via Fake User)"
    bl_options = {"REGISTER", "UNDO"}

    def execute(self, context):
        global _IS_LIVE_UPDATING
        settings = context.scene.slot_symbol_settings
        rig = bpy.data.objects.get(RIG_NAME)
        _IS_LIVE_UPDATING = True
        try:
            if settings.live_preview:
                settings.live_preview = False
            unlinked = _unlink_preview_action(
                rig,
                only_slot_symbol=True,
                reset_pose=True,
                scene=context.scene,
            )
        finally:
            _IS_LIVE_UPDATING = False

        if unlinked:
            settings.status = "Preview Action unlinked — Clean State"
        else:
            settings.status = "Rig is already clean (no active preview)"
        return {"FINISHED"}


class SLOTSYMBOL_PT_main(Panel):
    bl_label = "Slot Symbol Generator"
    bl_idname = "SLOTSYMBOL_PT_main"
    bl_space_type = "VIEW_3D"
    bl_region_type = "UI"
    bl_category = "Slot Symbol"

    def draw(self, context):
        layout = self.layout
        settings = context.scene.slot_symbol_settings
        rig = bpy.data.objects.get(RIG_NAME)
        active_preview = _get_active_preview_action(rig)

        box = layout.box()
        row = box.row()
        row.alignment = "CENTER"
        row.label(text="SLOT SYMBOL GENERATOR", icon="ACTION")

        col = layout.column(align=True)
        col.scale_y = 1.3
        col.operator("slotsymbol.create_symbol", text="1. Create Rig & Cube", icon="ARMATURE_DATA")

        layout.separator()

        box = layout.box()
        box.label(text="Win Animation", icon="OPTIONS")
        col = box.column(align=True)
        col.use_property_split = True
        col.use_property_decorate = False
        col.prop(settings, "win_travel_y")

        box = layout.box()
        box.label(text="Intensities & Juiciness", icon="MODIFIER")
        col = box.column(align=True)
        col.use_property_split = True
        col.use_property_decorate = False
        col.prop(settings, "idle_intensity")
        col.prop(settings, "win_intensity")
        col.prop(settings, "squash_intensity", slider=True)

        box = layout.box()
        box.label(text="Generation & Live Preview", icon="SCENE_DATA")
        col = box.column(align=True)
        col.prop(settings, "preview_style", text="Target")
        col.separator(factor=0.5)
        col.prop(settings, "live_preview", icon="PREVIEW_RANGE")
        if settings.live_preview:
            sub = col.column(align=True)
            sub.prop(settings, "live_sync_all", icon="FILE_REFRESH")
            if not settings.live_sync_all and settings.preview_style == "ALL":
                sub.label(text="Tip: Pick a Target style or enable Sync All", icon="INFO")

        if active_preview is not None:
            col.separator(factor=0.5)
            row = col.row(align=True)
            row.label(text=f"Active: {active_preview.name}", icon="LINKED")
            row.operator("slotsymbol.unlink_preview", text="Unlink", icon="UNLINKED")

        layout.separator()

        col = layout.column(align=True)
        col.scale_y = 1.5
        button_text = (
            "Generate ALL Actions"
            if settings.preview_style == "ALL"
            else f"Preview {settings.preview_style}"
        )
        button_icon = "PLAY" if settings.preview_style == "ALL" else "RESTRICT_VIEW_OFF"
        col.operator("slotsymbol.create_animations", text=button_text, icon=button_icon)

        if settings.status != "Ready":
            layout.separator()
            row = layout.row()
            row.alert = settings.status.startswith("ERROR")
            row.label(text=settings.status, icon="ERROR" if row.alert else "CHECKMARK")


_CLASSES = (
    SlotSymbolSettings,
    SLOTSYMBOL_OT_create_symbol,
    SLOTSYMBOL_OT_create_animations,
    SLOTSYMBOL_OT_unlink_preview,
    SLOTSYMBOL_PT_main,
)


def register():
    for cls in _CLASSES:
        if not _is_class_registered(cls):
            bpy.utils.register_class(cls)
    if not hasattr(bpy.types.Scene, "slot_symbol_settings"):
        bpy.types.Scene.slot_symbol_settings = PointerProperty(type=SlotSymbolSettings)


def unregister():
    try:
        if hasattr(bpy.data, "objects"):
            rig = bpy.data.objects.get(RIG_NAME)
            _unlink_preview_action(rig, only_slot_symbol=True, reset_pose=True)
    except Exception:
        pass

    if hasattr(bpy.types.Scene, "slot_symbol_settings"):
        del bpy.types.Scene.slot_symbol_settings
    for cls in reversed(_CLASSES):
        if _is_class_registered(cls):
            bpy.utils.unregister_class(cls)


if __name__ == "__main__":
    try:
        unregister()
    except Exception:
        pass
    register()
