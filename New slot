def _add_scene_markers(scene):
    scene.timeline_markers.clear()
    scene.timeline_markers.new("Idle_Start", frame=1)
    scene.timeline_markers.new("Win_Trigger", frame=51)
    scene.timeline_markers.new("Win_Impact", frame=66)
    scene.timeline_markers.new("Win_Return", frame=136)
    scene.timeline_markers.new("Loop_End", frame=151)


def _setup_action_metadata(action, style_name):
    action["is_slot_symbol"] = True
    action["style_name"] = style_name

    if style_name in _CONTINUOUS_SPIN_META:
        axis_name, idle_revs, total_revs = _CONTINUOUS_SPIN_META[style_name]
        action["loop_type"] = "CONTINUOUS_SPIN_SO3"
        action["spin_axis"] = axis_name
        action["spin_cycles_idle"] = idle_revs
        action["spin_cycles_total"] = total_revs
    else:
        action["loop_type"] = "EXACT_EULER_C2"

    if len(action.pose_markers) == 0:
        action.pose_markers.new("Idle_Loop").frame = 1
        action.pose_markers.new("Win_Trigger").frame = 51
        action.pose_markers.new("Win_Impact").frame = 66
        action.pose_markers.new("Win_Return").frame = 136
        action.pose_markers.new("Action_End").frame = 151


def _ensure_slot_and_channelbag_5_2(rig, action):
    """
    Blender 5.2.4 LTS Native API: Ensures ActionSlot, Layer, Keyframe Strip & ChannelBag
    directly on the Action datablock without mutating rig.animation_data (preserving custom actions).
    """
    slot = next(
        (
            s for s in action.slots
            if s.target_id_type in {"OBJECT", "UNSPECIFIED"} and s.name_display == rig.name
        ),
        None,
    )
    if slot is None:
        slot = action.slots.new(id_type="OBJECT", name=rig.name)

    if hasattr(anim_utils, "action_ensure_channelbag_for_slot"):
        channelbag = anim_utils.action_ensure_channelbag_for_slot(action, slot)
    else:
        layer = action.layers[0] if len(action.layers) > 0 else action.layers.new(name="Base")
        strip = layer.strips[0] if len(layer.strips) > 0 else layer.strips.new(type="KEYFRAME")
        channelbag = strip.channelbag(slot, ensure=True)

    return slot, channelbag


def _bake_curves_5_2_safe(rig, action, samples, endpoint_velocities=None):
    """
    Blender 5.2.4 LTS Strict API: Fast ChannelBag F-Curve baking.
    Always enforces consistent BEZIER interpolation & handles even during in-place updates,
    plus exact analytical ALIGNED endpoint tangents at Frame 1 & Frame 151.
    """
    slot, channelbag = _ensure_slot_and_channelbag_5_2(rig, action)
    sample_count = len(samples)

    for prop_index, prop in enumerate(_ROOT_PROPS):
        data_path = f'pose.bones["{ROOT_BONE}"].{prop}'
        for axis in range(3):
            if hasattr(channelbag.fcurves, "ensure"):
                fc = channelbag.fcurves.ensure(data_path, index=axis, group_name=ROOT_BONE)
            else:
                fc = channelbag.fcurves.find(data_path, index=axis)
                if fc is None:
                    fc = channelbag.fcurves.new(data_path, index=axis, group_name=ROOT_BONE)

            coords = []
            for frame, pose in samples:
                coords.append(float(frame))
                coords.append(float(pose[prop_index][axis]))

            if len(fc.keyframe_points) != sample_count:
                if len(fc.keyframe_points) > 0:
                    fc.keyframe_points.clear()
                fc.keyframe_points.add(sample_count)

            fc.keyframe_points.foreach_set("co", coords)

            # Enforce consistent BEZIER + AUTO_CLAMPED handles on every bake (prevents stale LINEAR/VECTOR curves)
            for key in fc.keyframe_points:
                key.interpolation = "BEZIER"
                key.handle_left_type = "AUTO_CLAMPED"
                key.handle_right_type = "AUTO_CLAMPED"

            fc.update()

            # Apply exact analytical ALIGNED loop tangents on Frame 1 & Frame 151
            if endpoint_velocities is not None and sample_count >= 2:
                v_start, v_end = endpoint_velocities
                flat_idx = prop_index * 3 + axis
                dt = 1.0 / 3.0

                kp_start = fc.keyframe_points[0]
                f0 = float(samples[0][0])
                y0 = float(samples[0][1][prop_index][axis])
                vs = float(v_start[flat_idx])
                kp_start.handle_left_type = "ALIGNED"
                kp_start.handle_right_type = "ALIGNED"
                kp_start.handle_left = (f0 - dt, y0 - vs * dt)
                kp_start.handle_right = (f0 + dt, y0 + vs * dt)

                kp_end = fc.keyframe_points[sample_count - 1]
                fn = float(samples[-1][0])
                yn = float(samples[-1][1][prop_index][axis])
                ve = float(v_end[flat_idx])
                kp_end.handle_left_type = "ALIGNED"
                kp_end.handle_right_type = "ALIGNED"
                kp_end.handle_left = (fn - dt, yn - ve * dt)
                kp_end.handle_right = (fn + dt, yn + ve * dt)

                fc.update()

    return slot


def _evaluate_style_samples(style, travel_y, idle_intensity, win_intensity, squash_intensity):
    """Pre-evaluates all 151 frames and exact endpoint velocities before mutating bpy.data.actions."""
    style_index = IDLE_STYLES.index(style)
    variant = style_index + 1
    samples = [
        (
            frame,
            _evaluate_frame(
                style,
                variant,
                frame,
                travel_y,
                idle_intensity,
                win_intensity,
                squash_intensity,
            ),
        )
        for frame in range(1, TOTAL_FRAMES + 1)
    ]
    endpoint_velocities = _compute_endpoint_velocities(
        style, variant, travel_y, idle_intensity, win_intensity, squash_intensity
    )
    return samples, endpoint_velocities


def _commit_style_action(rig, style, samples, endpoint_velocities, in_place=True):
    """Writes pre-evaluated samples into Anim_{style} (in-place or fresh replacement) and returns (action, slot)."""
    action_name = f"Anim_{style}"
    action = bpy.data.actions.get(action_name) if in_place else None

    if not in_place:
        old = bpy.data.actions.get(action_name)
        if old is not None:
            bpy.data.actions.remove(old, do_unlink=True)

    if action is None:
        action = bpy.data.actions.new(action_name)
        action.use_fake_user = True

    _setup_action_metadata(action, style)
    slot = _bake_curves_5_2_safe(rig, action, samples, endpoint_velocities)

    if hasattr(action, "use_frame_range"):
        action.use_frame_range = True
        action.frame_start = 1.0
        action.frame_end = float(TOTAL_FRAMES)

    return action, slot


def _bake_single_style(rig, style, travel_y, idle_intensity, win_intensity, squash_intensity, in_place=True):
    samples, endpoint_velocities = _evaluate_style_samples(
        style, travel_y, idle_intensity, win_intensity, squash_intensity
    )
    return _commit_style_action(rig, style, samples, endpoint_velocities, in_place=in_place)


# ---------------------------------------------------------------------------
# Real-Time Preview Callbacks (With Clean Auto-Unlink & Custom Action Safety)
# ---------------------------------------------------------------------------
def _on_live_preview_toggled(self, context):
    global _IS_LIVE_UPDATING
    if _IS_LIVE_UPDATING:
        return

    if self.live_preview:
        _on_live_setting_changed(self, context)
    else:
        rig = bpy.data.objects.get(RIG_NAME)
        scene = context.scene if context and context.scene else getattr(bpy.context, "scene", None)
        if _unlink_preview_action(rig, only_slot_symbol=True, reset_pose=True, scene=scene):
            self.status = "Live Preview OFF — Action unlinked (Clean State)"
        else:
            self.status = "Live Preview OFF"


def _on_live_setting_changed(self, context):
    global _IS_LIVE_UPDATING
    if _IS_LIVE_UPDATING or not self.live_preview:
        return

    rig = bpy.data.objects.get(RIG_NAME)
    if rig is None or rig.type != "ARMATURE" or ROOT_BONE not in rig.pose.bones:
        return

    _IS_LIVE_UPDATING = True
    try:
        scene = context.scene if context and context.scene else bpy.context.scene
        if scene is not None and len(scene.timeline_markers) == 0:
            _add_scene_markers(scene)

        pb = rig.pose.bones[ROOT_BONE]
        pb.rotation_mode = "XYZ"

        prev_action = _get_active_preview_action(rig)
        prev_style = None
        if prev_action is not None:
            candidate = prev_action.get("style_name")
            if candidate in IDLE_STYLES:
                prev_style = candidate

        if self.live_sync_all:
            styles_to_update = IDLE_STYLES
            active_style = self.preview_style if self.preview_style != "ALL" else prev_style
        elif self.preview_style != "ALL":
            styles_to_update = (self.preview_style,)
            active_style = self.preview_style
        else:
            _unlink_preview_action(rig, only_slot_symbol=True, reset_pose=True, scene=scene)
            self.status = "Clean State: Pick a Target style or enable 'Sync All 16 Live'"
            return

        # Pre-evaluate atomically before committing
        evaluated = {
            style: _evaluate_style_samples(
                style,
                self.win_travel_y,
                self.idle_intensity,
                self.win_intensity,
                self.squash_intensity,
            )
            for style in styles_to_update
        }

        baked = {
            style: _commit_style_action(rig, style, samples, ep_vel, in_place=True)
            for style, (samples, ep_vel) in evaluated.items()
        }

        if active_style and active_style in baked:
            act, slot = baked[active_style]
            _bind_preview_action(rig, act, slot)
        else:
            _unlink_preview_action(rig, only_slot_symbol=True, reset_pose=True, scene=scene)

        if context and getattr(context, "view_layer", None):
            context.view_layer.update()

        is_playing = bool(context and getattr(context, "screen", None) and context.screen.is_animation_playing)
        if not is_playing and scene is not None:
            scene.frame_set(scene.frame_current)

        if self.live_sync_all:
            self.status = f"Live Synced ALL {len(styles_to_update)} Actions (v9.6.3)"
        else:
            self.status = f"Live Preview: {active_style} (v9.6.3)"
    except Exception as exc:
        traceback.print_exc()
        self.status = f"ERROR: {exc}"
    finally:
        _IS_LIVE_UPDATING = False


# ---------------------------------------------------------------------------
# Setup & Generation Operators (Background-Mode Safe + Atomic Recovery)
# ---------------------------------------------------------------------------
def _deselect_all_safe(view_layer):
    objects = getattr(view_layer, "objects", None)
    if objects is not None:
        try:
            for obj in objects:
                obj.select_set(False)
            return
        except TypeError:
            pass
    for obj in bpy.data.objects:
        obj.select_set(False)


def create_symbol():
    if bpy.data.objects.get(RIG_NAME) is not None:
        raise RuntimeError("SymbolRig already exists. Delete it first.")

    context = bpy.context
    scene = context.scene
    collection = context.collection
    view_layer = context.view_layer

    if context.active_object and context.active_object.mode != "OBJECT":
        bpy.ops.object.mode_set(mode="OBJECT")

    arm_data = bpy.data.armatures.new("SymbolArmature")
    arm_data.display_type = "OCTAHEDRAL"
    arm_data.show_axes = True

    rig = bpy.data.objects.new(RIG_NAME, arm_data)
    collection.objects.link(rig)

    _deselect_all_safe(view_layer)
    rig.select_set(True)
    view_layer.objects.active = rig
    bpy.ops.object.mode_set(mode="EDIT")
    try:
        bone = arm_data.edit_bones.new(ROOT_BONE)
        bone.head = (0.0, 0.0, 0.0)
        bone.tail = (0.0, 0.0, 1.0)
        bone.roll = 0.0
        bone.use_deform = True
    finally:
        bpy.ops.object.mode_set(mode="OBJECT")

    mesh_data = bpy.data.meshes.new("SymbolCubeMesh")
    bm = bmesh.new()
    try:
        bmesh.ops.create_cube(bm, size=0.58, calc_uvs=True)
        bm.to_mesh(mesh_data)
    finally:
        bm.free()

    if len(mesh_data.polygons) > 0:
        mesh_data.polygons.foreach_set("use_smooth", [True] * len(mesh_data.polygons))
    mesh_data.update()

    mesh = bpy.data.objects.new(MESH_NAME, mesh_data)
    collection.objects.link(mesh)

    mesh.parent = rig
    group = mesh.vertex_groups.new(name=ROOT_BONE)
    if mesh.data.vertices:
        group.add([v.index for v in mesh.data.vertices], 1.0, "REPLACE")

    arm_mod = mesh.modifiers.new("Armature", "ARMATURE")
    arm_mod.object = rig
    arm_mod.use_vertex_groups = True

    bevel = mesh.modifiers.new("Soft Rounded Edges", "BEVEL")
    bevel.width = 0.055
    bevel.segments = 4
    bevel.limit_method = "ANGLE"

    weighted = mesh.modifiers.new("Weighted Corner Normals", "WEIGHTED_NORMAL")
    weighted.keep_sharp = True

    if scene.camera is None:
        camera_data = bpy.data.cameras.new("VR_StaticCamera")
        camera_data.lens = 50.0
        camera = bpy.data.objects.new("VR_StaticCamera", camera_data)
        collection.objects.link(camera)
        camera.location = (0.0, -2.5, 0.45)
        camera.rotation_euler = (math.radians(82.0), 0.0, 0.0)
        scene.camera = camera

    scene.render.fps = FPS
    scene.render.fps_base = 1.0
    scene.frame_start = 1
    scene.frame_end = TOTAL_FRAMES

    _deselect_all_safe(view_layer)
    rig.select_set(True)
    view_layer.objects.active = rig
    scene.frame_set(1)
    return f"Created Rig & Cube successfully! [{_version_string()}]"


def create_animations(rig, travel_y, idle_intensity, win_intensity, squash_intensity, target_style):
    if rig is None or rig.type != "ARMATURE" or ROOT_BONE not in rig.pose.bones:
        raise RuntimeError("Create the Symbol Cube rig first.")

    scene = bpy.context.scene
    scene.render.fps = FPS
    scene.render.fps_base = 1.0
    scene.frame_start = 1
    scene.frame_end = TOTAL_FRAMES
    _add_scene_markers(scene)

    # Preserve any existing non-slot-symbol user custom action & slot strictly
    custom_action, custom_slot = _capture_custom_action(rig)
    rig.pose.bones[ROOT_BONE].rotation_mode = "XYZ"

    styles_to_process = IDLE_STYLES if target_style == "ALL" else (target_style,)

    # 1. Atomic pre-evaluation (if math/inputs fail, zero existing actions or rig state are touched)
    evaluated = {}
    for style in styles_to_process:
        evaluated[style] = _evaluate_style_samples(
            style,
            travel_y,
            idle_intensity,
            win_intensity,
            squash_intensity,
        )

    # 2. Commit actions cleanly without mutating rig.animation_data
    created_map = {}
    try:
        for style in styles_to_process:
            samples, endpoint_velocities = evaluated[style]
            created_map[style] = _commit_style_action(
                rig, style, samples, endpoint_velocities, in_place=False
            )
    except Exception:
        if custom_action is not None:
            _restore_custom_action(rig, custom_action, custom_slot)
        else:
            _unlink_preview_action(rig, only_slot_symbol=True, reset_pose=True)
        raise

    if target_style == "ALL":
        if custom_action is not None:
            _restore_custom_action(rig, custom_action, custom_slot)
            return f"Generated {len(created_map)} Actions — Custom Action Preserved (v9.6.3 | 5.2.4 LTS)!"
        _unlink_preview_action(rig, only_slot_symbol=True, reset_pose=True, scene=scene)
        scene.frame_set(1)
        return f"Generated {len(created_map)} Actions — Rig Clean/Unlinked (v9.6.3 | 5.2.4 LTS)!"
    else:
        act, slot = created_map[target_style]
        _bind_preview_action(rig, act, slot)
        scene.frame_set(scene.frame_current)
        note = f" | '{custom_action.name}' kept (Fake User)" if custom_action is not None else ""
        return f"Previewing: {target_style} (v9.6.3 | 5.2.4 LTS){note}"


