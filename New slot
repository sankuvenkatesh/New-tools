# ---------------------------------------------------------------------------
# AAA C2 Mathematical Primitives & Validation
# ---------------------------------------------------------------------------
def safe_val(v, default=0.0):
    """NaN / Infinity రక్షణ: ఏవైనా మ్యాథ్ ఎర్రర్స్ వస్తే సేఫ్ వాల్యూకి ఫాల్‌బ్యాక్ అవుతుంది."""
    if math.isnan(v) or math.isinf(v):
        return default
    return v


def smooth_step(edge0, edge1, x):
    """Quintic Smootherstep: C0 + C1 + C2 Continuity (0 velocity & 0 acceleration at edges)."""
    if edge1 == edge0:
        return 0.0 if x < edge0 else 1.0
    t = max(0.0, min(1.0, (x - edge0) / (edge1 - edge0)))
    return t * t * t * (t * (6.0 * t - 15.0) + 10.0)


def _bell_c2(u):
    """C2 smooth bell curve on [0, 1]: peaks at 1.0 (u=0.5) with 0 pos/vel/acc at u=0 and u=1."""
    if u <= 0.0 or u >= 1.0:
        return 0.0
    inv = 1.0 - u
    return 64.0 * (u * u * u) * (inv * inv * inv)


def _anticipation_ramp_c2(q):
    """C2 smooth ramp 0->1 with anticipation pull-back (~ -0.11) and 0 vel/acc at both q=0 and q=1."""
    if q <= 0.0:
        return 0.0
    if q >= 1.0:
        return 1.0
    q2 = q * q
    q3 = q2 * q
    inv = 1.0 - q
    inv2 = inv * inv
    quintic = q3 * (q * (6.0 * q - 15.0) + 10.0)
    anticipation_dip = 45.0 * q3 * (inv2 * inv2)
    return quintic - anticipation_dip


# ---------------------------------------------------------------------------
# C2-Continuous Envelopes & Cinematic Travel
# ---------------------------------------------------------------------------
def get_travel_envelope(t_win):
    if t_win <= 0.0 or t_win >= 1.0:
        return 0.0

    if t_win < 0.15:
        return _anticipation_ramp_c2(t_win / 0.15)
    elif t_win < 0.85:
        u = (t_win - 0.15) / 0.70
        return 1.0 + 0.05 * _bell_c2(u)
    else:
        inv_q = 1.0 - ((t_win - 0.85) / 0.15)
        return _anticipation_ramp_c2(inv_q)


def get_squash_stretch(t_win, squash_intensity=1.0):
    if t_win <= 0.0 or t_win >= 1.0 or squash_intensity <= 0.0:
        return (1.0, 1.0, 1.0)

    if t_win < 0.15:
        q = _bell_c2(t_win / 0.15) * squash_intensity
        return (
            max(0.15, 1.0 - 0.1 * q),
            max(0.15, 1.0 + 0.3 * q),
            max(0.15, 1.0 - 0.1 * q),
        )
    elif t_win < 0.35:
        u = (t_win - 0.15) / 0.20
        attack = smooth_step(0.0, 0.25, u)
        decay = (1.0 - u) ** 3
        w = math.sin(u * math.pi * 3.0) * attack * decay * squash_intensity
        return (
            max(0.15, 1.0 + 0.2 * w),
            max(0.15, 1.0 - 0.3 * w),
            max(0.15, 1.0 + 0.2 * w),
        )
    elif t_win > 0.85:
        q = _bell_c2((t_win - 0.85) / 0.15) * squash_intensity
        return (
            max(0.15, 1.0 - 0.1 * q),
            max(0.15, 1.0 + 0.2 * q),
            max(0.15, 1.0 - 0.1 * q),
        )

    return (1.0, 1.0, 1.0)


# ---------------------------------------------------------------------------
# True Independent Dynamic Lag System (Logarithmic Micro-Optimized)
# ---------------------------------------------------------------------------
def _lag(base_offset, intensity, prop_type="rot"):
    """
    Smooth C-infinity logarithmic follow-through scaling.
    I=0.1 -> ~1.32x (crisp, no hard clamp) | I=1.0 -> 1.00x | I=5.0 -> ~0.69x (snappy).
    """
    safe_i = max(0.0, intensity)
    factor = 0.72 + 0.28 * (math.log1p(safe_i) / _LN2)
    return (base_offset * _LAG_PROP_SCALE.get(prop_type, 1.0)) / factor


# ---------------------------------------------------------------------------
# Base Continuous C2 Math Motions (Retained Personalities + Juiciness Control)
# ---------------------------------------------------------------------------
def _idle_base(style, t, variant, intensity=1.0, squash_intensity=1.0):
    p = 2.0 * math.pi * t
    phase = variant * 0.37
    wave = math.sin(p)
    wave2 = math.sin(2.0 * p)

    wx = wy = wz = 0.0
    wrx = wry = wrz = 0.0
    wsx = wsy = wsz = 1.0

    if style == "FloatingSpin":
        wz = (0.10 * math.sin(p - _lag(0.25, intensity, "loc"))) * intensity
        wrz = t * (2.0 * math.pi) + (0.05 * math.sin(4.0 * p))
    elif style == "HoverDance":
        wx = (0.15 * math.sin(p + phase)) * intensity
        wz = (0.10 * math.sin(2.0 * p - _lag(0.4, intensity, "loc"))) * intensity
        wry = (0.15 * math.sin(p - _lag(0.1, intensity, "rot"))) * intensity
    elif style == "JumpingIdle":
        hop = max(0.0, wave)
        wz = (0.25 * (hop * hop * hop)) * intensity
        dsx = 0.1 * math.sin(2.0 * p + math.pi - _lag(0.25, intensity, "scale")) * intensity * squash_intensity
        dsz = -0.15 * math.sin(2.0 * p + math.pi - _lag(0.25, intensity, "scale")) * intensity * squash_intensity
        wsx, wsy, wsz = 1.0 + dsx, 1.0 + dsx, 1.0 + dsz
    elif style == "Lean":
        wrx = (0.25 + 0.05 * wave) * intensity
        wry = (0.10 * math.sin(p * 2.0 - _lag(0.5, intensity, "rot"))) * intensity
    elif style == "Orbit":
        wx = (0.20 * math.cos(p)) * intensity
        wz = (0.10 * math.sin(2.0 * p - _lag(0.3, intensity, "loc"))) * intensity
        wry = (0.15 * math.sin(p - _lag(0.2, intensity, "rot"))) * intensity
    elif style == "PulsingIdle":
        ds = 0.15 * math.sin(p - _lag(0.2, intensity, "scale")) * intensity * squash_intensity
        wsx, wsy, wsz = 1.0 + ds, 1.0 + ds, 1.0 - ds
    elif style == "Rocking":
        wrx = (0.35 * wave) * intensity
        wz = (0.05 * math.sin(2.0 * p - _lag(0.6, intensity, "loc"))) * intensity
    elif style == "Shake":
        wx = (0.08 * math.sin(4.0 * p)) * intensity
        wrz = (0.15 * math.sin(5.0 * p - _lag(0.15, intensity, "rot"))) * intensity
    elif style == "SideHop":
        wx = (0.20 * wave) * intensity
        hop2 = max(0.0, wave2)
        wz = (0.15 * (hop2 * hop2 * hop2)) * intensity
        wrz = (0.20 * math.sin(p - _lag(0.35, intensity, "rot"))) * intensity
    elif style == "SpinningIdle":
        wrz = t * (4.0 * math.pi) + (0.08 * math.sin(2.0 * p))
    elif style == "SpringBounce":
        wz = (0.25 * (wave * wave)) * intensity
        s_lag = math.sin(p - _lag(0.2, intensity, "scale"))
        s_sq = s_lag * s_lag
        dsx = -0.1 * s_sq * intensity * squash_intensity
        dsz = 0.2 * s_sq * intensity * squash_intensity
        wsx, wsy, wsz = 1.0 + dsx, 1.0 + dsx, 1.0 + dsz
    elif style == "SquashStretchIdle":
        ds = 0.20 * math.sin(p - _lag(0.15, intensity, "scale")) * intensity * squash_intensity
        dsz = -0.25 * math.sin(p - _lag(0.15, intensity, "scale")) * intensity * squash_intensity
        wsx, wsy, wsz = 1.0 + ds, 1.0 + ds, 1.0 + dsz
    elif style == "TiltingIdle":
        wry = (0.30 * wave) * intensity
        wrx = (0.15 * math.sin(p + 1.5 - _lag(0.4, intensity, "rot"))) * intensity
    elif style == "Tumble":
        wrx = t * (2.0 * math.pi) + (0.08 * math.sin(2.0 * p))
    elif style == "Twist":
        wrz = (0.60 * wave) * intensity
        wry = (0.15 * math.sin(2.0 * p - _lag(0.35, intensity, "rot"))) * intensity
    elif style == "WobbleIdle":
        wrx = (0.25 * wave) * intensity
        wry = (0.25 * math.sin(p + 1.5 - _lag(0.5, intensity, "rot"))) * intensity

    return wx, wy, wz, wrx, wry, wrz, wsx, wsy, wsz


def world_to_bone_space(wx, wy, wz, wrx, wry, wrz, wsx, wsy, wsz):
    return (wx, wz, wy), (wrx, wrz, wry), (wsx, wsz, wsy)


# ---------------------------------------------------------------------------
# The Master Evaluator (C2 Envelopes, SO(3)-Seamless Spins & Decaying Tremor)
# ---------------------------------------------------------------------------
def _evaluate_frame(style, variant, frame, travel_y, idle_intensity, win_intensity, squash_intensity=1.0):
    t_continuous = (frame - 1) / float(IDLE_PERIOD)

    t_win = 0.0
    if frame > IDLE_PERIOD + 1:
        t_win = (frame - (IDLE_PERIOD + 1)) / float(WIN_DURATION)
        t_win = max(0.0, min(1.0, t_win))

    env = get_travel_envelope(t_win)

    if t_win < 0.5:
        blend_factor = smooth_step(0.0, 0.15, t_win)
    else:
        blend_factor = 1.0 - smooth_step(0.85, 1.0, t_win)
    current_intensity = idle_intensity + (win_intensity - idle_intensity) * blend_factor

    bx, by, bz, brx, bry, brz, bsx, bsy, bsz = _idle_base(
        style, t_continuous, variant, current_intensity, squash_intensity
    )
    b0x, b0y, b0z, b0rx, b0ry, b0rz, b0sx, b0sy, b0sz = _idle_base(
        style, 0.0, variant, current_intensity, squash_intensity
    )

    wx = bx - b0x
    wy = by - b0y
    wz = bz - b0z
    wrx = brx - b0rx
    wry = bry - b0ry
    wrz = brz - b0rz

    wsx = max(0.15, 1.0 + (bsx - b0sx))
    wsy = max(0.15, 1.0 + (bsy - b0sy))
    wsz = max(0.15, 1.0 + (bsz - b0sz))

    wy += travel_y * env

    ssx, ssy, ssz = get_squash_stretch(t_win, squash_intensity)
    wsx *= ssx
    wsy *= ssy
    wsz *= ssz

    # C2/C3-Enveloped Soft Impact Settle (no scale collision with squash, bounded amplitude, smooth 2-3 Hz settle)
    if 0.15 < t_win < 0.35:
        tremor_time = (t_win - 0.15) / 0.20
        attack = smooth_step(0.0, 0.25, tremor_time)
        decay = (1.0 - tremor_time) ** 3
        tremor_env = attack * decay

        # Bounded frequency & logarithmic amplitude (never explodes even at win_intensity = 5.0)
        freq_scale_i = 1.0 + 0.15 * math.tanh((win_intensity - 1.0) * 0.5)
        phase_t = tremor_time * (1.2 - 0.2 * tremor_time)

        freq_z = 3.0 * freq_scale_i       # ~13 frames/cycle: smooth weight settle
        freq_rot = 3.5 * freq_scale_i     # ~11 frames/cycle: subtle nod settle

        punch_power = math.log1p(max(0.0, current_intensity)) / _LN2

        wz += math.sin(phase_t * math.pi * freq_z) * 0.018 * tremor_env * punch_power
        wrx += math.sin(phase_t * math.pi * freq_rot) * 0.025 * tremor_env * punch_power

    wsx = max(0.1, min(4.0, safe_val(wsx, 1.0)))
    wsy = max(0.1, min(4.0, safe_val(wsy, 1.0)))
    wsz = max(0.1, min(4.0, safe_val(wsz, 1.0)))

    return world_to_bone_space(
        safe_val(wx), safe_val(wy), safe_val(wz),
        safe_val(wrx), safe_val(wry), safe_val(wrz),
        wsx, wsy, wsz,
    )


def _compute_endpoint_velocities(style, variant, travel_y, idle_intensity, win_intensity, squash_intensity):
    """Computes exact 2nd-order one-sided frame velocities at Frame 1+ and Frame 151- for seamless Bezier loops."""
    h = 1e-3

    def _flat(f):
        loc, rot, scl = _evaluate_frame(style, variant, f, travel_y, idle_intensity, win_intensity, squash_intensity)
        return (*loc, *rot, *scl)

    f1_0 = _flat(1.0)
    f1_1 = _flat(1.0 + h)
    f1_2 = _flat(1.0 + 2.0 * h)
    v_start = [(-1.5 * f1_0[i] + 2.0 * f1_1[i] - 0.5 * f1_2[i]) / h for i in range(9)]

    fn_0 = _flat(float(TOTAL_FRAMES))
    fn_1 = _flat(float(TOTAL_FRAMES) - h)
    fn_2 = _flat(float(TOTAL_FRAMES) - 2.0 * h)
    v_end = [(1.5 * fn_0[i] - 2.0 * fn_1[i] + 0.5 * fn_2[i]) / h for i in range(9)]

    return v_start, v_end


# ---------------------------------------------------------------------------
# Preview Action Clean Link / Unlink State & Custom Action Safety
# ---------------------------------------------------------------------------
def _reset_root_pose(rig):
    if rig is not None and rig.type == "ARMATURE" and ROOT_BONE in rig.pose.bones:
        pb = rig.pose.bones[ROOT_BONE]
        pb.rotation_mode = "XYZ"
        pb.location = (0.0, 0.0, 0.0)
        pb.rotation_euler = (0.0, 0.0, 0.0)
        pb.scale = (1.0, 1.0, 1.0)


def _capture_custom_action(rig):
    """Captures any non-slot-symbol user custom action & ActionSlot on the rig so it is never lost."""
    if rig is None or rig.type != "ARMATURE" or rig.animation_data is None:
        return None, None
    act = rig.animation_data.action
    if act is not None and not act.get("is_slot_symbol"):
        return act, getattr(rig.animation_data, "action_slot", None)
    return None, None


def _restore_custom_action(rig, custom_action, custom_slot):
    if rig is None or custom_action is None:
        return
    ad = rig.animation_data or rig.animation_data_create()
    ad.action = custom_action
    if custom_slot is not None:
        ad.action_slot = custom_slot
    rig.update_tag(refresh={"DATA"})


def _bind_preview_action(rig, action, slot=None):
    """Safely binds a Slot Symbol Action & its ActionSlot to the rig for preview."""
    if rig is None or action is None:
        return
    ad = rig.animation_data or rig.animation_data_create()
    previous = ad.action
    if previous is not None and previous is not action and not previous.get("is_slot_symbol"):
        # A preview is about to replace the user's own Action. With 0 users it would be purged on save/reload,
        # so it is kept alive with a Fake User.
        previous.use_fake_user = True
    ad.action = action
    target_slot = slot or (action.slots[0] if action.slots else None)
    if target_slot is not None:
        ad.action_slot = target_slot
    rig.update_tag(refresh={"DATA"})


def _unlink_preview_action(rig, only_slot_symbol=True, reset_pose=True, scene=None):
    """
    Safely unlinks preview action & ActionSlot from SymbolRig to keep Action/NLA Editors clean.
    When only_slot_symbol=True (default), user custom actions are strictly preserved.
    """
    if rig is None or rig.type != "ARMATURE":
        return False

    unlinked = False
    has_custom = False
    ad = rig.animation_data
    if ad is not None and ad.action is not None:
        if not only_slot_symbol or ad.action.get("is_slot_symbol"):
            # Blender 5.2.4: clearing the Action also releases its Slot. Setting `action_slot = None`
            # afterwards raises "Cannot set slot without an assigned Action".
            ad.action = None
            unlinked = True
        else:
            has_custom = True

    if reset_pose and not has_custom:
        _reset_root_pose(rig)

    if unlinked:
        rig.update_tag(refresh={"DATA"})
        if scene is not None:
            scene.frame_set(1)

    return unlinked


def _get_active_preview_action(rig):
    if rig is None or rig.type != "ARMATURE" or rig.animation_data is None:
        return None
    act = rig.animation_data.action
    if act is not None and act.get("is_slot_symbol"):
        return act
    return None


