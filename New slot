def _is_class_registered(cls):
    """Uses Blender's RNAMeta.is_registered ('bl_rna' in cls.__dict__) safely."""
    if hasattr(bpy.utils, "is_registered_class"):
        return bool(bpy.utils.is_registered_class(cls))
